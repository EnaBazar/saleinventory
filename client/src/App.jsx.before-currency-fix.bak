      return;
    }

    const result = await apiRequest("/categories", {
      method: "POST",
      body: JSON.stringify({
        productName: categoryForm.productName.trim(),
        categoryName: categoryForm.categoryName.trim(),
      }),
    });

    if (result.success) {

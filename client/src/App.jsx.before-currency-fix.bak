    .map((account) => (
      <option key={account._id} value={account._id}>
        {account.accountName} ({account.accountType})
      </option>
    ))}
</select>

{customerCollectionAccountsLoading && (
  <p style={{ fontSize: 12, color: "#64748b" }}>
    Account à¦²à§‹à¦¡ à¦¹à¦šà§à¦›à§‡...
  </p>
)}

{!customerCollectionAccountsLoading &&
  customerCollectionAccounts.filter(
    (account) =>
      account.accountType === customerPaymentForm.paymentMethod
  ).length === 0 && (
    <p style={{ fontSize: 12, color: "#dc2626" }}>
      à¦à¦‡ Payment Method-à¦à¦° à¦•à§‹à¦¨à§‹ Active Account à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤
    </p>
  )}


              {/* AUTO TRANSACTION ID */}
              <label style={labelStyle}>

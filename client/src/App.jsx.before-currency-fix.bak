                                      <td>{item.productName || "-"}</td>
                                      <td>{Number(item.netBags ?? item.bags ?? 0)}</td>
                                      <td>{Number(item.netWeightKg ?? item.weightKg ?? 0).toLocaleString("en-BD")}</td>

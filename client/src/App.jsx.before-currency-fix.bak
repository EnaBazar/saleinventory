                      <th>TYPE</th>
                      <th>DESCRIPTION</th>
                      <th>METHOD</th>
                      <th>DEBIT</th>
                      <th>CREDIT</th>
                      <th>BALANCE</th>
                      <th>ACTION</th>
                    </tr>
                  </thead>

                  <tbody>
                    {transactions.map((item) => {
                      console.log("CUSTOMER LEDGER TRANSACTIONS:", transactions);
                      const isVoided =
                        item.type === "PAYMENT" &&
                        item.isVoided === true;

                      return (
                        <tr key={item._id}>
                          <td>
                            {item.transactionDate
                              ? new Date(item.transactionDate).toLocaleDateString()
                              : "-"}
                          </td>

                          <td>
                            <div>
                              {item.type || "-"}
                            </div>

                            {isVoided && (
                              <span
                                style={{
                                  display: "inline-block",
                                  marginTop: 5,
                                  padding: "3px 8px",
                                  borderRadius: 4,
                                  background: "#fee2e2",
                                  color: "#b91c1c",
                                  fontSize: 11,
                                  fontWeight: 700,
                                }}
                              >
                                VOIDED
                              </span>
                            )}
                          </td>

                          <td>
                            {item.description || item.reference || "-"}

                            {item.transactionId && (
                              <small style={{ display: "block" }}>
                                ID: {item.transactionId}
                              </small>
                            )}

                            {isVoided && (
                              <div
                                style={{
                                  marginTop: 5,
                                  color: "#b91c1c",
                                  fontSize: 12,
                                }}
                              >
                                Original Amount: à§³{" "}
                                {Number(item.amount || 0).toLocaleString()}

                                <br />

                                Void Reason: {item.voidReason || "Not provided"}
                              </div>
                            )}
                          </td>

                          <td>{item.paymentMethod || "-"}</td>

                          <td>
                            à§³ {Number(
                              isVoided ? 0 : item.debit || 0
                            ).toLocaleString()}
                          </td>

                          <td>
                            à§³ {Number(
                              isVoided ? 0 : item.credit || 0
                            ).toLocaleString()}
                          </td>

                          <td>
                            à§³ {Number(item.balanceAfter || 0).toLocaleString()}
                          </td>

<td>
  {item.type === "PAYMENT" && !item.isVoided ? (
    <div style={{ display: "flex", gap: 6 }}>
      <button
        type="button"
        className="secondary-button"
        onClick={() => openPaymentEdit(item, ledgerSupplier)}
        style={{ padding: "6px 10px", fontSize: 12 }}
      >
        Edit
      </button>

      <button
        type="button"
        onClick={() => openPaymentVoid(item)}
        style={{
          padding: "6px 10px",
          fontSize: 12,
          background: "#dc2626",
          color: "#fff",
          border: "none",
          borderRadius: 5,
          cursor: "pointer",
        }}
      >
        Void
      </button>

      <button
  type="button"
  className="secondary-button"
  onClick={() => openPaymentHistory(item)}
  style={{ padding: "6px 10px", fontSize: 12 }}
>
  History
</button>
    </div>
  ) : item.type === "PAYMENT" && item.isVoided ? (
    <span style={{ color: "#b91c1c", fontWeight: 700 }}>
      VOIDED
    </span>
  ) : (
    "-"
  )}
</td>


                        </tr>
                      );
                    })}

                    {transactions.length === 0 && (
                      <tr>
                        <td colSpan="8" style={{ textAlign: "center" }}>
                          No transactions found
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
<div
  className="supplier-ledger-pagination"
  style={{
    display: "flex",
    justifyContent: "space-between",
    alignItems: "center",

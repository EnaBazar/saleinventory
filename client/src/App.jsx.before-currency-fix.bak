                    <td style={{ padding: 10 }}>
                      {expense.accountName || "-"}
                    </td>

                    <td
                      style={{
                        padding: 10,
                        fontWeight: 800,
                        color: "#dc2626",
                        whiteSpace: "nowrap",
                      }}
                    >
                      à§³ {formatMoney(expense.amount)}
                    </td>

                    <td style={{ padding: 10 }}>
                      {expense.reference || "-"}
                    </td>

                    <td style={{ padding: 10, maxWidth: 220 }}>
                      {expense.description || "-"}
                    </td>

                    {/* ACTION BUTTONS */}
                    <td style={{ padding: 10, whiteSpace: "nowrap" }}>
                      <div style={{ display: "flex", gap: 7 }}>
                        <button
                          type="button"

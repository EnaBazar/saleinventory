                <p style={{ color: "#b45309", fontSize: 12, margin: "0 0 12px" }}>
                  Transaction à¦¥à¦¾à¦•à¦²à§‡ Backend Opening Balance à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨ à¦•à¦°à¦¤à§‡ à¦¦à§‡à¦¬à§‡ à¦¨à¦¾à¥¤
                </p>
              )}

              <div style={gridStyle}>
                <div>
                  <label style={labelStyle}>Opening Balance (à§³)</label>
                  <input
                    type="number"
                    min="0"
                    step="0.01"

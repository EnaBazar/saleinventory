    setEditingCustomerId(null);

    setCustomerForm({
      customerName: "",
      companyName: "",
      contactPerson: "",
      mobile: "",
      alternateMobile: "",
      address: "",
      customerType: "REGULAR",
      openingBalance: "0",
      notes: "",
    });
  }

  setShowCustomerForm(true);
}
const saveCategory = async () => {

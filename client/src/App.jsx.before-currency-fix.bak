async function submitPurchaseReturn(e) {
  e.preventDefault();

  if (!returnLot) {
    toast.error("Lot à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
    return;
  }

  const bagsReturned = Number(returnForm.bagsReturned || 0);
  const weightReturnedKg = Number(returnForm.weightReturnedKg || 0);

  if (!Number.isInteger(bagsReturned) || bagsReturned < 0) {
    toast.error("à¦¸à¦ à¦¿à¦• à¦¬à¦¸à§à¦¤à¦¾à¦° à¦¸à¦‚à¦–à§à¦¯à¦¾ à¦¦à¦¿à¦¨");
    return;
  }

  if (weightReturnedKg <= 0) {
    toast.error("à¦«à§‡à¦°à¦¤ à¦¦à§‡à¦“à§Ÿà¦¾à¦° à¦•à§‡à¦œà¦¿ à¦²à¦¿à¦–à§à¦¨");
    return;
  }

  if (bagsReturned > Number(returnLot.remainingBags || 0)) {
    toast.error("à¦…à¦¬à¦¶à¦¿à¦·à§à¦Ÿ à¦¬à¦¸à§à¦¤à¦¾à¦° à¦šà§‡à§Ÿà§‡ à¦¬à§‡à¦¶à¦¿ à¦«à§‡à¦°à¦¤ à¦¦à§‡à¦“à§Ÿà¦¾ à¦¯à¦¾à¦¬à§‡ à¦¨à¦¾");
    return;
  }

  if (weightReturnedKg > Number(returnLot.remainingWeightKg || 0)) {
    toast.error("à¦…à¦¬à¦¶à¦¿à¦·à§à¦Ÿ à¦¸à§à¦Ÿà¦•à§‡à¦° à¦šà§‡à§Ÿà§‡ à¦¬à§‡à¦¶à¦¿ à¦«à§‡à¦°à¦¤ à¦¦à§‡à¦“à§Ÿà¦¾ à¦¯à¦¾à¦¬à§‡ à¦¨à¦¾");
    return;
  }

  try {
    setReturnLoading(true);

    const result = await apiRequest(`/lots/${returnLot._id}/returns`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        bagsReturned,
        weightReturnedKg,
        returnDate: returnForm.returnDate,
        notes: returnForm.notes,
      }),
    });

    toast.success(result.message || "Purchase Return à¦¸à¦«à¦² à¦¹à§Ÿà§‡à¦›à§‡");

    setShowReturnForm(false);
    setReturnLot(null);

    await loadLots();
    await loadProducts();
  } catch (error) {
    toast.error(error.message || "Purchase Return à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
  } finally {
    setReturnLoading(false);
  }
}


                    <td>{provider.bankName || "-"}</td>

                    <td>{provider.accountNumber || "-"}</td>

                    <td>
                      à§³
                      {Number(provider.openingBalance || 0).toLocaleString(
                        "en-BD"
                      )}
                    </td>

                    <td>
                      <span
                        style={{
                          color: provider.isActive ? "#15803d" : "#dc2626",
                          fontWeight: 600,
                        }}
                      >
                        {provider.isActive ? "Active" : "Inactive"}
                      </span>
                    </td>

                    <td>
                      <div
                        style={{
                          display: "flex",
                          gap: 8,
                          flexWrap: "wrap",
                        }}
                      >
                        <button
                          type="button"
                          onClick={() => startEditLoanProvider(provider)}
                          style={{
                            padding: "7px 12px",
                            borderRadius: 8,
                            border: "1px solid #bfdbfe",
                            background: "#eff6ff",
                            color: "#1d4ed8",
                            fontWeight: 600,
                            cursor: "pointer",
                          }}
                        >
                          Edit
                        </button>

                        <button
                          type="button"
                          onClick={() => toggleLoanProviderStatus(provider)}
                          style={{
                            padding: "7px 12px",
                            borderRadius: 8,
                            border: "1px solid",
                            borderColor: provider.isActive
                              ? "#fecaca"
                              : "#bbf7d0",
                            background: provider.isActive
                              ? "#fef2f2"
                              : "#f0fdf4",
                            color: provider.isActive
                              ? "#dc2626"
                              : "#15803d",
                            fontWeight: 600,
                            cursor: "pointer",
                          }}
                        >
                          {provider.isActive ? "Deactivate" : "Activate"}
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

    });

    const result = await apiRequest(
      `/customers/${customer._id}/ledger?${params.toString()}`
    );
setCustomerLedgerData({
  ...result,
  ...(result.data || {}),
});

  } catch (error) {
    toast.error(error.message || "Customer Ledger à¦²à§‹à¦¡ à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
  
  } finally {
    setCustomerLedgerLoading(false);
  }
}


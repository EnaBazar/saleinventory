                          borderBottom: "1px solid #e2e8f0",
                        }}
                      >
                        {formatNumber(invoice.netSupplierPayable)}
                      </td>
<td
  style={{
    padding: "11px 12px",
    fontSize: 12,
    fontWeight: 700,
    color:
      Number(invoice.pocketLotProfit) >= 0
        ? "#15803d"
        : "#dc2626",
    borderBottom: "1px solid #e2e8f0",
    whiteSpace: "nowrap",
  }}
>
  {invoice.pocketLotProfit === null ||
  invoice.pocketLotProfit === undefined
    ? "-"
    : formatNumber(invoice.pocketLotProfit)}
</td>
                      <td
                        style={{

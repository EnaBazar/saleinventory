                  </strong>
                </div>

                <div>
                  <label style={fieldLabel}>Original Invoice Total</label>
                  <strong style={{ color: "#1d4ed8" }}>
                    à§³ {Number(selectedSalesReturn.grandTotal || 0).toLocaleString("en-BD")}
                  </strong>
                </div>

                <div>
                  <label style={fieldLabel}>Customer Current Due</label>
                  <strong style={{ color: "#dc2626" }}>
                    à§³ {Number(selectedSalesReturn.currentCustomerDue || 0).toLocaleString("en-BD")}
                  </strong>
                </div>
              </div>
            </div>

            {/* PRODUCT RETURN */}
            <div
              style={{
                background: "#fff",
                border: "1px solid #dbe3ed",
                borderRadius: 8,
                padding: 14,
                marginBottom: 12,
              }}
            >
              <h3 style={sectionHeading}>
                <span style={{ color: "#f97316" }}>02.</span>
                Product Return Entry
              </h3>

              <div style={{ overflowX: "auto" }}>
                <table style={{ width: "100%", minWidth: 720 }}>
                  <thead>
                    <tr>
                      <th>PRODUCT / LOT</th>
                      <th>ORIGINAL BAGS</th>
                      <th>RETURNED</th>
                      <th>RETURNABLE</th>
                      <th>RETURN BAGS</th>
                      <th>RETURN KG</th>
                    </tr>
                  </thead>

                  <tbody>
                    {salesReturnItems.map((item, index) => (
                      <tr key={item.originalSaleItemId}>
                        <td>
                          <strong>{item.productName}</strong>
                          <div style={{ fontSize: 10, color: "#64748b" }}>
                            {item.lotCode || "-"} | {item.stockType}
                          </div>
                        </td>

                        <td>
                          {item.originalBags} Bags
                          <div style={{ fontSize: 10, color: "#64748b" }}>
                            {item.originalWeightKg} KG
                          </div>
                        </td>

                        <td>
                          {item.alreadyReturnedBags} Bags
                          <div style={{ fontSize: 10, color: "#64748b" }}>
                            {item.alreadyReturnedWeightKg} KG
                          </div>
                        </td>

                        <td style={{ color: "#15803d", fontWeight: 700 }}>
                          {item.returnableBags} Bags
                          <div style={{ fontSize: 10 }}>
                            {item.returnableWeightKg} KG
                          </div>
                        </td>

                        <td>
                          <input
                            type="number"
                            min="0"
                            max={item.returnableBags}
                            step="0.001"
                            style={{ ...compactInput, width: 85 }}
                            value={item.returnBags}
                            disabled={
                              item.returnableBags <= 0 ||
                              salesReturnSubmitting
                            }
                            onChange={(e) =>
                              updateSalesReturnItem(
                                index,
                                "returnBags",
                                e.target.value
                              )
                            }
                          />
                        </td>

                        <td>
                          <input
                            type="number"
                            min="0"
                            max={item.returnableWeightKg}
                            step="0.01"
                            style={{ ...compactInput, width: 95 }}
                            value={item.returnWeightKg}
                            disabled={
                              item.returnableWeightKg <= 0 ||
                              salesReturnSubmitting
                            }
                            onChange={(e) =>
                              updateSalesReturnItem(
                                index,
                                "returnWeightKg",
                                e.target.value
                              )
                            }
                          />
                        </td>
                      </tr>
                    ))}

                    {salesReturnItems.length === 0 && (
                      <tr>
                        <td colSpan={6} style={{ textAlign: "center", padding: 20 }}>
                          No products found.
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>

              <p style={{ fontSize: 10, color: "#64748b", marginBottom: 0 }}>
                Return Quantity à¦…à¦¬à¦¶à§à¦¯à¦‡ Returnable Quantity-à¦à¦° à¦®à¦§à§à¦¯à§‡ à¦°à¦¾à¦–à¦¤à§‡ à¦¹à¦¬à§‡à¥¤
              </p>
            </div>

            {/* FINANCIAL SUMMARY */}
            <div
              style={{
                background: "#fff",
                border: "1px solid #dbe3ed",
                borderRadius: 8,
                padding: 14,
                marginBottom: 12,
              }}
            >
              <h3 style={sectionHeading}>
                <span style={{ color: "#f97316" }}>03.</span>
                Return Financial Summary
              </h3>

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit,minmax(150px,1fr))",
                  gap: 9,
                }}
              >
                {[
                  {
                    label: "Return Amount",
                    amount: salesReturnCalculation.returnAmount,
                    color: "#1d4ed8",
                  },
                  {
                    label: "Customer Current Due",
                    amount: salesReturnCalculation.previousDue,
                    color: "#dc2626",
                  },
                  {
                    label: "Due Adjustment",
                    amount: salesReturnCalculation.amountAdjusted,
                    color: "#7c3aed",
                  },
                  {
                    label: "Refund Amount",
                    amount: salesReturnCalculation.refundAmount,
                    color: "#ea580c",
                  },
                  {
                    label: "Remaining Customer Due",
                    amount: salesReturnCalculation.remainingDue,
                    color: "#15803d",
                  },
                ].map((item) => (
                  <div
                    key={item.label}
                    style={{
                      padding: 11,
                      background: "#f8fafc",
                      border: "1px solid #e2e8f0",
                      borderRadius: 7,
                    }}
                  >
                    <div style={fieldLabel}>{item.label}</div>
                    <strong style={{ color: item.color, fontSize: 16 }}>
                      à§³ {Number(item.amount || 0).toLocaleString("en-BD", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2,
                      })}
                    </strong>
                  </div>
                ))}
              </div>
            </div>

            {/* REFUND INFORMATION */}
            <div
              style={{
                background: "#fff",
                border: "1px solid #dbe3ed",
                borderRadius: 8,
                padding: 14,
              }}
            >
              <h3 style={sectionHeading}>
                <span style={{ color: "#f97316" }}>04.</span>
                Refund Information & Notes
              </h3>

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit,minmax(180px,1fr))",
                  gap: 10,
                }}
              >
                <div>
  <label style={fieldLabel}>Refund Method</label>
  <select
    style={compactInput}
    value={salesReturnRefundMethod}
    onChange={(e) => {
      setSalesReturnRefundMethod(e.target.value);
      setSalesReturnRefundAccountId("");
    }}
    disabled={
      salesReturnSubmitting ||
      salesReturnCalculation.refundAmount <= 0
    }
  >
    <option value="CASH">Cash</option>
    <option value="BANK">Bank</option>
    <option value="BKASH">bKash</option>
    <option value="OTHER">Other</option>
  </select>
</div>

{salesReturnCalculation.refundAmount > 0 &&
  ["CASH", "BANK", "BKASH"].includes(salesReturnRefundMethod) && (
    <div>
      <label style={fieldLabel}>Refund Account</label>
      <select
        style={compactInput}
        value={salesReturnRefundAccountId}
        onChange={(e) =>
          setSalesReturnRefundAccountId(e.target.value)
        }
        disabled={salesReturnSubmitting}
      >
        <option value="">Select Refund Account</option>

        {accounts
          .filter(
            (account) =>
              account.isActive &&
              account.accountType === salesReturnRefundMethod
          )
          .map((account) => (
            <option key={account._id} value={account._id}>
              {account.accountName}
            </option>
          ))}
      </select>
    </div>
  )}

                <div>
                  <label style={fieldLabel}>Return Notes</label>
                  <input
                    style={compactInput}
                    value={salesReturnNotes}
                    onChange={(e) => setSalesReturnNotes(e.target.value)}
                    placeholder="Reason for product return..."
                    disabled={salesReturnSubmitting}
                  />
                </div>
              </div>
            </div>
          </>
        ) : (
          <p style={{ textAlign: "center", padding: 30 }}>
            Invoice information à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤
          </p>
        )}
      </div>

      {/* FOOTER */}
      <div
        style={{
          padding: "12px 16px",
          background: "#fff",
          borderTop: "1px solid #e2e8f0",
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          gap: 10,
          flexWrap: "wrap",
        }}
      >
        <strong style={{ fontSize: 13, color: "#1e293b" }}>
          Return: à§³ {Number(salesReturnCalculation.returnAmount || 0).toLocaleString("en-BD", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          })}
        </strong>

        <div style={{ display: "flex", gap: 8 }}>
          <button
            type="button"
            className="secondary-button"
            disabled={salesReturnSubmitting}
            onClick={() => setShowSalesReturn(false)}
          >
            Close
          </button>

         <button
  type="button"
  className="primary-button"
  disabled={false}
  onClick={submitSalesReturn}
  style={{
    background: "#ea580c",
    borderColor: "#ea580c",
  }}
>
  {salesReturnSubmitting ? "Processing..." : "Confirm Sales Return"}
</button>
        </div>
      </div>
    </div>
  </div>
)}


  </>
);
}


// ========================================
// ACCOUNT MANAGEMENT PAGE
// ========================================
async function saveAccount() {
  if (!accountForm.accountName.trim()) {
    toast.error("Account Name à¦¦à¦¿à¦¤à§‡ à¦¹à¦¬à§‡");
    return;
  }

  if (
    accountForm.accountType === "BANK" &&
    !accountForm.bankName.trim()
  ) {
    toast.error("Bank Name à¦¦à¦¿à¦¤à§‡ à¦¹à¦¬à§‡");
    return;
  }

  try {
    setAccountSaving(true);

    await apiRequest("/accounts", {
      method: "POST",
      body: JSON.stringify({
        ...accountForm,
        openingBalance: Number(accountForm.openingBalance || 0),
      }),
    });

    toast.success("Account à¦¸à¦«à¦²à¦­à¦¾à¦¬à§‡ à¦¤à§ˆà¦°à¦¿ à¦¹à§Ÿà§‡à¦›à§‡");

    setAccountForm({
      accountName: "",
      accountType: "CASH",
      bankName: "",
      accountNumber: "",
      branchName: "",
      openingBalance: "0",
      openingBalanceDate: new Date().toISOString().slice(0, 10),
      notes: "",
    });

    await loadAccounts();
  } catch (error) {
    toast.error(error.message || "Account à¦¤à§ˆà¦°à¦¿ à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
  } finally {
    setAccountSaving(false);
  }
}
// ========================================
// UPDATE ACCOUNT
// ========================================
async function updateAccount() {
  if (!accountForm.accountName.trim()) {
    toast.error("Account Name à¦¦à¦¿à¦¤à§‡ à¦¹à¦¬à§‡");
    return;
  }

  if (
    accountForm.accountType === "BANK" &&
    !accountForm.bankName.trim()
  ) {
    toast.error("Bank Name à¦¦à¦¿à¦¤à§‡ à¦¹à¦¬à§‡");
    return;
  }

  if (!accountEditingId) {
    toast.error("Account à¦¨à¦¿à¦°à§à¦¬à¦¾à¦šà¦¨ à¦•à¦°à¦¾ à¦¹à§Ÿà¦¨à¦¿");
    return;
  }

const originalOpeningBalance = Number(
  accounts.find((a) => a._id === accountEditingId)
    ?.openingBalance || 0
);

const newOpeningBalance = Number(
  accountForm.openingBalance || 0
);

if (
  newOpeningBalance !== originalOpeningBalance &&
  !accountAdjustmentReason.trim()
) {
  toast.error("Opening Balance à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨à§‡à¦° à¦•à¦¾à¦°à¦£ à¦²à¦¿à¦–à§à¦¨");
  return;
}

  try {
    setAccountSaving(true);

    await apiRequest(`/accounts/${accountEditingId}`, {
      method: "PUT",
body: JSON.stringify({
  accountName: accountForm.accountName,
  bankName: accountForm.bankName,
  accountNumber: accountForm.accountNumber,
  branchName: accountForm.branchName,
  notes: accountForm.notes,
  openingBalance: Number(accountForm.openingBalance || 0),
  adjustmentReason: accountAdjustmentReason,
}),
    });

    toast.success("Account à¦¸à¦«à¦²à¦­à¦¾à¦¬à§‡ Update à¦¹à§Ÿà§‡à¦›à§‡");

    setAccountEditingId("");

    setAccountForm({
      accountName: "",
      accountType: "CASH",
      bankName: "",
      accountNumber: "",
      branchName: "",
      openingBalance: "0",
      openingBalanceDate: new Date().toISOString().slice(0, 10),
      notes: "",
    });
setAccountAdjustmentReason("");

    await loadAccounts();
  } catch (error) {
    toast.error(error.message || "Account Update à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
  } finally {
    setAccountSaving(false);
  }
}



function renderAccountTransactions() {
  const fieldStyle = {
    width: "100%",
    padding: "10px 12px",
    border: "1px solid #dbe1ea",
    borderRadius: 6,
    fontSize: 13,
    outline: "none",
    boxSizing: "border-box",
    background: "#fff",
  };

  const labelStyle = {
    display: "block",
    fontSize: 12,
    fontWeight: 600,
    color: "#475569",
    marginBottom: 6,
  };
const formTransactions = accountTransactions.filter(
  (transaction) => transaction.source === "MANUAL"
);

  return (
    <div style={{ display: "grid", gap: 20 }}>
      <div className="panel" style={{ padding: 22 }}>
        <h2 style={{ margin: "0 0 8px" }}>Account Transactions</h2>
        <p style={{ color: "#7b8494", margin: "0 0 20px" }}>
          Cash, Bank à¦à¦¬à¦‚ bKash Account-à¦ à¦Ÿà¦¾à¦•à¦¾ à¦œà¦®à¦¾, à¦‰à¦¤à§à¦¤à§‹à¦²à¦¨ à¦“ Transfer
        </p>

        <div style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))",
          gap: 16,
        }}>
          <div>
            <label style={labelStyle}>Transaction Type *</label>
            <select
              style={fieldStyle}
              value={transactionForm.transactionType}
              onChange={(e) => setTransactionForm(prev => ({
                ...prev,
                transactionType: e.target.value,
                relatedAccountId: "",
              }))}
            >
              <option value="DEPOSIT">Deposit (à¦œà¦®à¦¾)</option>
              <option value="WITHDRAWAL">Withdraw (à¦‰à¦¤à§à¦¤à§‹à¦²à¦¨)</option>
              <option value="TRANSFER">Transfer (à¦¸à§à¦¥à¦¾à¦¨à¦¾à¦¨à§à¦¤à¦°)</option>
            </select>
          </div>

          <div>
            <label style={labelStyle}>
              {transactionForm.transactionType === "DEPOSIT"
                ? "Deposit To Account *"
                : "From Account *"}
            </label>

            
            <select
              style={fieldStyle}
              value={transactionForm.accountId}
              onChange={(e) => setTransactionForm(prev => ({
                ...prev,
                accountId: e.target.value,
              }))}
            >
              <option value="">Select Account</option>
              {accounts.filter(a => a.isActive !== false).map(account => (
                <option key={account._id} value={account._id}>
                  {account.accountName} ({account.accountType})
                </option>
              ))}
            </select>
          </div>

          {transactionForm.transactionType === "TRANSFER" && (
            <div>
              <label style={labelStyle}>To Account *</label>
              <select
                style={fieldStyle}
                value={transactionForm.relatedAccountId}
                onChange={(e) => setTransactionForm(prev => ({
                  ...prev,
                  relatedAccountId: e.target.value,
                }))}
              >
                <option value="">Select Destination Account</option>
                {accounts.filter(a =>
                  a.isActive !== false &&
                  a._id !== transactionForm.accountId
                ).map(account => (
                  <option key={account._id} value={account._id}>
                    {account.accountName} ({account.accountType})
                  </option>
                ))}
              </select>
            </div>
          )}

          <div>
            <label style={labelStyle}>Amount (à§³) *</label>
            <input
              type="number"
              min="0.01"
              step="0.01"
              style={fieldStyle}
              placeholder="Enter amount"
              value={transactionForm.amount}
              onChange={(e) => setTransactionForm(prev => ({
                ...prev,
                amount: e.target.value,
              }))}
            />
          </div>

          <div>
            <label style={labelStyle}>Transaction Date</label>
            <input
              type="date"
              style={fieldStyle}
              value={transactionForm.transactionDate}
              onChange={(e) => setTransactionForm(prev => ({
                ...prev,
                transactionDate: e.target.value,
              }))}
            />
          </div>

          <div>
            <label style={labelStyle}>Reference</label>
            <input
              style={fieldStyle}
              placeholder="Optional reference"
              value={transactionForm.reference}
              onChange={(e) => setTransactionForm(prev => ({
                ...prev,
                reference: e.target.value,
              }))}
            />
          </div>

          <div>
            <label style={labelStyle}>Description</label>
            <input
              style={fieldStyle}
              placeholder="Transaction details"
              value={transactionForm.description}
              onChange={(e) => setTransactionForm(prev => ({
                ...prev,
                description: e.target.value,
              }))}
            />
          </div>
        </div>

        <div style={{ marginTop: 18 }}>
          <button
            className="primary-button"
            onClick={saveAccountTransaction}
            disabled={transactionSaving}
          >
            {transactionSaving ? "Processing..." : "Save Transaction"}
          </button>
        </div>
      </div>

      {/* ACCOUNT TRANSACTIONS LIST */}
  
{/* EDIT TRANSACTION FORM */}
{editingTransaction && (
  <div className="panel" style={{ padding: 20 }}>
    <h3 style={{ marginTop: 0 }}>Edit Transaction</h3>

    <div style={{
      display: "grid",
      gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))",
      gap: 14
    }}>
      <div>
        <label style={labelStyle}>Amount (à§³)</label>
        <input
          type="number"
          style={fieldStyle}
          value={editingTransaction.amount}
          onChange={(e) =>
            setEditingTransaction(prev => ({
              ...prev,
              amount: e.target.value
            }))
          }
        />
      </div>

      <div>
        <label style={labelStyle}>Transaction Date</label>
        <input
          type="date"
          style={fieldStyle}
          value={editingTransaction.transactionDate}
          onChange={(e) =>
            setEditingTransaction(prev => ({
              ...prev,
              transactionDate: e.target.value
            }))
          }
        />
      </div>

      <div>
        <label style={labelStyle}>Reference</label>
        <input
          style={fieldStyle}
          value={editingTransaction.reference || ""}
          onChange={(e) =>
            setEditingTransaction(prev => ({
              ...prev,
              reference: e.target.value
            }))
          }
        />
      </div>

      <div>
        <label style={labelStyle}>Description</label>
        <input
          style={fieldStyle}
          value={editingTransaction.description || ""}
          onChange={(e) =>
            setEditingTransaction(prev => ({
              ...prev,
              description: e.target.value
            }))
          }
        />
      </div>

      <div>
        <label style={labelStyle}>Edit Reason *</label>
        <input
          style={fieldStyle}
          placeholder="à¦•à§‡à¦¨ à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨ à¦•à¦°à¦›à§‡à¦¨?"
          value={editingTransaction.reason || ""}
          onChange={(e) =>
            setEditingTransaction(prev => ({
              ...prev,
              reason: e.target.value
            }))
          }
        />
      </div>
    </div>

    <div style={{ display: "flex", gap: 10, marginTop: 18 }}>
      <button
        className="primary-button"
        onClick={updateAccountTransaction}
        disabled={transactionEditSaving}
      >
        {transactionEditSaving ? "Updating..." : "Update Transaction"}
      </button>

      <button
        type="button"
        onClick={() => setEditingTransaction(null)}
        disabled={transactionEditSaving}
      >
        Cancel
      </button>
    </div>
  </div>
)}



{/* RECENT ACCOUNT TRANSACTIONS */}
<div className="panel" style={{ padding: 18 }}>
  <h3 style={{ margin: "0 0 14px", fontSize: 16 }}>
    Recent Transactions
  </h3>

  {formTransactions.length === 0 ? (
    <p style={{ color: "#94a3b8", textAlign: "center", padding: 12 }}>
      à¦à¦–à¦¨à§‹ à¦•à§‹à¦¨à§‹ Transaction à¦¯à§‹à¦— à¦•à¦°à¦¾ à¦¹à§Ÿà¦¨à¦¿
    </p>
  ) : (
    <div style={{ overflowX: "auto" }}>
      <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 13 }}>
        <thead>
          <tr style={{ background: "#f1f5f9", textAlign: "left" }}>
            {["Date", "Account", "Type", "Amount", "Action"].map(item => (
              <th key={item} style={{ padding: 10 }}>{item}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {formTransactions.slice(0, 10).map(transaction => (
            <tr key={transaction._id}>
              <td style={{ padding: 10 }}>
                {transaction.transactionDate
                  ? new Date(transaction.transactionDate).toLocaleDateString()
                  : "-"}
              </td>
              <td style={{ padding: 10 }}>
                {transaction.accountId?.accountName || "-"}
              </td>
              <td style={{ padding: 10 }}>
                {transaction.transactionType === "DEPOSIT"
                  ? "Deposit"
                  : transaction.transactionType === "WITHDRAWAL"
                  ? "Withdraw"
                  : "Transfer"}
              </td>
              <td style={{ padding: 10, fontWeight: 600 }}>
                à§³{Number(transaction.amount || 0).toLocaleString()}
              </td>
              <td style={{ padding: 10, whiteSpace: "nowrap" }}>
                <button
                  type="button"
                  onClick={() => startEditAccountTransaction(transaction)}
                  disabled={transactionActionLoading}
                >
                  Edit
                </button>
                {" "}
                <button
                  type="button"
                  onClick={() => voidAccountTransaction(transaction)}
                  disabled={transactionActionLoading}
                >
                  Delete
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</div>

    </div>
  );
}

// ========================================
// DAILY ACCOUNT CLOSING UI
// ========================================

function renderDailyAccountClosing() {
  const fieldStyle = {
    width: "100%",
    padding: "10px 12px",
    border: "1px solid #dbe1ea",
    borderRadius: 6,
    fontSize: 13,
    outline: "none",
    boxSizing: "border-box",
    background: "#fff",
  };

  const labelStyle = {
    display: "block",
    fontSize: 12,
    fontWeight: 600,
    color: "#475569",
    marginBottom: 6,
  };

  const activeAccounts = accounts.filter(
    (account) => account.isActive !== false
  );

  const preview = closingPreview;
  const isCash = preview?.requiresPhysicalCount === true;

  const systemBalance = Number(
    preview?.systemClosingBalance || 0
  );

  const actualBalance = isCash
    ? Number(actualClosingBalance || 0)
    : systemBalance;

  const difference = actualBalance - systemBalance;

  const closingStatus =
    difference === 0
      ? "MATCHED"
      : difference < 0
      ? "SHORT"
      : "EXCESS";

  const statusColor =
    closingStatus === "MATCHED"
      ? "#16a34a"
      : closingStatus === "SHORT"
      ? "#dc2626"
      : "#2563eb";

  const money = (value) =>
    `à§³ ${Number(value || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    })}`;

  return (
    <div style={{ display: "grid", gap: 18 }}>

      {/* PAGE HEADER */}
      <div className="panel" style={{ padding: 22 }}>
        <div style={pageHeaderStyle}>
          <div>
            <h2 style={{ margin: 0 }}>
              Daily Account Closing
            </h2>

            <p style={{ color: "#7b8494", margin: "6px 0 0" }}>
              à¦ªà§à¦°à¦¤à¦¿à¦¦à¦¿à¦¨à§‡à¦° Cash, Bank à¦à¦¬à¦‚ bKash Account Closing
            </p>
          </div>

          <button
            className="primary-button"
            onClick={loadDailyClosingHistory}
            disabled={closingHistoryLoading}
          >
            {closingHistoryLoading ? "Loading..." : "Refresh History"}
          </button>
        </div>
      </div>

      {/* CLOSING SELECTION */}
      <div className="panel" style={{ padding: 22 }}>
        <h3 style={{ margin: "0 0 18px", fontSize: 16 }}>
          Select Account & Date
        </h3>

        <div
          style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))",
            gap: 16,
          }}
        >
          <div>
            <label style={labelStyle}>Account *</label>

            <select
              style={fieldStyle}
              value={closingAccountId}
              onChange={(e) => {
                setClosingAccountId(e.target.value);
                setClosingPreview(null);
                setActualClosingBalance("");
              }}
            >
              <option value="">Select Account</option>

              {activeAccounts.map((account) => (
                <option key={account._id} value={account._id}>
                  {account.accountName} ({account.accountType})
                </option>
              ))}
            </select>
          </div>

          <div>
            <label style={labelStyle}>Closing Date *</label>

            <input
              type="date"
              style={fieldStyle}
              value={closingDate}
              max={getBangladeshToday()}
              onChange={(e) => {
                setClosingDate(e.target.value);
                setClosingPreview(null);
                setActualClosingBalance("");
              }}
            />
          </div>

          <div style={{ display: "flex", alignItems: "end" }}>
            <button
              className="primary-button"
              style={{ width: "100%", padding: 11 }}
              onClick={loadDailyClosingPreview}
              disabled={
                closingPreviewLoading ||
                !closingAccountId ||
                !closingDate
              }
            >
              {closingPreviewLoading
                ? "Loading Preview..."
                : "Show Closing Preview"}
            </button>
          </div>
        </div>
      </div>

      {/* CLOSING PREVIEW */}
      {preview && (
        <>
          {preview.alreadyClosed && preview.existingClosing ? (
            <div
              className="panel"
              style={{
                padding: 22,
                border: "1px solid #16a34a",
              }}
            >
              <h3 style={{ marginTop: 0, color: "#16a34a" }}>
                à¦à¦‡ à¦¤à¦¾à¦°à¦¿à¦–à§‡à¦° Closing à¦‡à¦¤à¦¿à¦®à¦§à§à¦¯à§‡ à¦¸à¦®à§à¦ªà¦¨à§à¦¨ à¦¹à§Ÿà§‡à¦›à§‡
              </h3>

              <p>
                Closing Date: <strong>{preview.closingDate}</strong>
              </p>

              <p>
                System Closing:{" "}
                <strong>{money(preview.existingClosing.systemClosingBalance)}</strong>
              </p>

              <p>
                Actual Closing:{" "}
                <strong>{money(preview.existingClosing.actualClosingBalance)}</strong>
              </p>

              <p>
                Difference:{" "}
                <strong>{money(preview.existingClosing.difference)}</strong>
              </p>

              <p>
                Status:{" "}
                <strong>{preview.existingClosing.closingStatus}</strong>
              </p>
            </div>
          ) : (
            <div className="panel" style={{ padding: 22 }}>
              <h3 style={{ margin: "0 0 18px", fontSize: 16 }}>
                Closing Summary
              </h3>

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
                  gap: 14,
                }}
              >
                {[
                  {
                    label: "Opening Balance",
                    value: preview.openingBalance,
                  },
                  {
                    label: "Total In (+)",
                    value: preview.totalIn,
                  },
                  {
                    label: "Total Out (-)",
                    value: preview.totalOut,
                  },
                  {
                    label: "System Closing",
                    value: preview.systemClosingBalance,
                  },
                ].map((item) => (
                  <div
                    key={item.label}
                    style={{
                      padding: 16,
                      background: "#f8fafc",
                      border: "1px solid #e2e8f0",
                      borderRadius: 8,
                    }}
                  >
                    <p
                      style={{
                        margin: 0,
                        color: "#64748b",
                        fontSize: 12,
                      }}
                    >
                      {item.label}
                    </p>

                    <h3 style={{ margin: "8px 0 0", fontSize: 19 }}>
                      {money(item.value)}
                    </h3>
                  </div>
                ))}
              </div>

              <p
                style={{
                  fontSize: 12,
                  color: "#64748b",
                  margin: "14px 0 0",
                }}
              >
                Total Transactions: {preview.totalTransactions || 0}
              </p>

              {/* PHYSICAL CASH COUNT */}
              {isCash && (
                <div
                  style={{
                    marginTop: 22,
                    padding: 18,
                    border: "1px solid #f59e0b",
                    borderRadius: 8,
                    background: "#fffbeb",
                  }}
                >
                  <h3 style={{ margin: "0 0 14px", fontSize: 15 }}>
                    Physical Cash Count
                  </h3>

                  <label style={labelStyle}>
                    à¦¹à¦¾à¦¤à§‡ à¦—à¦£à¦¨à¦¾ à¦•à¦°à¦¾ à¦ªà§à¦°à¦•à§ƒà¦¤ Cash Balance (à§³) *
                  </label>

                  <input
                    type="number"
                    min="0"
                    step="0.01"
                    style={fieldStyle}
                    placeholder="à¦¹à¦¾à¦¤à§‡ à¦¥à¦¾à¦•à¦¾ à¦Ÿà¦¾à¦•à¦¾à¦° à¦ªà¦°à¦¿à¦®à¦¾à¦£ à¦²à¦¿à¦–à§à¦¨"
                    value={actualClosingBalance}
                    onChange={(e) =>
                      setActualClosingBalance(e.target.value)
                    }
                  />
                </div>
              )}

              {/* DIFFERENCE */}
              {(!isCash || actualClosingBalance !== "") && (
                <div
                  style={{
                    marginTop: 18,
                    padding: 18,
                    borderRadius: 8,
                    border: `1px solid ${statusColor}`,
                    background: "#f8fafc",
                  }}
                >
                  <div
                    style={{
                      display: "grid",
                      gridTemplateColumns: "repeat(auto-fit, minmax(150px, 1fr))",
                      gap: 14,
                    }}
                  >
                    <div>
                      <p style={{ margin: 0, fontSize: 12, color: "#64748b" }}>
                        Actual Closing
                      </p>
                      <h3 style={{ margin: "6px 0 0" }}>
                        {money(actualBalance)}
                      </h3>
                    </div>

                    <div>
                      <p style={{ margin: 0, fontSize: 12, color: "#64748b" }}>
                        Difference
                      </p>
                      <h3 style={{ margin: "6px 0 0", color: statusColor }}>
                        {difference > 0 ? "+" : ""}
                        {money(difference)}
                      </h3>
                    </div>

                    <div>
                      <p style={{ margin: 0, fontSize: 12, color: "#64748b" }}>
                        Closing Status
                      </p>
                      <h3 style={{ margin: "6px 0 0", color: statusColor }}>
                        {closingStatus}
                      </h3>
                    </div>
                  </div>
                </div>
              )}

              {/* REMARKS */}
              <div style={{ marginTop: 18 }}>
                <label style={labelStyle}>Remarks (Optional)</label>

                <textarea
                  style={{
                    ...fieldStyle,
                    minHeight: 75,
                    resize: "vertical",
                  }}
                  placeholder="Closing à¦¸à¦®à§à¦ªà¦°à§à¦•à§‡ à¦•à§‹à¦¨à§‹ à¦®à¦¨à§à¦¤à¦¬à§à¦¯ à¦¥à¦¾à¦•à¦²à§‡ à¦²à¦¿à¦–à§à¦¨"
                  value={closingRemarks}
                  onChange={(e) => setClosingRemarks(e.target.value)}
                />
              </div>

              {/* SAVE */}
              <div style={{ marginTop: 18 }}>
                <button
                  className="primary-button"
                  style={{ padding: "12px 24px" }}
                  onClick={saveDailyAccountClosing}
                  disabled={
                    closingSaving ||
                    (isCash && actualClosingBalance === "")
                  }
                >
                  {closingSaving ? "Saving..." : "Confirm & Save Closing"}
                </button>
              </div>
            </div>
          )}
        </>
      )}

      {/* CLOSING HISTORY */}
      <div className="panel" style={{ padding: 22 }}>
        <div style={pageHeaderStyle}>
          <div>
            <h3 style={{ margin: 0 }}>Daily Closing History</h3>
            <p style={{ color: "#7b8494", margin: "6px 0 0", fontSize: 12 }}>
              à¦ªà§‚à¦°à§à¦¬à§‡à¦° Account Closing-à¦à¦° à¦¤à¦¾à¦²à¦¿à¦•à¦¾
            </p>
          </div>

          <button
            className="primary-button"
            onClick={loadDailyClosingHistory}
            disabled={closingHistoryLoading}
          >
            {closingHistoryLoading ? "Loading..." : "Load History"}
          </button>
        </div>

        <div style={{ overflowX: "auto", marginTop: 18 }}>
          <table
            style={{
              width: "100%",
              borderCollapse: "collapse",
              fontSize: 12,
              minWidth: 950,
            }}
          >
            <thead>
              <tr style={{ background: "#f8fafc" }}>
                {[
                  "Date",
                  "Account",
                  "Opening",
                  "Total In",
                  "Total Out",
                  "System Closing",
                  "Actual Closing",
                  "Difference",
                  "Status",
                ].map((heading) => (
                  <th
                    key={heading}
                    style={{
                      padding: 11,
                      borderBottom: "1px solid #e2e8f0",
                      textAlign: "left",
                      whiteSpace: "nowrap",
                    }}
                  >
                    {heading}
                  </th>
                ))}
              </tr>
            </thead>

            <tbody>
              {closingHistoryLoading ? (
                <tr>
                  <td colSpan="9" style={{ padding: 20, textAlign: "center" }}>
                    Loading closing history...
                  </td>
                </tr>
              ) : closingHistory.length === 0 ? (
                <tr>
                  <td colSpan="9" style={{ padding: 20, textAlign: "center", color: "#94a3b8" }}>
                    à¦•à§‹à¦¨à§‹ Closing History à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿
                  </td>
                </tr>
              ) : (
                closingHistory.map((item) => (
                  <tr key={item._id}>
                    <td style={{ padding: 11, borderBottom: "1px solid #e2e8f0" }}>
                      {item.closingDate}
                    </td>

                    <td style={{ padding: 11, borderBottom: "1px solid #e2e8f0" }}>
                      {item.accountId?.accountName || "Account"}
                    </td>

                    <td style={{ padding: 11, borderBottom: "1px solid #e2e8f0" }}>
                      {money(item.openingBalance)}
                    </td>

                    <td style={{ padding: 11, borderBottom: "1px solid #e2e8f0" }}>
                      {money(item.totalIn)}
                    </td>

                    <td style={{ padding: 11, borderBottom: "1px solid #e2e8f0" }}>
                      {money(item.totalOut)}
                    </td>

                    <td style={{ padding: 11, borderBottom: "1px solid #e2e8f0" }}>
                      {money(item.systemClosingBalance)}
                    </td>

                    <td style={{ padding: 11, borderBottom: "1px solid #e2e8f0" }}>
                      {money(item.actualClosingBalance)}
                    </td>

                    <td style={{ padding: 11, borderBottom: "1px solid #e2e8f0" }}>
                      {money(item.difference)}
                    </td>

                    <td style={{ padding: 11, borderBottom: "1px solid #e2e8f0" }}>
                      <strong
                        style={{
                          color:
                            item.closingStatus === "MATCHED"
                              ? "#16a34a"
                              : item.closingStatus === "SHORT"
                              ? "#dc2626"
                              : "#2563eb",
                        }}
                      >
                        {item.closingStatus}
                      </strong>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}


// ========================================
// START EDIT ACCOUNT
// ========================================
function startEditAccount(account) {
  setAccountEditingId(account._id);
setAccountAdjustmentReason("");
  setAccountForm({
    accountName: account.accountName || "",
    accountType: account.accountType || "CASH",
    bankName: account.bankName || "",
    accountNumber: account.accountNumber || "",
    branchName: account.branchName || "",
    openingBalance: String(account.openingBalance || 0),
    openingBalanceDate: account.openingBalanceDate
      ? new Date(account.openingBalanceDate).toISOString().slice(0, 10)
      : new Date().toISOString().slice(0, 10),
    notes: account.notes || "",
  });

  window.scrollTo({
    top: 0,
    behavior: "smooth",
  });
}


// ========================================
// DEACTIVATE ACCOUNT (SAFE DELETE)
// ========================================
async function deactivateAccount(account) {
  const confirmed = window.confirm(
    `"${account.accountName}" Account Deactivate à¦•à¦°à¦¤à§‡ à¦šà¦¾à¦¨?\n\nà¦ªà§à¦°à§‹à¦¨à§‹ Transaction History à¦®à§à¦›à§‡ à¦¯à¦¾à¦¬à§‡ à¦¨à¦¾à¥¤`
  );

  if (!confirmed) return;

  try {
    await apiRequest(`/accounts/${account._id}/deactivate`, {
      method: "PATCH",
    });

    toast.success("Account à¦¸à¦«à¦²à¦­à¦¾à¦¬à§‡ Deactivate à¦¹à§Ÿà§‡à¦›à§‡");

    if (accountEditingId === account._id) {
      setAccountEditingId("");

      setAccountForm({
        accountName: "",
        accountType: "CASH",
        bankName: "",
        accountNumber: "",
        branchName: "",
        openingBalance: "0",
        openingBalanceDate: new Date().toISOString().slice(0, 10),
        notes: "",
      });
    }

    await loadAccounts();
  } catch (error) {
    toast.error(error.message || "Account Deactivate à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
  }
}


async function reactivateAccount(account) {
  const confirmed = window.confirm(
    `"${account.accountName}" Account à¦†à¦¬à¦¾à¦° Active à¦•à¦°à¦¤à§‡ à¦šà¦¾à¦¨?`
  );

  if (!confirmed) return;

  try {
    await apiRequest(`/accounts/${account._id}/activate`, {
      method: "PATCH",
    });

    toast.success("Account à¦¸à¦«à¦²à¦­à¦¾à¦¬à§‡ Reactivate à¦¹à§Ÿà§‡à¦›à§‡");

    await loadAccounts();
  } catch (error) {
    toast.error(error.message || "Account Reactivate à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
  }
}

// ========================================
// DAILY CASH BOOK REPORT PAGE
// ========================================

function renderDailyCashBook() {
  const fieldStyle = {
    width: "100%",
    padding: "10px 12px",
    border: "1px solid #dbe1ea",
    borderRadius: 7,
    fontSize: 13,
    background: "#fff",
    boxSizing: "border-box",
  };

  const formatMoney = (amount) =>
    Number(amount || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

  const cardStyle = {
    background: "#fff",
    border: "1px solid #e2e8f0",
    borderRadius: 9,
    padding: 16,
    minWidth: 0,
  };

  const getRowDate = (row) => {
    const date = row.transactionDate || row.date || row.createdAt;
    return date ? new Date(date).toLocaleDateString("en-GB") : "-";
  };

  const getRowDirection = (row) => {
    if (row.direction) return row.direction;

    const type = String(row.transactionType || "").toUpperCase();

    if (
      ["DEPOSIT", "TRANSFER_IN", "OPENING_BALANCE"].includes(type)
    ) {
      return "IN";
    }

    return "OUT";
  };

  return (
    <div className="panel" style={{ padding: 16, background: "#f8fafc" }}>
      <div style={{
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center",
        flexWrap: "wrap",
        gap: 12,
        marginBottom: 18,
      }}>
        <div>
          <h2 style={{ margin: 0, color: "#172554", fontSize: 21 }}>
            Daily Cash Book
          </h2>
          <p style={{ margin: "5px 0 0", color: "#64748b", fontSize: 12 }}>
            Daily cash and account transaction statement
          </p>
        </div>

        <button
          type="button"
          onClick={loadDailyCashBook}
          disabled={cashBookLoading}
          style={{
            padding: "9px 16px",
            border: "none",
            borderRadius: 7,
            background: "#2563eb",
            color: "#fff",
            fontWeight: 700,
            cursor: "pointer",
          }}
        >
          {cashBookLoading ? "Loading..." : "â†» Refresh"}
        </button>
      </div>

      {/* FILTERS */}
      <div style={{
        display: "grid",
        gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
        gap: 12,
        background: "#fff",
        border: "1px solid #e2e8f0",
        borderRadius: 9,
        padding: 15,
        marginBottom: 16,
      }}>
        <div>
          <label style={{
            display: "block",
            fontSize: 12,
            fontWeight: 700,
            color: "#475569",
            marginBottom: 6,
          }}>
            Select Account
          </label>

          <select
            style={fieldStyle}
            value={cashBookFilters.accountId}
            onChange={(e) =>
              setCashBookFilters((prev) => ({
                ...prev,
                accountId: e.target.value,
              }))
            }
          >
            <option value="">All Accounts</option>
            {accounts.map((account) => (
              <option key={account._id} value={account._id}>
                {account.accountName || account.name || account.bankName || "Account"}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label style={{
            display: "block",
            fontSize: 12,
            fontWeight: 700,
            color: "#475569",
            marginBottom: 6,
          }}>
            From Date
          </label>

          <input
            type="date"
            style={fieldStyle}
            value={cashBookFilters.fromDate}
            onChange={(e) =>
              setCashBookFilters((prev) => ({
                ...prev,
                fromDate: e.target.value,
              }))
            }
          />
        </div>

        <div>
          <label style={{
            display: "block",
            fontSize: 12,
            fontWeight: 700,
            color: "#475569",
            marginBottom: 6,
          }}>
            To Date
          </label>

          <input
            type="date"
            style={fieldStyle}
            value={cashBookFilters.toDate}
            onChange={(e) =>
              setCashBookFilters((prev) => ({
                ...prev,
                toDate: e.target.value,
              }))
            }
          />
        </div>

        <div style={{
          display: "flex",
          alignItems: "end",
          gap: 8,
        }}>
          <button
            type="button"
            onClick={() => {
              if (
                cashBookFilters.fromDate &&
                cashBookFilters.toDate &&
                cashBookFilters.fromDate > cashBookFilters.toDate
              ) {
                toast.error("From Date, To Date-à¦à¦° à¦ªà¦°à§‡ à¦¹à¦¤à§‡ à¦ªà¦¾à¦°à¦¬à§‡ à¦¨à¦¾");
                return;
              }

              loadDailyCashBook();
            }}
            disabled={cashBookLoading}
            style={{
              padding: "10px 17px",
              border: "none",
              borderRadius: 7,
              background: "#0f766e",
              color: "#fff",
              fontWeight: 700,
              cursor: "pointer",
            }}
          >
            Apply Filter
          </button>

          <button
            type="button"
            onClick={() => {
              const today = new Date().toISOString().slice(0, 10);

              setCashBookFilters({
                accountId: "",
                fromDate: today,
                toDate: today,
              });

              setTimeout(() => {
                loadDailyCashBook();
              }, 0);
            }}
            style={{
              padding: "10px 14px",
              border: "1px solid #cbd5e1",
              borderRadius: 7,
              background: "#fff",
              color: "#475569",
              fontWeight: 700,
              cursor: "pointer",
            }}
          >
            Today
          </button>
        </div>
      </div>

      {/* SUMMARY CARDS */}
      <div style={{
        display: "grid",
        gridTemplateColumns: "repeat(auto-fit, minmax(170px, 1fr))",
        gap: 12,
        marginBottom: 18,
      }}>
        <div style={{ ...cardStyle, borderTop: "3px solid #64748b" }}>
          <div style={{ fontSize: 12, color: "#64748b", fontWeight: 700 }}>
            Opening Balance
          </div>
          <div style={{
            fontSize: 21,
            fontWeight: 800,
            color: "#334155",
            marginTop: 9,
          }}>
            à§³ {formatMoney(cashBookSummary.openingBalance)}
          </div>
        </div>

        <div style={{ ...cardStyle, borderTop: "3px solid #16a34a" }}>
          <div style={{ fontSize: 12, color: "#64748b", fontWeight: 700 }}>
            Total Cash In
          </div>
          <div style={{
            fontSize: 21,
            fontWeight: 800,
            color: "#16a34a",
            marginTop: 9,
          }}>
            à§³ {formatMoney(cashBookSummary.totalIn)}
          </div>
        </div>

        <div style={{ ...cardStyle, borderTop: "3px solid #dc2626" }}>
          <div style={{ fontSize: 12, color: "#64748b", fontWeight: 700 }}>
            Total Cash Out
          </div>
          <div style={{
            fontSize: 21,
            fontWeight: 800,
            color: "#dc2626",
            marginTop: 9,
          }}>
            à§³ {formatMoney(cashBookSummary.totalOut)}
          </div>
        </div>

        <div style={{ ...cardStyle, borderTop: "3px solid #2563eb" }}>
          <div style={{ fontSize: 12, color: "#64748b", fontWeight: 700 }}>
            Closing Balance
          </div>
          <div style={{
            fontSize: 21,
            fontWeight: 800,
            color: "#2563eb",
            marginTop: 9,
          }}>
            à§³ {formatMoney(cashBookSummary.closingBalance)}
          </div>
        </div>
      </div>

      {/* TRANSACTION TABLE */}
      <div style={{
        background: "#fff",
        border: "1px solid #e2e8f0",
        borderRadius: 9,
        overflow: "hidden",
      }}>
        <div style={{
          padding: 14,
          borderBottom: "1px solid #e2e8f0",
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          flexWrap: "wrap",
          gap: 8,
        }}>
          <h3 style={{ margin: 0, fontSize: 15, color: "#172554" }}>
            Transaction Details
          </h3>
          <span style={{ fontSize: 12, color: "#64748b" }}>
            Total: {cashBookRows.length} Transactions
          </span>
        </div>

        <div style={{ overflowX: "auto" }}>
          <table style={{
            width: "100%",
            minWidth: 850,
            borderCollapse: "collapse",
          }}>
            <thead>
              <tr style={{ background: "#f1f5f9" }}>
                {[
                  "Date",
                  "Transaction Type",
                  "Account",
                  "Description",
                  "Reference",
                  "Cash In",
                  "Cash Out",
                ].map((heading) => (
                  <th
                    key={heading}
                    style={{
                      padding: "11px 12px",
                      fontSize: 11,
                      color: "#475569",
                      textAlign: "left",
                      whiteSpace: "nowrap",
                      borderBottom: "1px solid #e2e8f0",
                    }}
                  >
                    {heading}
                  </th>
                ))}
              </tr>
            </thead>

            <tbody>
              {cashBookLoading ? (
                <tr>
                  <td colSpan="7" style={{
                    padding: 25,
                    textAlign: "center",
                    color: "#64748b",
                  }}>
                    Loading transactions...
                  </td>
                </tr>
              ) : cashBookRows.length === 0 ? (
                <tr>
                  <td colSpan="7" style={{
                    padding: 25,
                    textAlign: "center",
                    color: "#64748b",
                  }}>
                    à¦à¦‡ Date Range-à¦ à¦•à§‹à¦¨à§‹ Transaction à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤
                  </td>
                </tr>
              ) : (
                cashBookRows.map((row) => {
                  const direction = getRowDirection(row);
                  const amount = Number(row.amount || 0);

                  const accountName =
                    row.accountId?.accountName ||
                    row.accountId?.name ||
                    row.accountName ||
                    "-";

                  return (
                    <tr key={row._id}>
                      <td style={{
                        padding: "11px 12px",
                        fontSize: 12,
                        borderBottom: "1px solid #f1f5f9",
                        whiteSpace: "nowrap",
                      }}>
                        {getRowDate(row)}
                      </td>

                      <td style={{
                        padding: "11px 12px",
                        fontSize: 12,
                        borderBottom: "1px solid #f1f5f9",
                      }}>
                        {row.transactionType || "-"}
                      </td>

                      <td style={{
                        padding: "11px 12px",
                        fontSize: 12,
                        borderBottom: "1px solid #f1f5f9",
                      }}>
                        {accountName}
                      </td>

                      <td style={{
                        padding: "11px 12px",
                        fontSize: 12,
                        borderBottom: "1px solid #f1f5f9",
                        maxWidth: 220,
                        whiteSpace: "normal",
                      }}>
                        {row.description || "-"}
                      </td>

                      <td style={{
                        padding: "11px 12px",
                        fontSize: 12,
                        borderBottom: "1px solid #f1f5f9",
                      }}>
                        {row.reference || "-"}
                      </td>

                      <td style={{
                        padding: "11px 12px",
                        fontSize: 12,
                        fontWeight: 700,
                        color: "#16a34a",
                        borderBottom: "1px solid #f1f5f9",
                      }}>
                        {direction === "IN" ? formatMoney(amount) : "-"}
                      </td>

                      <td style={{
                        padding: "11px 12px",
                        fontSize: 12,
                        fontWeight: 700,
                        color: "#dc2626",
                        borderBottom: "1px solid #f1f5f9",
                      }}>
                        {direction === "OUT" ? formatMoney(amount) : "-"}
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

function renderAccountStatement() {

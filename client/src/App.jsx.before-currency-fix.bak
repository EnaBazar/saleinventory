          </div>
        )}

        {/* ACTION BUTTONS */}
        <div
          style={{
            display: "flex",
            gap: 10,
            flexWrap: "wrap",
            marginTop: 22,
            paddingTop: 18,
            borderTop: "1px solid #e2e8f0",
          }}
        >
          <button
            type="button"
            onClick={saveExpense}
            disabled={
              expenseSaving ||
              expenseCategoryLoading ||
              accountLoading ||
              activeCategories.length === 0 ||
              activeAccounts.length === 0
            }
            style={{
              ...buttonStyle,
              background: "#0f766e",
              color: "#fff",
              opacity: expenseSaving ? 0.6 : 1,
            }}
          >
            {expenseSaving ? "Saving Expense..." : "âœ“ Save Expense"}
          </button>

          <button
            type="button"
            disabled={expenseSaving}
            onClick={() =>
              setExpenseForm({
                expenseDate: new Date().toISOString().slice(0, 10),
                categoryId: "",
                accountId: "",
                amount: "",
                voucherNumber: "",
                reference: "",
                description: "",
              })
            }
            style={{
              ...buttonStyle,
              background: "#fff",
              color: "#334155",
              border: "1px solid #cbd5e1",

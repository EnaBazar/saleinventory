          </div>

          <div style={{ fontSize: 23, fontWeight: 800, color: "#2563eb", marginTop: 7 }}>
            {Number(dateWiseExpenseSummary.totalDays || 0).toLocaleString("en-BD")}
          </div>
        </div>
      </div>

      {/* FILTER CARD */}
      <div
        style={{
          background: "#fff",
          border: "1px solid #e2e8f0",
          borderRadius: 10,
          padding: 18,
        }}
      >
        <h3
          style={{
            margin: "0 0 16px",

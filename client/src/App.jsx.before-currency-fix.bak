              onChange={(e) =>
                setExpenseForm((prev) => ({
                  ...prev,
                  voucherNumber: e.target.value,
                }))
              }
            />
          </div>

          {/* REFERENCE */}
          <div>
            <label style={labelStyle}>Reference</label>

            <input
              type="text"
              style={fieldStyle}
              placeholder="Cheque / transaction / other reference"
              value={expenseForm.reference}
              onChange={(e) =>
                setExpenseForm((prev) => ({
                  ...prev,
                  reference: e.target.value,
                }))

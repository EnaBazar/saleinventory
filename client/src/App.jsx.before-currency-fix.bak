}


async function toggleLoanProviderStatus(provider) {
  const nextStatus = !provider.isActive;

  const confirmed = window.confirm(
    `${provider.providerName} Provider-à¦•à§‡ ${
      nextStatus ? "Activate" : "Deactivate"
    } à¦•à¦°à¦¤à§‡ à¦šà¦¾à¦¨?`
  );

  if (!confirmed) return;

  try {
    const result = await apiRequest(
      `/loans/providers/${provider._id}/status`,
      {
        method: "PATCH",
        body: JSON.stringify({
          isActive: nextStatus,
        }),
      }
    );

    toast.success(
      result.message || "Provider status updated successfully"
    );

    await loadLoanProviders();
    await loadLoanReportData();
  } catch (error) {
    toast.error(error.message || "Provider status update failed");
  }
}





function renderNewExpenseEntry() {
  const fieldStyle = {
    width: "100%",
    padding: "11px 13px",
    border: "1px solid #cbd5e1",
    borderRadius: 8,
    outline: "none",
    fontSize: 13,
    boxSizing: "border-box",
    background: "#fff",
    color: "#1e293b",
    transition: "border-color 0.2s",
  };

  const labelStyle = {
    display: "block",
    fontSize: 12,
    fontWeight: 700,
    color: "#334155",
    marginBottom: 7,
  };

  const activeCategories = expenseCategories.filter(
    (item) => item.isActive !== false
  );

  const activeAccounts = accounts.filter(
    (item) => item.isActive !== false
  );

  const selectedAccount = activeAccounts.find(
    (item) => item._id === expenseForm.accountId
  );

  const formatMoney = (value) =>
    Number(value || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

  const buttonStyle = {
    padding: "10px 19px",
    borderRadius: 7,
    fontSize: 12,
    fontWeight: 700,
    cursor: "pointer",
    border: "none",
  };

  return (
    <div style={{ display: "grid", gap: 18, color: "#1e293b" }}>

      {/* HEADER */}
      <div
        style={{
          background: "#1e293b",
          borderRadius: 10,
          padding: "20px 22px",
          color: "#fff",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          gap: 12,
          flexWrap: "wrap",
        }}
      >
        <div>
          <h2 style={{ margin: 0, fontSize: 19, fontWeight: 700 }}>
            New Expense Entry
          </h2>

          <p style={{ color: "#cbd5e1", margin: "6px 0 0", fontSize: 12 }}>
            Record business expenses and update account ledger
          </p>
        </div>

        <button
          type="button"
          onClick={() => {
            loadExpenseCategories();
            loadAccounts();
          }}
          disabled={expenseSaving || expenseCategoryLoading || accountLoading}
          style={{
            ...buttonStyle,
            background: "#0f766e",
            color: "#fff",
            opacity:
              expenseSaving || expenseCategoryLoading || accountLoading
                ? 0.6
                : 1,
          }}
        >
          {expenseCategoryLoading || accountLoading
            ? "Loading..."
            : "â†» Refresh Data"}
        </button>
      </div>

      {/* EXPENSE FORM */}
      <div
        style={{
          background: "#fff",
          border: "1px solid #e2e8f0",
          borderRadius: 10,
          padding: 22,
        }}
      >
        <div
          style={{
            borderBottom: "1px solid #e2e8f0",
            paddingBottom: 14,
            marginBottom: 20,
          }}
        >
          <h3 style={{ margin: 0, fontSize: 16, fontWeight: 700 }}>
            Expense Information
          </h3>

          <p style={{ color: "#64748b", fontSize: 12, margin: "6px 0 0" }}>
            * à¦šà¦¿à¦¹à§à¦¨à¦¿à¦¤ à¦˜à¦°à¦—à§à¦²à§‹ à¦ªà§‚à¦°à¦£ à¦•à¦°à¦¾ à¦¬à¦¾à¦§à§à¦¯à¦¤à¦¾à¦®à§‚à¦²à¦•
          </p>
        </div>

        {(expenseCategoryLoading || accountLoading) && (
          <div
            style={{
              padding: 12,
              background: "#eff6ff",
              color: "#1d4ed8",
              borderRadius: 7,
              fontSize: 12,
              marginBottom: 16,
            }}
          >
            Category à¦à¦¬à¦‚ Account à¦¤à¦¥à§à¦¯ à¦²à§‹à¦¡ à¦¹à¦šà§à¦›à§‡...
          </div>
        )}

        <div
          style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))",
            gap: 17,
          }}
        >
          {/* DATE */}
          <div>
            <label style={labelStyle}>Expense Date *</label>

            <input
              type="date"
              style={fieldStyle}
              value={expenseForm.expenseDate}
              onChange={(e) =>
                setExpenseForm((prev) => ({
                  ...prev,
                  expenseDate: e.target.value,
                }))
              }
            />
          </div>

          {/* CATEGORY */}
          <div>
            <label style={labelStyle}>Expense Category *</label>

            <select
              style={fieldStyle}
              value={expenseForm.categoryId}
              onChange={(e) =>
                setExpenseForm((prev) => ({
                  ...prev,
                  categoryId: e.target.value,
                }))
              }
              disabled={expenseCategoryLoading}
            >
              <option value="">-- Select Expense Category --</option>

              {activeCategories.map((category) => (
                <option key={category._id} value={category._id}>
                  {category.name}
                </option>
              ))}
            </select>

            {!expenseCategoryLoading && activeCategories.length === 0 && (
              <p style={{ color: "#dc2626", fontSize: 11, margin: "6px 0 0" }}>
                à¦†à¦—à§‡ Expense Categories à¦¥à§‡à¦•à§‡ à¦à¦•à¦Ÿà¦¿ Active Category à¦¤à§ˆà¦°à¦¿ à¦•à¦°à§à¦¨à¥¤
              </p>
            )}
          </div>

          {/* ACCOUNT */}
          <div>
            <label style={labelStyle}>Payment Account *</label>

            <select
              style={fieldStyle}
              value={expenseForm.accountId}
              onChange={(e) =>
                setExpenseForm((prev) => ({
                  ...prev,
                  accountId: e.target.value,
                }))
              }
              disabled={accountLoading}
            >
              <option value="">-- Select Cash / Bank / bKash --</option>

              {activeAccounts.map((account) => (
                <option key={account._id} value={account._id}>
                  {account.accountName} ({account.accountType})
                </option>
              ))}
            </select>

            {!accountLoading && activeAccounts.length === 0 && (
              <p style={{ color: "#dc2626", fontSize: 11, margin: "6px 0 0" }}>
                à¦†à¦—à§‡ Accounts à¦¥à§‡à¦•à§‡ Cash, Bank à¦…à¦¥à¦¬à¦¾ bKash Account à¦¤à§ˆà¦°à¦¿ à¦•à¦°à§à¦¨à¥¤
              </p>
            )}
          </div>

          {/* AMOUNT */}
          <div>
            <label style={labelStyle}>Expense Amount (à§³) *</label>

            <input
              type="number"
              min="0.01"

        </h3>

        <button
          type="button"
          onClick={loadCollectionHistory}
          disabled={collectionHistoryLoading}
          style={{
            padding: "8px 13px",
            border: "1px solid #0f766e",
            borderRadius: 7,
            background: "#fff",
            color: "#0f766e",
            fontWeight: 700,
            cursor: "pointer",
          }}
        >
          {collectionHistoryLoading ? "Loading..." : "â†» Load History"}
        </button>
      </div>

      {collectionHistoryLoading ? (
        <div style={{
          padding: 25,
          textAlign: "center",
          color: "#64748b",
        }}>
          Loading collection history...
        </div>
      ) : collectionHistory.length === 0 ? (
        <div style={{
          padding: 25,
          textAlign: "center",
          color: "#64748b",
          background: "#f8fafc",
          borderRadius: 7,
          fontSize: 13,
        }}>
          No collection records found. Load History à¦šà¦¾à¦ªà§à¦¨à¥¤
        </div>
      ) : (
        <div style={{ overflowX: "auto" }}>
          <table style={{
            width: "100%",
            borderCollapse: "collapse",
            minWidth: 850,
            fontSize: 12,
          }}>
            <thead>
              <tr style={{ background: "#f1f5f9" }}>
                {[
                  "Date",
                  "Customer",
                  "Mobile",
                  "Payment Method",
                  "Transaction ID",
                  "Amount",
                  "Notes",
                ].map((heading) => (
                  <th
                    key={heading}
                    style={{
                      padding: "11px 9px",
                      textAlign: "left",
                      color: "#475569",
                      borderBottom: "1px solid #e2e8f0",
                      whiteSpace: "nowrap",
                    }}
                  >
                    {heading}
                  </th>
                ))}
              </tr>
            </thead>

            <tbody>
              {collectionHistory.map((item) => (
                <tr
                  key={item._id}
                  style={{ borderBottom: "1px solid #e2e8f0" }}
                >
                  <td style={{ padding: 10, whiteSpace: "nowrap" }}>
                    {item.transactionDate
                      ? new Date(item.transactionDate).toLocaleDateString("en-GB")
                      : "-"}
                  </td>

                  <td style={{ padding: 10, fontWeight: 700 }}>
                    {item.customerId?.customerName || "Unknown"}
                  </td>

                  <td style={{ padding: 10 }}>
                    {item.customerId?.mobile || "-"}
                  </td>

                  <td style={{ padding: 10 }}>
                    {item.paymentMethod || "-"}
                  </td>

                  <td style={{ padding: 10 }}>
                    {item.transactionId || "-"}
                  </td>

                  <td style={{
                    padding: 10,
                    fontWeight: 800,
                    color: "#0f766e",
                    whiteSpace: "nowrap",
                  }}>
                    à§³ {Number(item.amount || item.credit || 0).toLocaleString("en-BD")}
                  </td>

                  <td style={{ padding: 10 }}>
                    {item.description || item.reference || "-"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
)}

{/* SALES DASHBOARD */}
{(activePage === "Sales Dashboard" || activePage === "Sales") && (

// ========================================
// DAILY STOCK CHECKING PAGE
// ========================================



function renderDailyStockChecking() {
  const number = (value) =>
    Number(value || 0).toLocaleString("en-BD");

  const total = (field) =>
    dailyStockRows.reduce(
      (sum, row) => sum + Number(row[field] || 0),
      0
    );

  const totalCounted = dailyStockRows.reduce(
    (sum, row) =>
      sum +
      (row.countedBags === "" || row.countedBags == null
        ? 0
        : Number(row.countedBags || 0)),
    0
  );

  const matchedCount = dailyStockRows.filter(
    (row) =>
      row.countedBags !== "" &&
      Number(row.countedBags) === Number(row.expectedBags)
  ).length;

  const shortCount = dailyStockRows.filter(
    (row) =>
      row.countedBags !== "" &&
      Number(row.countedBags) < Number(row.expectedBags)
  ).length;

  const extraCount = dailyStockRows.filter(
    (row) =>
      row.countedBags !== "" &&
      Number(row.countedBags) > Number(row.expectedBags)
  ).length;

  const updateCount = (productId, value) => {
    if (value !== "" && (!/^\d+$/.test(value) || Number(value) < 0)) {
      return;
    }

    setDailyStockRows((previous) =>
      previous.map((row) =>
        row.productId === productId
          ? { ...row, countedBags: value }
          : row
      )
    );

    setDailyStockSaved(false);
  };

  const cardStyle = {
    background: "#ffffff",
    border: "1px solid #e5e7eb",
    borderRadius: 12,
    padding: "18px 20px",
    boxShadow: "0 2px 8px rgba(15, 23, 42, 0.04)",
    minWidth: 0,
  };

  const labelStyle = {
    color: "#64748b",
    fontSize: 12,
    fontWeight: 600,
    marginBottom: 9,
    display: "block",
  };

  const valueStyle = {
    fontSize: 25,
    fontWeight: 750,
    color: "#172033",
    lineHeight: 1.2,
  };

  const getDifference = (row) => {
    if (row.countedBags === "" || row.countedBags == null) {
      return null;
    }

    return Number(row.countedBags) - Number(row.expectedBags || 0);
  };

  const getStatus = (row) => {
    const difference = getDifference(row);

    if (dailyStockConfirmed) {
      return row.adjustmentStatus === "NOT_REQUIRED"
        ? { label: "Matched", color: "#15803d", bg: "#dcfce7" }
        : { label: "Adjusted", color: "#1d4ed8", bg: "#dbeafe" };
    }

    if (difference === null) {
      return { label: "Pending", color: "#64748b", bg: "#f1f5f9" };
    }

    if (difference === 0) {
      return { label: "Matched", color: "#15803d", bg: "#dcfce7" };
    }

    if (difference < 0) {
      return { label: "Short", color: "#b91c1c", bg: "#fee2e2" };
    }

    return { label: "Extra", color: "#1d4ed8", bg: "#dbeafe" };
  };

  const inputStyle = {
    width: 105,
    padding: "9px 10px",
    border: "1px solid #cbd5e1",
    borderRadius: 8,
    fontSize: 14,
    fontWeight: 700,
    textAlign: "center",
    outline: "none",
    background: "#ffffff",
    boxSizing: "border-box",
  };

  return (
    <div
      style={{
        padding: "4px 2px 25px",
        color: "#172033",
      }}
    >
      {/* PAGE HEADER */}
      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          flexWrap: "wrap",
          gap: 15,
          marginBottom: 22,
        }}
      >
        <div>
          <h2
            style={{
              margin: 0,
              fontSize: 24,
              fontWeight: 750,
              color: "#172033",
            }}
          >
            Daily Stock Checking
          </h2>

          <p
            style={{
              margin: "6px 0 0",
              color: "#64748b",
              fontSize: 13,
            }}
          >
            Physical stock verification and daily reconciliation
          </p>
        </div>

        <button
          className="btn btn-secondary"
          onClick={() => loadDailyStockCheck(dailyStockDate)}
          disabled={dailyStockLoading}
          style={{
            borderRadius: 8,
            padding: "9px 17px",
            fontWeight: 600,
          }}
        >
          {dailyStockLoading ? "Loading..." : "â†» Refresh"}
        </button>
      </div>

      {/* DATE AND STATUS */}
      <div
        style={{
          ...cardStyle,
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          flexWrap: "wrap",
          gap: 18,
          marginBottom: 20,
        }}
      >
        <div>
          <label style={labelStyle}>STOCK CHECKING DATE</label>

          <input
            type="date"
            className="form-control"
            value={dailyStockDate}
            min="2026-11-23"
            max={getDhakaToday()}
            onChange={(e) => {
              const selectedDate = e.target.value;
              setDailyStockDate(selectedDate);
              loadDailyStockCheck(selectedDate);
            }}
            style={{
              width: 210,
              maxWidth: "100%",
              borderRadius: 8,
              padding: 10,
            }}
          />
        </div>

        <div
          style={{
            padding: "12px 17px",
            borderRadius: 10,
            background: dailyStockConfirmed
              ? "#dcfce7"
              : dailyStockSaved
              ? "#dbeafe"
              : "#fff7ed",
            color: dailyStockConfirmed
              ? "#15803d"
              : dailyStockSaved
              ? "#1d4ed8"
              : "#c2410c",
            minWidth: 190,
          }}
        >
          <div style={{ fontSize: 11, fontWeight: 700, marginBottom: 5 }}>
            CHECK STATUS
          </div>

          <div style={{ fontSize: 14, fontWeight: 750 }}>
            {dailyStockConfirmed
              ? "âœ“ Confirmed"
              : dailyStockSaved
              ? "â— Saved"
              : "â— Not Saved"}
          </div>
        </div>
      </div>

      {/* SUMMARY CARDS */}
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(175px, 1fr))",
          gap: 14,
          marginBottom: 20,
        }}
      >
        <div style={cardStyle}>
          <span style={labelStyle}>Opening Stock</span>
          <div style={valueStyle}>{number(total("openingBags"))}</div>
          <div style={{ color: "#94a3b8", fontSize: 12, marginTop: 7 }}>
            Total Bags
          </div>
        </div>

        <div style={cardStyle}>
          <span style={labelStyle}>Today's Sales</span>
          <div style={{ ...valueStyle, color: "#dc2626" }}>
            {number(total("salesBags"))}
          </div>
          <div style={{ color: "#94a3b8", fontSize: 12, marginTop: 7 }}>
            Sold Bags
          </div>
        </div>

        <div style={cardStyle}>
          <span style={labelStyle}>Sales Return</span>
          <div style={{ ...valueStyle, color: "#2563eb" }}>
            {number(total("salesReturnBags"))}
          </div>
          <div style={{ color: "#94a3b8", fontSize: 12, marginTop: 7 }}>
            Returned Bags
          </div>
        </div>

        <div
          style={{
            ...cardStyle,
            borderColor: "#bfdbfe",
            background: "#f8fbff",
          }}
        >
          <span style={labelStyle}>Expected Stock</span>
          <div style={{ ...valueStyle, color: "#1d4ed8" }}>
            {number(total("expectedBags"))}
          </div>
          <div style={{ color: "#94a3b8", fontSize: 12, marginTop: 7 }}>
            Expected Remaining Bags
          </div>
        </div>
      </div>

      {/* COUNT SUMMARY */}
      <div
        style={{
          ...cardStyle,
          marginBottom: 20,
          padding: "15px 18px",
        }}
      >
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            flexWrap: "wrap",
            gap: 12,
            marginBottom: 13,
          }}
        >
          <strong style={{ fontSize: 14 }}>Physical Count Overview</strong>

          <span style={{ fontSize: 12, color: "#64748b" }}>
            {dailyStockRows.length} Products
          </span>
        </div>

        <div
          style={{
            display: "flex",
            gap: 10,
            flexWrap: "wrap",
          }}
        >
          {[
            { label: "Matched", count: matchedCount, color: "#15803d", bg: "#dcfce7" },
            { label: "Short", count: shortCount, color: "#b91c1c", bg: "#fee2e2" },
            { label: "Extra", count: extraCount, color: "#1d4ed8", bg: "#dbeafe" },
          ].map((item) => (
            <div
              key={item.label}
              style={{
                background: item.bg,
                color: item.color,
                padding: "8px 13px",
                borderRadius: 8,
                fontSize: 12,
                fontWeight: 700,
              }}
            >
              {item.label}: {item.count}
            </div>
          ))}

          <div
            style={{
              background: "#f1f5f9",
              color: "#475569",
              padding: "8px 13px",
              borderRadius: 8,
              fontSize: 12,
              fontWeight: 700,
            }}
          >
            Counted: {number(totalCounted)} Bags
          </div>
        </div>
      </div>

      {/* PRODUCT TABLE */}
      <div
        style={{
          ...cardStyle,
          padding: 0,
          overflow: "hidden",
        }}
      >
        <div
          style={{
            padding: "18px 20px",
            borderBottom: "1px solid #e5e7eb",
          }}
        >
          <h3 style={{ margin: 0, fontSize: 16, fontWeight: 750 }}>
            Product Stock Details
          </h3>

          <p style={{ margin: "5px 0 0", color: "#64748b", fontSize: 12 }}>
            Enter the actual physical bag count for each product
          </p>
        </div>

        {dailyStockLoading ? (
          <div style={{ padding: 35, textAlign: "center", color: "#64748b" }}>
            Loading stock data...
          </div>
        ) : dailyStockRows.length === 0 ? (
          <div style={{ padding: 35, textAlign: "center", color: "#64748b" }}>
            No stock data found for this date.
          </div>
        ) : (
          <div style={{ overflowX: "auto" }}>
            <table
              className="data-table"
              style={{
                width: "100%",
                minWidth: 900,
                borderCollapse: "collapse",
              }}
            >
              <thead>
                <tr style={{ background: "#f8fafc" }}>
                  {[
                    "Product",
                    "Opening",
                    "Sales",
                    "Return",
                    "Expected",
                    "Physical Count",
                    "Difference",
                    "Status",
                  ].map((heading) => (
                    <th
                      key={heading}
                      style={{
                        padding: "13px 12px",
                        fontSize: 11,
                        fontWeight: 750,
                        color: "#475569",
                        whiteSpace: "nowrap",
                        borderBottom: "1px solid #e2e8f0",
                      }}
                    >
                      {heading}
                    </th>
                  ))}
                </tr>
              </thead>

              <tbody>
                {dailyStockRows.map((row) => {
                  const difference = getDifference(row);
                  const status = getStatus(row);

                  return (
                    <tr
                      key={row.productId}
                      style={{
                        borderBottom: "1px solid #f1f5f9",
                        background:
                          difference !== null && difference !== 0
                            ? "#fffdfd"
                            : "#ffffff",
                      }}
                    >
                      <td style={{ padding: "13px 12px" }}>
                        <strong style={{ fontSize: 13 }}>
                          {row.productName}
                        </strong>
                      </td>

                      <td style={{ padding: 12, textAlign: "center" }}>
                        {number(row.openingBags)}
                      </td>

                      <td
                        style={{
                          padding: 12,
                          textAlign: "center",
                          color: "#dc2626",
                        }}
                      >
                        {number(row.salesBags)}
                      </td>

                      <td
                        style={{
                          padding: 12,
                          textAlign: "center",
                          color: "#2563eb",
                        }}
                      >
                        {number(row.salesReturnBags)}
                      </td>

                      <td
                        style={{
                          padding: 12,
                          textAlign: "center",
                          fontWeight: 750,
                        }}
                      >
                        {number(row.expectedBags)}
                      </td>

                      <td style={{ padding: 10, textAlign: "center" }}>
                        <input
                          type="number"
                          min="0"
                          step="1"
                          value={row.countedBags}
                          placeholder="Bags"
                          disabled={
                            dailyStockConfirmed ||
                            dailyStockSaving ||
                            dailyStockConfirming
                          }
                          onChange={(e) =>
                            updateCount(row.productId, e.target.value)
                          }
                          style={{
                            ...inputStyle,
                            background: dailyStockConfirmed ? "#f1f5f9" : "#fff",
                          }}
                        />
                      </td>

                      <td
                        style={{
                          padding: 12,
                          textAlign: "center",
                          fontWeight: 750,
                          color:
                            difference === null
                              ? "#94a3b8"
                              : difference < 0
                              ? "#dc2626"
                              : difference > 0
                              ? "#2563eb"
                              : "#15803d",
                        }}
                      >
                        {difference === null
                          ? "-"
                          : difference > 0
                          ? `+${number(difference)}`
                          : number(difference)}
                      </td>

                      <td style={{ padding: 12, textAlign: "center" }}>
                        <span
                          style={{
                            display: "inline-block",
                            padding: "5px 10px",
                            borderRadius: 20,
                            fontSize: 11,
                            fontWeight: 750,
                            color: status.color,
                            background: status.bg,
                            whiteSpace: "nowrap",
                          }}
                        >
                          {status.label}
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>

              <tfoot>
                <tr style={{ background: "#f8fafc", fontWeight: 750 }}>
                  <td style={{ padding: 13 }}>TOTAL</td>
                  <td style={{ textAlign: "center" }}>
                    {number(total("openingBags"))}
                  </td>
                  <td style={{ textAlign: "center", color: "#dc2626" }}>
                    {number(total("salesBags"))}
                  </td>
                  <td style={{ textAlign: "center", color: "#2563eb" }}>
                    {number(total("salesReturnBags"))}
                  </td>
                  <td style={{ textAlign: "center" }}>
                    {number(total("expectedBags"))}
                  </td>
                  <td style={{ textAlign: "center" }}>
                    {number(totalCounted)}
                  </td>
                  <td colSpan={2}></td>
                </tr>
              </tfoot>
            </table>
          </div>
        )}

        {/* NOTES */}
        <div
          style={{
            padding: 20,
            borderTop: "1px solid #e5e7eb",
          }}
        >
          <label
            style={{
              ...labelStyle,
              color: "#334155",
              fontSize: 13,
            }}
          >
            Notes / Remarks
          </label>

          <textarea
            className="form-control"
            rows="3"
            value={dailyStockNotes}
            disabled={dailyStockConfirmed}
            onChange={(e) => {
              setDailyStockNotes(e.target.value);
              setDailyStockSaved(false);
            }}
            placeholder="Write any stock checking notes here..."
            style={{
              borderRadius: 8,
              resize: "vertical",
            }}
          />

          {/* ACTIONS */}
          <div
            style={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              flexWrap: "wrap",
              gap: 12,
              marginTop: 20,
            }}
          >
            <div style={{ fontSize: 12, color: "#64748b" }}>
              {dailyStockConfirmed
                ? "This day's stock reconciliation is completed."
                : dailyStockSaved
                ? "Physical count saved. You can now confirm the adjustment."
                : "Complete all physical counts and save before confirmation."}
            </div>

            <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>
              <button
                className="btn btn-primary"
                onClick={saveDailyStockCheck}
                disabled={
                  dailyStockSaving ||
                  dailyStockLoading ||
                  dailyStockConfirmed ||
                  !dailyStockRows.length
                }
                style={{
                  borderRadius: 8,
                  padding: "10px 18px",
                  fontWeight: 700,
                }}
              >
                {dailyStockSaving ? "Saving..." : "Save Physical Count"}
              </button>

              <button
                className="btn btn-primary"
                onClick={confirmDailyStockAdjustment}
                disabled={
                  dailyStockConfirming ||
                  dailyStockSaving ||
                  dailyStockLoading ||
                  !dailyStockSaved ||
                  dailyStockConfirmed ||
                  !dailyStockRows.length
                }
                style={{
                  background: "#15803d",
                  borderColor: "#0c66e4",
                  borderRadius: 8,
                  padding: "10px 18px",
                  fontWeight: 700,
                }}
              >
                {dailyStockConfirming
                  ? "Confirming..."
                  : dailyStockConfirmed
                  ? "âœ“ Confirmed"
                  : "Confirm Adjustment"}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}




function renderStockTransactionHistory() {
  const rows = stockTransactions || [];
  const summary = stockTransactionSummary || {};

  const number = (value) =>
    Number(value || 0).toLocaleString("en-BD", {
      maximumFractionDigits: 2,
    });

  const currency = (value) =>
    `à§³ ${Number(value || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    })}`;

  const dateFormat = (value) =>
    value
      ? new Date(value).toLocaleString("en-GB", {
          day: "2-digit",
          month: "short",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        })
      : "-";

  const typeLabel = (type) => {
    const labels = {
      PURCHASE: "Purchase / Stock In",
      PURCHASE_RETURN: "Purchase Return",
      SALES: "Sales",
      SALES_RETURN: "Sales Return",
      STOCK_OUT: "Other Stock Out",
    };

    return labels[type] || type;
  };

  const resetFilters = () => {
    setStockHistoryFrom("");
    setStockHistoryTo("");
    setStockHistoryType("ALL");
    setStockHistoryProductId("ALL");
    setStockHistoryStockType("ALL");

    loadStockTransactionHistory({
      from: "",
      to: "",
      type: "ALL",
      productId: "ALL",
      stockType: "ALL",
    });
  };

  const escapeHtml = (value) =>
    String(value ?? "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[char]);

  const printReport = () => {
    const printWindow = window.open("", "_blank");

    if (!printWindow) {
      toast.error("Please allow pop-ups to print the report");
      return;
    }

    const tableRows = rows.map((row) => `
      <tr>
        <td>${escapeHtml(dateFormat(row.date))}</td>
        <td>${escapeHtml(typeLabel(row.type))}</td>
        <td>${escapeHtml(row.reference || "-")}</td>
        <td>${escapeHtml(row.productName || "-")}</td>
        <td>${escapeHtml(row.lotCode || "-")}</td>
        <td>${escapeHtml(row.stockType || "-")}</td>
        <td class="num">${number(row.bags)}</td>
        <td class="num">${number(row.weightKg)}</td>
        <td class="num">${currency(row.amount)}</td>
        <td>${escapeHtml(row.notes || "-")}</td>
      </tr>
    `).join("");

    printWindow.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Stock Transaction History</title>
        <style>
          body {
            font-family: Arial, sans-serif;
            padding: 20px;
            color: #111827;
          }
          h2 { margin-bottom: 5px; }
          p { color: #555; font-size: 12px; }
          table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 10px;
          }
          th, td {
            border: 1px solid #bbb;
            padding: 7px 5px;
            text-align: left;
          }
          th { background: #eee; }
          .num { text-align: right; }
          @page { size: landscape; margin: 10mm; }
        </style>
      </head>
      <body>
        <h2>Stock Transaction History</h2>
        <p>
          From: ${escapeHtml(stockHistoryFrom || "All")}
          &nbsp; To: ${escapeHtml(stockHistoryTo || "All")}
          &nbsp; Type: ${escapeHtml(stockHistoryType)}
          &nbsp; Stock: ${escapeHtml(stockHistoryStockType)}
        </p>
        <p>Total Transactions: ${rows.length}</p>
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Transaction</th>
              <th>Reference</th>
              <th>Product</th>
              <th>Lot</th>
              <th>Stock</th>
              <th>Bags</th>
              <th>KG</th>
              <th>Amount</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>${tableRows}</tbody>
        </table>
        <script>
          window.onload = function() {
            window.print();
          };
        </script>
      </body>
      </html>
    `);

    printWindow.document.close();
  };

  const summaryCards = [
    {
      title: "Total Transactions",
      value: number(summary.totalTransactions ?? rows.length),
    },
    {
      title: "Purchase KG",
      value: number(summary.purchaseKg),
      sub: `${number(summary.purchaseBags)} Bags`,
    },
    {
      title: "Purchase Return KG",
      value: number(summary.purchaseReturnKg),
      sub: `${number(summary.purchaseReturnBags)} Bags`,
    },
    {
      title: "Sales KG",
      value: number(summary.salesKg),
      sub: `${number(summary.salesBags)} Bags`,
    },
    {
      title: "Sales Return KG",
      value: number(summary.salesReturnKg),
      sub: `${number(summary.salesReturnBags)} Bags`,
    },
    {
      title: "Other Stock Out KG",
      value: number(summary.stockOutKg),
      sub: `${number(summary.stockOutBags)} Bags`,
    },
  ];

  return (
    <div className="panel" style={{ padding: 22 }}>
      <div className="page-heading">
        <div>
          <h2>Stock Transaction History</h2>
          <p>Complete stock movement history with filters and print</p>
        </div>

        <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>
          <button
            className="btn btn-primary"
            onClick={() => loadStockTransactionHistory()}
            disabled={stockTransactionLoading}
          >
            {stockTransactionLoading ? "Loading..." : "Refresh"}
          </button>

          <button
            className="btn btn-primary"
            onClick={printReport}
            disabled={stockTransactionLoading || rows.length === 0}
          >
            Print Report
          </button>
        </div>
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(190px, 1fr))",
          gap: 14,
          margin: "20px 0",
        }}
      >
        {summaryCards.map((card) => (
          <div className="stat-card" key={card.title} style={{ padding: 16 }}>
            <div style={{ fontSize: 13, color: "#64748b" }}>
              {card.title}
            </div>
            <h3 style={{ margin: "10px 0", fontSize: 21 }}>
              {card.value}
            </h3>
            {card.sub && (
              <div style={{ fontSize: 12, color: "#64748b" }}>
                {card.sub}
              </div>
            )}
          </div>
        ))}
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(170px, 1fr))",
          gap: 12,
          padding: 16,
          border: "1px solid #e2e8f0",
          borderRadius: 10,
          marginBottom: 20,
        }}
      >
        <div>
          <label>From Date</label>
          <input
            type="date"
            value={stockHistoryFrom}
            onChange={(e) => setStockHistoryFrom(e.target.value)}
            style={{ width: "100%", padding: 10, marginTop: 6 }}
          />
        </div>

        <div>
          <label>To Date</label>
          <input
            type="date"
            value={stockHistoryTo}
            onChange={(e) => setStockHistoryTo(e.target.value)}
            style={{ width: "100%", padding: 10, marginTop: 6 }}
          />
        </div>

        <div>
          <label>Transaction Type</label>
          <select
            value={stockHistoryType}
            onChange={(e) => setStockHistoryType(e.target.value)}
            style={{ width: "100%", padding: 10, marginTop: 6 }}
          >
            <option value="ALL">All Transactions</option>
            <option value="PURCHASE">Purchase / Stock In</option>
            <option value="PURCHASE_RETURN">Purchase Return</option>
            <option value="SALES">Sales</option>
            <option value="SALES_RETURN">Sales Return</option>
            <option value="STOCK_OUT">Other Stock Out</option>
          </select>
        </div>

        <div>
          <label>Product</label>
          <select
            value={stockHistoryProductId}
            onChange={(e) => setStockHistoryProductId(e.target.value)}
            style={{ width: "100%", padding: 10, marginTop: 6 }}
          >
            <option value="ALL">All Products</option>
            {products.map((product) => (
              <option key={product._id} value={product._id}>
                {product.productName}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label>Stock Type</label>
          <select
            value={stockHistoryStockType}
            onChange={(e) => setStockHistoryStockType(e.target.value)}
            style={{ width: "100%", padding: 10, marginTop: 6 }}
          >
            <option value="ALL">All Stock</option>
            <option value="OWN">OWN</option>
            <option value="COMMISSION">COMMISSION</option>
          </select>
        </div>

        <div style={{ display: "flex", alignItems: "end", gap: 8 }}>
          <button
            className="btn btn-primary"
            style={{ flex: 1 }}
            disabled={stockTransactionLoading}
            onClick={() => loadStockTransactionHistory()}
          >
            Apply Filter
          </button>

          <button
            className="btn"
            style={{ flex: 1 }}
            disabled={stockTransactionLoading}
            onClick={resetFilters}
          >
            Reset
          </button>
        </div>
      </div>

      {stockTransactionLoading ? (
        <div style={{ padding: 35, textAlign: "center" }}>
          Loading stock transactions...
        </div>
      ) : (
        <div style={{ overflowX: "auto" }}>
          <table className="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Transaction</th>
                <th>Reference</th>
                <th>Product</th>
                <th>Lot</th>
                <th>Stock Type</th>
                <th>Bags</th>
                <th>KG</th>
                <th>Amount</th>
                <th>Notes</th>
              </tr>
            </thead>

            <tbody>
              {rows.length === 0 ? (
                <tr>
                  <td colSpan={10} style={{ textAlign: "center", padding: 25 }}>
                    No stock transactions found
                  </td>
                </tr>
              ) : (
                rows.map((row, index) => (
                  <tr key={`${row.type}-${row.reference}-${row.date}-${index}`}>
                    <td>{dateFormat(row.date)}</td>
                    <td><strong>{typeLabel(row.type)}</strong></td>
                    <td>{row.reference || "-"}</td>
                    <td>{row.productName || "-"}</td>
                    <td>{row.lotCode || "-"}</td>
                    <td>{row.stockType || "-"}</td>
                    <td>{number(row.bags)}</td>
                    <td>{number(row.weightKg)}</td>
                    <td>{currency(row.amount)}</td>
                    <td>{row.notes || "-"}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}



function renderCommissionManagement() {
  // =====================================
  // SUMMARY CARD STYLE
  // =====================================
  const summaryCard = {
    background: "#ffffff",
    border: "1px solid #e2e8f0",
    borderRadius: 7,
    padding: 16,
    boxShadow: "0 1px 3px rgba(15,23,42,0.04)",
  };

  // =====================================
  // TABLE STYLES
  // =====================================
  const tableHeaderStyle = {
    padding: "11px 12px",
    background: "#f1f5f9",
    color: "#475569",
    fontSize: 10,
    fontWeight: 700,
    textAlign: "left",
    whiteSpace: "nowrap",
    borderBottom: "1px solid #e2e8f0",
  };

  const tableCellStyle = {
    padding: "11px 12px",
    fontSize: 12,
    color: "#334155",
    borderBottom: "1px solid #e2e8f0",
    whiteSpace: "nowrap",
  };

  // =====================================
  // PENDING LOT TOTALS
  // =====================================
  const totalBags = commissionLots.reduce(
    (sum, lot) => sum + Number(lot.remainingBags || 0),
    0
  );

  const totalWeight = commissionLots.reduce(
    (sum, lot) => sum + Number(lot.remainingWeightKg || 0),
    0
  );

  // =====================================
  // COMMISSION INVOICE CALCULATIONS
  // =====================================
  const commissionTotalBags = commissionItems.reduce(
    (sum, item) => sum + Number(item.bags || 0),
    0
  );

  const commissionTotalWeight = commissionItems.reduce(
    (sum, item) => sum + Number(item.weightKg || 0),
    0
  );

  const commissionGrossAmount = commissionItems.reduce(
    (sum, item) =>
      sum +
      Number(item.weightKg || 0) *
        Number(item.ratePerKg || 0),
    0
  );

  const commissionLabourCost =
    commissionTotalBags * Number(commissionLabourRate || 0);

  const commissionDeduction =
    Number(commissionTransportCost || 0) +
    commissionLabourCost +
    commissionTotalWeight * Number(commissionRatePerKg || 0) +
    Number(commissionOtherCost || 0);

  const commissionNetPayable =
    commissionGrossAmount - commissionDeduction;

  const commissionExpectedBags = Number(
    selectedCommissionLot?.soldBags || 0
  );

  const commissionBagsMatch =
    commissionTotalBags === commissionExpectedBags;

  // =====================================
  // RENDER
  // =====================================
  return (
    <div
      className="panel"
      style={{
        padding: 16,
        background: "#f8fafc",
        minHeight: "100%",
      }}
    >
      {/* =================================
          CREATE COMMISSION INVOICE MODAL
      ================================== */}
      {selectedCommissionLot && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            background: "rgba(15,23,42,0.65)",
            zIndex: 9999,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 12,
          }}
        >
          <div
            style={{
              background: "#ffffff",
              width: "100%",
              maxWidth: 950,
              maxHeight: "92vh",
              overflowY: "auto",
              borderRadius: 9,
              boxShadow: "0 20px 60px rgba(0,0,0,0.25)",
            }}
          >
            {/* MODAL HEADER */}
            <div
              style={{
                background: "#172554",
                padding: "16px 20px",
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
                position: "sticky",
                top: 0,
                zIndex: 2,
              }}
            >
              <div>
                <h3
                  style={{
                    color: "#fff",
                    margin: 0,
                    fontSize: 17,
                    fontWeight: 700,
                  }}
                >
                  Create Commission Invoice
                </h3>
                <p
                  style={{
                    color: "#cbd5e1",
                    fontSize: 11,
                    margin: "4px 0 0",
                  }}
                >
                  Lot: {selectedCommissionLot.lotCode || "-"}
                </p>
              </div>

              <button
                type="button"
                onClick={() => setSelectedCommissionLot(null)}
                style={{
                  background: "transparent",
                  border: "1px solid #64748b",
                  color: "#fff",
                  borderRadius: 5,
                  padding: "5px 10px",
                  cursor: "pointer",
                }}
              >
                âœ•
              </button>
            </div>

            <div style={{ padding: 18 }}>
              {/* LOT INFORMATION */}
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "repeat(auto-fit,minmax(150px,1fr))",
                  gap: 10,
                  marginBottom: 18,
                }}
              >
                {[
                  [
                    "Product",
                    selectedCommissionLot.productId?.productName ||
                      selectedCommissionLot.productName ||
                      "-",
                  ],
                  [
                    "Supplier",
                    selectedCommissionLot.supplierId?.supplierName ||
                      selectedCommissionLot.supplierName ||
                      "-",
                  ],
                  ["Lot Bags", selectedCommissionLot.soldBags ?? 0],
                  [
                    "Lot Weight (KG)",
                    Number(
                      selectedCommissionLot.soldWeightKg || 0
                    ).toFixed(2),
                  ],
                ].map(([label, value]) => (
                  <div
                    key={label}
                    style={{
                      background: "#f8fafc",
                      border: "1px solid #e2e8f0",
                      borderRadius: 6,
                      padding: 12,
                    }}
                  >
                    <div
                      style={{
                        fontSize: 10,
                        color: "#64748b",
                        fontWeight: 700,
                      }}
                    >
                      {label}
                    </div>
                    <div
                      style={{
                        fontSize: 14,
                        color: "#172554",
                        fontWeight: 700,
                        marginTop: 5,
                      }}
                    >
                      {value}
                    </div>
                  </div>
                ))}
              </div>

              {/* COMMISSION ITEMS */}
              <div
                style={{
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  flexWrap: "wrap",
                  gap: 10,
                  marginBottom: 10,
                }}
              >
                <h4
                  style={{
                    margin: 0,
                    color: "#172554",
                    fontSize: 14,
                    fontWeight: 700,
                  }}
                >
                  Commission Items
                </h4>

                <button
                  type="button"
                  onClick={() =>
                    setCommissionItems((prev) => [
                      ...prev,
                      {
                        bags: "",
                        weightKg: "",
                        ratePerKg: "",
                      },
                    ])
                  }
                  className="secondary-button"
                  style={{
                    fontSize: 11,
                    padding: "7px 12px",
                  }}
                >
                  + Add Item
                </button>
              </div>

              <div
                style={{
                  overflowX: "auto",
                  marginBottom: 14,
                }}
              >
                <table
                  style={{
                    width: "100%",
                    minWidth: 650,
                    borderCollapse: "collapse",
                  }}
                >
                  <thead>
                    <tr style={{ background: "#f1f5f9" }}>
                      {[
                        "SL",
                        "BAGS",
                        "WEIGHT (KG)",
                        "RATE / KG",
                        "AMOUNT",
                        "ACTION",
                      ].map((heading) => (
                        <th
                          key={heading}
                          style={tableHeaderStyle}
                        >
                          {heading}
                        </th>
                      ))}
                    </tr>
                  </thead>

                  <tbody>
                    {commissionItems.map((item, index) => (
                      <tr key={index}>
                        <td style={tableCellStyle}>
                          {index + 1}
                        </td>

                        {["bags", "weightKg", "ratePerKg"].map(
                          (field) => (
                            <td
                              key={field}
                              style={{ padding: 6 }}
                            >
                              <input
                                type="number"
                                min="0"
                                step="any"
                                value={item[field]}
                                onChange={(e) => {
                                  const value = e.target.value;

                                  setCommissionItems((prev) =>
                                    prev.map((row, i) =>
                                      i === index
                                        ? {
                                            ...row,
                                            [field]: value,
                                          }
                                        : row
                                    )
                                  );
                                }}
                                style={{
                                  width: "100%",
                                  minWidth: 85,
                                  padding: 8,
                                  border: "1px solid #cbd5e1",
                                  borderRadius: 5,
                                  fontSize: 12,
                                  boxSizing: "border-box",
                                }}
                              />
                            </td>
                          )
                        )}

                        <td
                          style={{
                            ...tableCellStyle,
                            fontWeight: 700,
                            color: "#172554",
                          }}
                        >
                          {(
                            Number(item.weightKg || 0) *
                            Number(item.ratePerKg || 0)
                          ).toFixed(2)}
                        </td>

                        <td style={{ padding: 6 }}>
                          <button
                            type="button"
                            disabled={commissionItems.length === 1}
                            onClick={() =>
                              setCommissionItems((prev) =>
                                prev.filter((_, i) => i !== index)
                              )
                            }
                            style={{
                              border: "1px solid #fecaca",
                              background: "#fef2f2",
                              color: "#dc2626",
                              borderRadius: 5,
                              padding: "5px 9px",
                              cursor: "pointer",
                            }}
                          >
                            âœ•
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {/* BAGS VALIDATION */}
              <div
                style={{
                  padding: 11,
                  background: commissionBagsMatch
                    ? "#f0fdf4"
                    : "#fff7ed",
                  border: `1px solid ${
                    commissionBagsMatch
                      ? "#bbf7d0"
                      : "#fed7aa"
                  }`,
                  borderRadius: 6,
                  marginBottom: 18,
                  fontSize: 12,
                  color: commissionBagsMatch
                    ? "#15803d"
                    : "#c2410c",
                  fontWeight: 700,
                }}
              >
                Invoice Bags: {commissionTotalBags} / Required Bags:{" "}
                {commissionExpectedBags}
                {" â€” "}
                {commissionBagsMatch
                  ? "Bags Matched"
                  : "Bags Not Matched"}
              </div>

              {/* DEDUCTIONS */}
              <h4
                style={{
                  color: "#172554",
                  fontSize: 14,
                  fontWeight: 700,
                  margin: "0 0 12px",
                }}
              >
                Other Charges & Deductions
              </h4>

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "repeat(auto-fit,minmax(170px,1fr))",
                  gap: 12,
                }}
              >
                {[
                  [
                    "Transport Cost",
                    commissionTransportCost,
                    setCommissionTransportCost,
                  ],
                  [
                    "Labour Rate / Bag",
                    commissionLabourRate,
                    setCommissionLabourRate,
                  ],
                  [
                    "Commission Rate / KG",
                    commissionRatePerKg,
                    setCommissionRatePerKg,
                  ],
                  [
                    "Other Cost",
                    commissionOtherCost,
                    setCommissionOtherCost,
                  ],
                ].map(([label, value, setter]) => (
                  <div key={label}>
                    <label
                      style={{
                        display: "block",
                        fontSize: 11,
                        color: "#475569",
                        fontWeight: 600,
                        marginBottom: 5,
                      }}
                    >
                      {label}
                    </label>

                    <input
                      type="number"
                      min="0"
                      step="any"
                      value={value}
                      onChange={(e) =>
                        setter(e.target.value)
                      }
                      style={{
                        width: "100%",
                        padding: "9px 10px",
                        border: "1px solid #cbd5e1",
                        borderRadius: 5,
                        fontSize: 12,
                        boxSizing: "border-box",
                      }}
                    />
                  </div>
                ))}
              </div>

              {/* NOTES */}
              <div style={{ marginTop: 15 }}>
                <label
                  style={{
                    display: "block",
                    fontSize: 11,
                    color: "#475569",
                    fontWeight: 600,
                    marginBottom: 5,
                  }}
                >
                  Notes
                </label>

                <textarea
                  value={commissionNotes}
                  onChange={(e) =>
                    setCommissionNotes(e.target.value)
                  }
                  rows={2}
                  placeholder="Optional invoice notes..."
                  style={{
                    width: "100%",
                    padding: 10,
                    border: "1px solid #cbd5e1",
                    borderRadius: 5,
                    fontSize: 12,
                    resize: "vertical",
                    boxSizing: "border-box",
                  }}
                />
              </div>

              {/* TOTALS */}
              <div
                style={{
                  background: "#f8fafc",
                  border: "1px solid #e2e8f0",
                  borderRadius: 7,
                  padding: 14,
                  marginTop: 18,
                }}
              >
                {[
                  ["Total Bags", commissionTotalBags],
                  [
                    "Total Weight (KG)",
                    commissionTotalWeight.toFixed(2),
                  ],
                  [
                    "Gross Amount",
                    commissionGrossAmount.toFixed(2),
                  ],
                  [
                    "Transport Cost",
                    Number(commissionTransportCost || 0).toFixed(2),
                  ],
                  [
                    "Labour Cost",
                    commissionLabourCost.toFixed(2),
                  ],
                  [
                    "Commission Cost",
                    (
                      commissionTotalWeight *
                      Number(commissionRatePerKg || 0)
                    ).toFixed(2),
                  ],
                  [
                    "Other Cost",
                    Number(commissionOtherCost || 0).toFixed(2),
                  ],
                  [
                    "Total Deduction",
                    commissionDeduction.toFixed(2),
                  ],
                ].map(([label, value]) => (
                  <div
                    key={label}
                    style={{
                      display: "flex",
                      justifyContent: "space-between",
                      gap: 10,
                      padding: "5px 0",
                      fontSize: 12,
                      color: "#475569",
                    }}
                  >
                    <span>{label}</span>
                    <strong>{value}</strong>
                  </div>
                ))}

                <div
                  style={{
                    borderTop: "2px solid #cbd5e1",
                    marginTop: 8,
                    paddingTop: 12,
                    display: "flex",
                    justifyContent: "space-between",
                    fontSize: 16,
                    color: "#172554",
                    fontWeight: 800,
                  }}
                >
                  <span>Net Supplier Payable</span>
                  <span>
                    {commissionNetPayable.toFixed(2)}
                  </span>
                </div>
              </div>

              {/* FOOTER ACTIONS */}
              <div
                style={{
                  display: "flex",
                  justifyContent: "flex-end",
                  gap: 10,
                  flexWrap: "wrap",
                  marginTop: 18,
                }}
              >
                <button
                  type="button"
                  className="secondary-button"
                  onClick={() =>
                    setSelectedCommissionLot(null)
                  }
                  style={{ padding: "9px 16px" }}
                >
                  Cancel
                </button>

                <button
                  type="button"
                  className="primary-button"
                  disabled={
                    commissionSaving ||
                    !commissionBagsMatch ||
                    commissionItems.some(
                      (item) =>
                        !Number(item.bags) ||
                        !Number(item.weightKg) ||
                        item.ratePerKg === "" ||
                        Number(item.bags) <= 0 ||
                        Number(item.weightKg) <= 0 ||
                        Number(item.ratePerKg) < 0
                    ) ||
                    commissionNetPayable < 0
                  }
                  onClick={createCommissionInvoice}
                  style={{
                    padding: "9px 18px",
                    opacity:
                      commissionSaving || !commissionBagsMatch
                        ? 0.5
                        : 1,
                  }}
                >
                  {commissionSaving
                    ? "Saving..."
                    : "Save Commission Invoice"}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* =================================
          PAGE HEADER
      ================================== */}
      <div
        style={{
          background: "#172554",
          borderRadius: 7,
          padding: "17px 20px",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          flexWrap: "wrap",
          gap: 12,
          marginBottom: 16,
        }}
      >
        <div>
          <h2
            style={{
              color: "#ffffff",
              fontSize: 19,
              fontWeight: 700,
              margin: 0,
            }}
          >
            Commission Management
          </h2>

          <p
            style={{
              color: "#cbd5e1",
              fontSize: 11,
              margin: "5px 0 0",
            }}
          >
            Manage completed commission lots and invoices
          </p>
        </div>

        <button
          type="button"
          className="secondary-button"
          onClick={loadCommissionLots}
          disabled={commissionLoading}
          style={{
            background: "#ffffff",
            color: "#172554",
            border: "none",
            padding: "8px 14px",
            fontSize: 12,
            fontWeight: 600,
            opacity: commissionLoading ? 0.6 : 1,
          }}
        >
          {commissionLoading ? "Loading..." : "â†» Refresh"}
        </button>
      </div>

      {/* =================================
          SUMMARY CARDS
      ================================== */}
      <div
        style={{
          display: "grid",
          gridTemplateColumns:
            "repeat(auto-fit, minmax(170px, 1fr))",
          gap: 12,
          marginBottom: 16,
        }}
      >
        <div
          style={{
            ...summaryCard,
            borderTop: "3px solid #f97316",
          }}
        >
          <div
            style={{
              fontSize: 10,
              fontWeight: 700,
              color: "#64748b",
              textTransform: "uppercase",
            }}
          >
            Pending Lots
          </div>

          <div
            style={{
              fontSize: 24,
              fontWeight: 800,
              color: "#172554",
              marginTop: 7,
            }}
          >
            {commissionLots.length}
          </div>
        </div>

        <div
          style={{
            ...summaryCard,
            borderTop: "3px solid #2563eb",
          }}
        >
          <div
            style={{
              fontSize: 10,
              fontWeight: 700,
              color: "#64748b",
              textTransform: "uppercase",
            }}
          >
            Total Bags
          </div>

          <div
            style={{
              fontSize: 24,
              fontWeight: 800,
              color: "#172554",
              marginTop: 7,
            }}
          >
            {totalBags.toLocaleString()}
          </div>
        </div>

        <div
          style={{
            ...summaryCard,
            borderTop: "3px solid #16a34a",
          }}
        >
          <div
            style={{
              fontSize: 10,
              fontWeight: 700,
              color: "#64748b",
              textTransform: "uppercase",
            }}
          >
            Total Weight (KG)
          </div>

          <div
            style={{
              fontSize: 24,
              fontWeight: 800,
              color: "#172554",
              marginTop: 7,
            }}
          >
            {totalWeight.toLocaleString(undefined, {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2,
            })}
          </div>
        </div>
      </div>

      {/* =================================
          PENDING LOTS SECTION
      ================================== */}
      <div
        style={{
          background: "#ffffff",
          border: "1px solid #e2e8f0",
          borderRadius: 7,
          boxShadow: "0 1px 3px rgba(15,23,42,0.04)",
          overflow: "hidden",
        }}
      >
        <div
          style={{
            padding: "14px 16px",
            borderBottom: "1px solid #e2e8f0",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            flexWrap: "wrap",
            gap: 8,
          }}
        >
          <div>
            <h3
              style={{
                margin: 0,
                fontSize: 14,
                fontWeight: 700,
                color: "#172554",
              }}
            >
              Pending Commission Lots
            </h3>

            <p
              style={{
                margin: "4px 0 0",
                fontSize: 10,
                color: "#64748b",
              }}
            >
              Completed lots awaiting commission invoice
            </p>
          </div>

          <span
            style={{
              background: "#fff7ed",
              color: "#c2410c",
              border: "1px solid #fed7aa",
              borderRadius: 20,
              padding: "4px 10px",
              fontSize: 10,
              fontWeight: 700,
            }}
          >
            {commissionLots.length} LOTS
          </span>
        </div>

        {commissionError && (
          <div
            style={{
              margin: 12,
              padding: 11,
              background: "#fef2f2",
              border: "1px solid #fecaca",
              borderRadius: 5,
              color: "#b91c1c",
              fontSize: 12,
            }}
          >
            {commissionError}
          </div>
        )}

        {commissionLoading ? (
          <div
            style={{
              padding: 45,
              textAlign: "center",
              color: "#64748b",
              fontSize: 12,
            }}
          >
            Loading commission lots...
          </div>
        ) : commissionLots.length === 0 ? (
          <div
            style={{
              padding: "45px 15px",
              textAlign: "center",
            }}
          >
            <div
              style={{
                fontSize: 30,
                marginBottom: 10,
                color: "#94a3b8",
              }}
            >
              ðŸ“‹
            </div>

            <div
              style={{
                fontSize: 14,
                fontWeight: 700,
                color: "#334155",
              }}
            >
              No Pending Commission Lots
            </div>

            <p
              style={{
                fontSize: 11,
                color: "#94a3b8",
                marginTop: 5,
              }}
            >
              Completed commission lots will appear here.
            </p>
          </div>
        ) : (
          <div className="table-wrapper">
            <table
              style={{
                width: "100%",
                borderCollapse: "collapse",
                minWidth: 850,
              }}
            >
              <thead>
                <tr>
                  <th style={tableHeaderStyle}>LOT CODE</th>
                  <th style={tableHeaderStyle}>PURCHASE DATE</th>
                  <th style={tableHeaderStyle}>PRODUCT</th>
                  <th style={tableHeaderStyle}>SUPPLIER</th>
                  <th
                    style={{
                      ...tableHeaderStyle,
                      textAlign: "right",
                    }}
                  >
                    BAGS
                  </th>
                  <th
                    style={{
                      ...tableHeaderStyle,
                      textAlign: "right",
                    }}
                  >
                    WEIGHT (KG)
                  </th>
                  <th
                    style={{
                      ...tableHeaderStyle,
                      textAlign: "center",
                    }}
                  >
                    ACTION
                  </th>
                </tr>
              </thead>

              <tbody>
                {commissionLots.map((lot) => (
                  <tr key={lot._id}>
                    <td
                      style={{
                        ...tableCellStyle,
                        fontWeight: 700,
                        color: "#172554",
                      }}
                    >
                      {lot.lotCode || "-"}
                    </td>

                    <td style={tableCellStyle}>
                      {lot.purchaseDate
                        ? new Date(
                            lot.purchaseDate
                          ).toLocaleDateString()
                        : "-"}
                    </td>

                    <td style={tableCellStyle}>
                      {lot.productId?.productName ||
                        lot.productName ||
                        "-"}
                    </td>

                    <td style={tableCellStyle}>
                      {lot.supplierId?.supplierName ||
                        lot.supplierName ||
                        "-"}
                    </td>

                    <td
                      style={{
                        ...tableCellStyle,
                        textAlign: "right",
                        fontWeight: 600,
                      }}
                    >
                      {Number(
                        lot.remainingBags || 0
                      ).toLocaleString()}
                    </td>

                    <td
                      style={{
                        ...tableCellStyle,
                        textAlign: "right",
                        fontWeight: 600,
                      }}
                    >
                      {Number(
                        lot.remainingWeightKg || 0
                      ).toFixed(2)}
                    </td>

                    <td
                      style={{
                        ...tableCellStyle,
                        textAlign: "center",
                      }}
                    >
                      <button
                        type="button"
                        className="primary-button"
                        onClick={() =>
                          setSelectedCommissionLot(lot)
                        }
                        style={{
                          padding: "6px 11px",
                          fontSize: 11,
                          whiteSpace: "nowrap",
                        }}
                      >
                        Create Invoice
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}

function renderCommissionHistory() {
  const summaryCard = {
    background: "#ffffff",
    border: "1px solid #e2e8f0",
    borderRadius: 7,
    padding: 16,
    boxShadow: "0 1px 3px rgba(15,23,42,0.04)",
  };

  const tableHeaderStyle = {
    padding: "11px 12px",
    background: "#f1f5f9",
    color: "#475569",
    fontSize: 10,
    fontWeight: 700,
    textAlign: "left",
    whiteSpace: "nowrap",
    borderBottom: "1px solid #e2e8f0",
  };

  const tableCellStyle = {
    padding: "11px 12px",
    fontSize: 12,
    color: "#334155",
    borderBottom: "1px solid #e2e8f0",
    whiteSpace: "nowrap",
  };

  const completedInvoices = commissionInvoices.filter(
    (invoice) => invoice.status === "COMPLETED"
  );

  const cancelledInvoices = commissionInvoices.filter(
    (invoice) => invoice.status === "CANCELLED"
  );

  const totalBags = completedInvoices.reduce(
    (sum, invoice) => sum + Number(invoice.totalBags || 0),
    0
  );

  const totalNetPayable = completedInvoices.reduce(
    (sum, invoice) => sum + Number(invoice.netSupplierPayable || 0),
    0
  );

  return (
    <div
      className="panel"
      style={{
        padding: 16,
        background: "#f8fafc",
        minHeight: "100%",
      }}
    >
      {/* PAGE HEADER */}
      <div
        style={{
          background: "#172554",
          borderRadius: 7,
          padding: "17px 20px",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          flexWrap: "wrap",
          gap: 12,
          marginBottom: 16,
        }}
      >
        <div>
          <h2
            style={{
              color: "#ffffff",
              fontSize: 19,
              fontWeight: 700,
              margin: 0,
            }}
          >
            Commission Invoice History
          </h2>

          <p
            style={{
              color: "#cbd5e1",
              fontSize: 11,
              margin: "5px 0 0",
            }}
          >
            View, edit and manage completed commission invoices
          </p>
        </div>

        <button
          type="button"
          className="secondary-button"
          onClick={loadCommissionInvoices}
          disabled={commissionHistoryLoading}
          style={{
            background: "#ffffff",
            color: "#172554",
            border: "none",
            padding: "8px 14px",
            fontSize: 12,
            fontWeight: 600,
            opacity: commissionHistoryLoading ? 0.6 : 1,
          }}
        >
          {commissionHistoryLoading ? "Loading..." : "â†» Refresh"}
        </button>
      </div>

      {/* SUMMARY CARDS */}


      
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(170px, 1fr))",
          gap: 12,
          marginBottom: 16,
        }}
      >
        {[
          {
            label: "Total Invoices",
            value: commissionInvoices.length,
            color: "#2563eb",
          },
          {
            label: "Completed Invoices",
            value: completedInvoices.length,
            color: "#16a34a",
          },
          {
            label: "Cancelled Invoices",
            value: cancelledInvoices.length,
            color: "#dc2626",
          },
          {
            label: "Total Bags",
            value: totalBags.toLocaleString(),
            color: "#f97316",
          },
          {
            label: "Net Supplier Payable",
            value: totalNetPayable.toLocaleString(undefined, {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2,
            }),
            color: "#0d9488",
          },
        ].map((card) => (
          <div
            key={card.label}
            style={{
              ...summaryCard,
              borderTop: `3px solid ${card.color}`,
            }}
          >
            <div
              style={{
                fontSize: 10,
                fontWeight: 700,
                color: "#64748b",
                textTransform: "uppercase",
              }}
            >
              {card.label}
            </div>

            <div
              style={{
                fontSize: 23,
                fontWeight: 800,
                color: "#172554",
                marginTop: 7,
                overflowWrap: "anywhere",
              }}
            >
              {card.value}
            </div>
          </div>
        ))}
      </div>

      {/* EDIT INVOICE FORM */}
      {editingCommissionInvoice && (
        <div
          style={{
            background: "#ffffff",
            border: "1px solid #e2e8f0",
            borderRadius: 7,
            marginBottom: 16,
            boxShadow: "0 1px 3px rgba(15,23,42,0.04)",
            overflow: "hidden",
          }}
        >
          <div
            style={{
              background: "#172554",
              padding: "14px 16px",
            }}
          >
            <h3
              style={{
                color: "#ffffff",
                fontSize: 15,
                margin: 0,
                fontWeight: 700,
              }}
            >
              Edit Commission Invoice
            </h3>

            <p
              style={{
                color: "#cbd5e1",
                fontSize: 11,
                margin: "5px 0 0",
              }}
            >
              Invoice: {editingCommissionInvoice.invoiceNumber}
            </p>
          </div>

          <div style={{ padding: 16 }}>
            <div style={{ marginBottom: 15 }}>
              <label
                style={{
                  display: "block",
                  fontSize: 11,
                  color: "#475569",
                  fontWeight: 600,
                  marginBottom: 5,
                }}
              >
                Edit Reason *
              </label>

              <textarea
                value={commissionEditReason}
                onChange={(e) => setCommissionEditReason(e.target.value)}
                placeholder="Enter reason for editing"
                rows={2}
                style={{
                  width: "100%",
                  padding: 10,
                  border: "1px solid #cbd5e1",
                  borderRadius: 5,
                  fontSize: 12,
                  boxSizing: "border-box",
                  resize: "vertical",
                }}
              />
            </div>

            <h4
              style={{
                color: "#172554",
                fontSize: 13,
                fontWeight: 700,
                margin: "0 0 10px",
              }}
            >
              Invoice Items
            </h4>

            <div style={{ overflowX: "auto", marginBottom: 16 }}>
              <table
                style={{
                  width: "100%",
                  minWidth: 550,
                  borderCollapse: "collapse",
                }}
              >
                <thead>
                  <tr>
                    {["SL", "BAGS", "WEIGHT (KG)", "RATE / KG", "AMOUNT"].map(
                      (heading) => (
                        <th key={heading} style={tableHeaderStyle}>
                          {heading}
                        </th>
                      )
                    )}
                  </tr>
                </thead>

                <tbody>
                  {commissionItems.map((item, index) => (
                    <tr key={index}>
                      <td style={tableCellStyle}>{index + 1}</td>

                      {["bags", "weightKg", "ratePerKg"].map((field) => (
                        <td key={field} style={{ padding: 6 }}>
                          <input
                            type="number"
                            min="0"
                            step="any"
                            value={item[field]}
                            onChange={(e) =>
                              setCommissionItems((prev) =>
                                prev.map((row, i) =>
                                  i === index
                                    ? { ...row, [field]: e.target.value }
                                    : row
                                )
                              )
                            }
                            style={{
                              width: "100%",
                              minWidth: 85,
                              padding: 8,
                              border: "1px solid #cbd5e1",
                              borderRadius: 5,
                              fontSize: 12,
                              boxSizing: "border-box",
                            }}
                          />
                        </td>
                      ))}

                      <td
                        style={{
                          ...tableCellStyle,
                          fontWeight: 700,
                          color: "#172554",
                        }}
                      >
                        {(
                          Number(item.weightKg || 0) *
                          Number(item.ratePerKg || 0)
                        ).toFixed(2)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <h4
              style={{
                color: "#172554",
                fontSize: 13,
                fontWeight: 700,
                margin: "0 0 12px",
              }}
            >
              Other Charges & Deductions
            </h4>

            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit,minmax(170px,1fr))",
                gap: 12,
              }}
            >
              {[
                ["Transport Cost", commissionTransportCost, setCommissionTransportCost],
                ["Labour Rate / Bag", commissionLabourRate, setCommissionLabourRate],
                ["Commission Rate / KG", commissionRatePerKg, setCommissionRatePerKg],
                ["Other Cost", commissionOtherCost, setCommissionOtherCost],
              ].map(([label, value, setter]) => (
                <div key={label}>
                  <label
                    style={{
                      display: "block",
                      fontSize: 11,
                      color: "#475569",
                      fontWeight: 600,
                      marginBottom: 5,
                    }}
                  >
                    {label}
                  </label>

                  <input
                    type="number"
                    min="0"
                    step="any"
                    value={value}
                    onChange={(e) => setter(e.target.value)}
                    style={{
                      width: "100%",
                      padding: "9px 10px",
                      border: "1px solid #cbd5e1",
                      borderRadius: 5,
                      fontSize: 12,
                      boxSizing: "border-box",
                    }}
                  />
                </div>
              ))}
            </div>

            <div style={{ marginTop: 14 }}>
              <label
                style={{
                  display: "block",
                  fontSize: 11,
                  color: "#475569",
                  fontWeight: 600,
                  marginBottom: 5,
                }}
              >
                Notes
              </label>

              <textarea
                value={commissionNotes}
                onChange={(e) => setCommissionNotes(e.target.value)}
                rows={2}
                style={{
                  width: "100%",
                  padding: 10,
                  border: "1px solid #cbd5e1",
                  borderRadius: 5,
                  fontSize: 12,
                  boxSizing: "border-box",
                  resize: "vertical",
                }}
              />
            </div>

            <div
              style={{
                display: "flex",
                justifyContent: "flex-end",
                gap: 10,
                flexWrap: "wrap",
                marginTop: 16,
              }}
            >
              <button
                type="button"
                className="secondary-button"
                onClick={() => {
                  setEditingCommissionInvoice(null);
                  setCommissionEditReason("");
                }}
                disabled={commissionEditSaving}
                style={{ padding: "9px 16px" }}
              >
                Close
              </button>

              <button
                type="button"
                className="primary-button"
                onClick={updateCommissionInvoice}
                disabled={commissionEditSaving || !commissionEditReason.trim()}
                style={{ padding: "9px 16px" }}
              >
                {commissionEditSaving ? "Updating..." : "Update Invoice"}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* HISTORY TABLE */}
      <div
        style={{
          background: "#ffffff",
          border: "1px solid #e2e8f0",
          borderRadius: 7,
          boxShadow: "0 1px 3px rgba(15,23,42,0.04)",
          overflow: "hidden",
        }}
      >
        <div
          style={{
            padding: "14px 16px",
            borderBottom: "1px solid #e2e8f0",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            flexWrap: "wrap",
            gap: 8,
          }}
        >
          <div>
            <h3
              style={{
                margin: 0,
                fontSize: 14,
                fontWeight: 700,
                color: "#172554",
              }}
            >
              All Commission Invoices
            </h3>

            <p
              style={{
                margin: "4px 0 0",
                fontSize: 10,
                color: "#64748b",
              }}
            >
              Complete invoice records and transaction status
            </p>
          </div>

          <span
            style={{
              background: "#eff6ff",
              color: "#1d4ed8",
              border: "1px solid #bfdbfe",
              borderRadius: 20,
              padding: "4px 10px",
              fontSize: 10,
              fontWeight: 700,
            }}
          >
            {commissionInvoices.length} INVOICES
          </span>
        </div>

        {commissionHistoryError && (
          <div
            style={{
              margin: 12,
              padding: 11,
              background: "#fef2f2",
              border: "1px solid #fecaca",
              borderRadius: 5,
              color: "#b91c1c",
              fontSize: 12,
            }}
          >
            {commissionHistoryError}
          </div>
        )}

        {commissionHistoryLoading ? (
          <div
            style={{
              padding: 45,
              textAlign: "center",
              color: "#64748b",
              fontSize: 12,
            }}
          >
            Loading commission invoices...
          </div>
        ) : commissionInvoices.length === 0 ? (
          <div style={{ padding: "45px 15px", textAlign: "center" }}>
            <div style={{ fontSize: 30, marginBottom: 10 }}>ðŸ“‹</div>

            <div
              style={{
                fontSize: 14,
                fontWeight: 700,
                color: "#334155",
              }}
            >
              No Commission Invoices Found
            </div>

            <p
              style={{
                fontSize: 11,
                color: "#94a3b8",
                marginTop: 5,
              }}
            >
              Completed commission invoices will appear here.
            </p>
          </div>
        ) : (
          <div className="table-wrapper">
            <table
              style={{
                width: "100%",
                borderCollapse: "collapse",
                minWidth: 1100,
              }}
            >
              <thead>
                <tr>
                  <th style={tableHeaderStyle}>INVOICE DATE</th>
                  <th style={tableHeaderStyle}>INVOICE NUMBER</th>
                  <th style={tableHeaderStyle}>SUPPLIER</th>
                  <th style={tableHeaderStyle}>LOT</th>
                  <th style={{ ...tableHeaderStyle, textAlign: "right" }}>
                    BAGS
                  </th>
                  <th style={{ ...tableHeaderStyle, textAlign: "right" }}>
                    GROSS
                  </th>
                  <th style={{ ...tableHeaderStyle, textAlign: "right" }}>
                    DEDUCTION
                  </th>
                  <th style={{ ...tableHeaderStyle, textAlign: "right" }}>
                    NET PAYABLE
                  </th>
                  <th style={tableHeaderStyle}>STATUS</th>
                  <th style={{ ...tableHeaderStyle, textAlign: "center" }}>
                    ACTION
                  </th>
                </tr>
              </thead>

              <tbody>
                {commissionInvoices.map((invoice) => (
                  <tr key={invoice._id}>
                    <td style={tableCellStyle}>
                      {invoice.invoiceDate
                        ? new Date(invoice.invoiceDate).toLocaleDateString()
                        : "-"}
                    </td>

                    <td
                      style={{
                        ...tableCellStyle,
                        fontWeight: 700,
                        color: "#172554",
                      }}
                    >
                      {invoice.invoiceNumber || "-"}
                    </td>

                    <td style={tableCellStyle}>
                      {invoice.supplierName || invoice.supplierId?.name || "-"}
                    </td>

                    <td style={tableCellStyle}>
                      {invoice.lotCode || "-"}
                    </td>

                    <td style={{ ...tableCellStyle, textAlign: "right" }}>
                      {Number(invoice.totalBags || 0).toLocaleString()}
                    </td>

                    <td style={{ ...tableCellStyle, textAlign: "right" }}>
                      {Number(invoice.grossAmount || 0).toFixed(2)}
                    </td>

                    <td style={{ ...tableCellStyle, textAlign: "right" }}>
                      {Number(invoice.totalDeduction || 0).toFixed(2)}
                    </td>

                    <td
                      style={{
                        ...tableCellStyle,
                        textAlign: "right",
                        fontWeight: 700,
                        color: "#172554",
                      }}
                    >
                      {Number(invoice.netSupplierPayable || 0).toFixed(2)}
                    </td>

                    <td style={tableCellStyle}>
                      <span
                        style={{
                          display: "inline-block",
                          padding: "4px 9px",
                          borderRadius: 20,
                          fontSize: 10,
                          fontWeight: 700,
                          background:
                            invoice.status === "COMPLETED"
                              ? "#f0fdf4"
                              : "#fef2f2",
                          color:
                            invoice.status === "COMPLETED"
                              ? "#15803d"
                              : "#dc2626",
                          border:
                            invoice.status === "COMPLETED"
                              ? "1px solid #bbf7d0"
                              : "1px solid #fecaca",
                        }}
                      >
                        {invoice.status || "-"}
                      </span>
                    </td>

                    <td style={{ ...tableCellStyle, textAlign: "center" }}>
                      {invoice.status === "COMPLETED" ? (
                        <div
                          style={{
                            display: "flex",
                            justifyContent: "center",
                            gap: 6,
                          }}
                        >
                          <button
                            type="button"
                            className="secondary-button"
                            onClick={() => openCommissionInvoiceEdit(invoice)}
                            style={{ padding: "5px 9px", fontSize: 11 }}
                          >
                            Edit
                          </button>

                          <button
                            type="button"
                            className="danger-button"
                            onClick={() => cancelCommissionInvoice(invoice._id)}
                            style={{ padding: "5px 9px", fontSize: 11 }}
                          >
                            Cancel
                          </button>
                        </div>
                      ) : (
                        <span style={{ color: "#94a3b8", fontSize: 11 }}>
                          No Action
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}




function renderCommissionReports() {
  const summary = commissionReports?.summary || {};

  const reportCards = [
    ["Completed Invoices", summary.completedInvoices || 0, "#2563eb"],
    ["Cancelled Invoices", summary.cancelledInvoices || 0, "#dc2626"],
    ["Total Bags", summary.totalBags || 0, "#0891b2"],
    ["Total Weight (KG)", summary.totalWeightKg || 0, "#7c3aed"],
    ["Gross Amount", summary.grossAmount || 0, "#16a34a"],
    ["Pocket Lot Profit", summary.pocketLotProfit || 0, "#16a34a"],
    ["Transport Cost", summary.transportCost || 0, "#d97706"],
    ["Labour Cost", summary.labourCost || 0, "#0d9488"],
    ["Commission Cost", summary.commissionCost || 0, "#6366f1"],
    ["Other Cost", summary.otherCost || 0, "#64748b"],
    ["Total Deduction", summary.totalDeduction || 0, "#ea580c"],
    ["Net Supplier Payable", summary.netSupplierPayable || 0, "#15803d"],
  ];

  const formatNumber = (value) =>
    Number(value || 0).toLocaleString("en-BD", {
      maximumFractionDigits: 2,
    });

  return (
    <div
      className="panel"
      style={{
        padding: 16,
        background: "#f8fafc",
        minHeight: "100%",
      }}
    >
      {/* HEADER */}
      <div
        style={{
          background: "#172554",
          borderRadius: 7,
          padding: "17px 20px",
          marginBottom: 16,
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          flexWrap: "wrap",
          gap: 12,
        }}
      >
        <div>
          <h2
            style={{
              margin: 0,
              color: "#ffffff",
              fontSize: 19,
              fontWeight: 700,
            }}
          >
            Commission Reports
          </h2>

          <p
            style={{
              margin: "5px 0 0",
              color: "#cbd5e1",
              fontSize: 11,
            }}
          >
            Commission invoice summary and financial reports
          </p>
        </div>

        <button
          type="button"
          onClick={loadCommissionReports}
          disabled={commissionReportsLoading}
          style={{
            background: "#ffffff",
            color: "#172554",
            border: "none",
            borderRadius: 5,
            padding: "9px 15px",
            fontSize: 12,
            fontWeight: 700,
            cursor: commissionReportsLoading ? "not-allowed" : "pointer",
            opacity: commissionReportsLoading ? 0.7 : 1,
          }}
        >
          {commissionReportsLoading ? "Loading..." : "â†» Refresh Reports"}
        </button>
      </div>

      {commissionReportsLoading ? (
        <div
          style={{
            background: "#ffffff",
            border: "1px solid #e2e8f0",
            borderRadius: 7,
            padding: 30,
            textAlign: "center",
            color: "#64748b",
            fontSize: 13,
          }}
        >
          Loading commission reports...
        </div>
      ) : (
        <>
      
  {/* COMMISSION REPORT FILTERS */}
  <div
    style={{
      background: "#ffffff",
      border: "1px solid #e2e8f0",
      borderRadius: 7,
      padding: 16,
      marginBottom: 18,
    }}
  >
    <h3
      style={{
        margin: "0 0 14px",
        fontSize: 14,
        color: "#172554",
        fontWeight: 700,
      }}
    >
      Filter Commission Reports
    </h3>

    <div
      style={{
        display: "grid",
        gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
        gap: 12,
        alignItems: "end",
      }}
    >
      <div>
        <label style={{ display: "block", fontSize: 11, marginBottom: 6 }}>
          Start Date
        </label>
        <input
          type="date"
          value={commissionReportFilters.startDate}
          onChange={(e) =>
            setCommissionReportFilters((prev) => ({
              ...prev,
              startDate: e.target.value,
            }))
          }
          style={{ width: "100%", padding: 9, border: "1px solid #cbd5e1", borderRadius: 5 }}
        />
      </div>

      <div>
        <label style={{ display: "block", fontSize: 11, marginBottom: 6 }}>
          End Date
        </label>
        <input
          type="date"
          value={commissionReportFilters.endDate}
          onChange={(e) =>
            setCommissionReportFilters((prev) => ({
              ...prev,
              endDate: e.target.value,
            }))
          }
          style={{ width: "100%", padding: 9, border: "1px solid #cbd5e1", borderRadius: 5 }}
        />
      </div>

<div style={{ position: "relative" }}>
  <label style={{ display: "block", fontSize: 11, marginBottom: 6 }}>
    Supplier
  </label>

  <input
    type="text"
    value={commissionSupplierSearch}
    placeholder="Search Supplier..."
    onFocus={() => setShowCommissionSupplierSuggestions(true)}
    onChange={(e) => {
      setCommissionSupplierSearch(e.target.value);
      setShowCommissionSupplierSuggestions(true);

      setCommissionReportFilters((prev) => ({
        ...prev,
        supplierId: "",
      }));
    }}
    style={{
      width: "100%",
      padding: 9,
      border: "1px solid #cbd5e1",
      borderRadius: 5,
      boxSizing: "border-box",
    }}
  />

  {showCommissionSupplierSuggestions && (
    <div
      style={{
        position: "absolute",
        top: "100%",
        left: 0,
        right: 0,
        background: "#ffffff",
        border: "1px solid #cbd5e1",
        borderRadius: 5,
        maxHeight: 180,
        overflowY: "auto",
        zIndex: 100,
      }}
    >
      <div
        onClick={() => {
          setCommissionReportFilters((prev) => ({
            ...prev,
            supplierId: "",
          }));
          setCommissionSupplierSearch("");
          setShowCommissionSupplierSuggestions(false);
        }}
        style={{ padding: 9, cursor: "pointer", fontSize: 12 }}
      >
        All Suppliers
      </div>

      {(commissionReports?.supplierOptions || [])
        .filter((supplier) =>
          (supplier.supplierName || "")
            .toLowerCase()
            .includes(commissionSupplierSearch.toLowerCase())
        )
        .map((supplier) => (
          <div
            key={supplier._id}
            onClick={() => {
              setCommissionReportFilters((prev) => ({
                ...prev,
                supplierId: supplier._id,
              }));
              setCommissionSupplierSearch(supplier.supplierName);
              setShowCommissionSupplierSuggestions(false);
            }}
            style={{
              padding: 9,
              cursor: "pointer",
              fontSize: 12,
              borderTop: "1px solid #f1f5f9",
            }}
          >
            {supplier.supplierName}
          </div>
        ))}
    </div>
  )}
</div>

    <div style={{ position: "relative" }}>
  <label style={{ display: "block", fontSize: 11, marginBottom: 6 }}>
    Lot
  </label>

  <input
    type="text"
    value={commissionLotSearch}
    placeholder="Search Lot..."
    onFocus={() => setShowCommissionLotSuggestions(true)}
    onChange={(e) => {
      setCommissionLotSearch(e.target.value);
      setShowCommissionLotSuggestions(true);

      setCommissionReportFilters((prev) => ({
        ...prev,
        lotId: "",
      }));
    }}
    style={{
      width: "100%",
      padding: 9,
      border: "1px solid #cbd5e1",
      borderRadius: 5,
      boxSizing: "border-box",
    }}
  />

  {showCommissionLotSuggestions && (
    <div
      style={{
        position: "absolute",
        top: "100%",
        left: 0,
        right: 0,
        background: "#ffffff",
        border: "1px solid #cbd5e1",
        borderRadius: 5,
        maxHeight: 180,
        overflowY: "auto",
        zIndex: 100,
      }}
    >
      <div
        onClick={() => {
          setCommissionReportFilters((prev) => ({
            ...prev,
            lotId: "",
          }));
          setCommissionLotSearch("");
          setShowCommissionLotSuggestions(false);
        }}
        style={{ padding: 9, cursor: "pointer", fontSize: 12 }}
      >
        All Lots
      </div>

      {(commissionReports?.lotOptions || [])
        .filter((lot) =>
          (lot.lotCode || "")
            .toLowerCase()
            .includes(commissionLotSearch.toLowerCase())
        )
        .map((lot) => (
          <div
            key={lot._id}
            onClick={() => {
              setCommissionReportFilters((prev) => ({
                ...prev,
                lotId: lot._id,
              }));
              setCommissionLotSearch(lot.lotCode);
              setShowCommissionLotSuggestions(false);
            }}
            style={{
              padding: 9,
              cursor: "pointer",
              fontSize: 12,
              borderTop: "1px solid #f1f5f9",
            }}
          >
            {lot.lotCode}
          </div>
        ))}
    </div>
  )}
</div>
      <button
        type="button"
        onClick={loadCommissionReports}
        disabled={commissionReportsLoading}
        style={{
          padding: 10,
          background: "#172554",
          color: "#ffffff",
          border: "none",
          borderRadius: 5,
          fontWeight: 700,
          cursor: "pointer",
        }}
      >
        Apply Filters
      </button>

      <button
  type="button"
  onClick={() => {
    resetCommissionReportFilters();
    setTimeout(() => loadCommissionReports(), 0);
  }}
  style={{
    padding: 10,
    background: "#64748b",
    color: "#ffffff",
    border: "none",
    borderRadius: 5,
    fontWeight: 700,
    cursor: "pointer",
  }}
>
  â†» Reset Filters
</button>
    </div>
  </div>

  {/* SUMMARY CARDS */}


          <div
            style={{
              display: "grid",
              gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
              gap: 12,
              marginBottom: 18,
            }}
          >
            {reportCards.map(([label, value, color]) => (
              <div
                key={label}
                style={{
                  background: "#ffffff",
                  border: "1px solid #e2e8f0",
                  borderTop: `3px solid ${color}`,
                  borderRadius: 7,
                  padding: 16,

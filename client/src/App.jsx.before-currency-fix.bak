            {summaryCards.map((card) => (
              <div
                key={card.title}
                className="stat-card"
                style={{ padding: 18 }}
              >
                <div style={{ fontSize: 13, color: "#64748b" }}>
                  {card.title}
                </div>

                <h3 style={{ margin: "12px 0", fontSize: 23 }}>
                  {card.value}

            flexWrap: "wrap",
            marginTop: 16,
            paddingTop: 14,
            borderTop: "1px solid #e2e8f0",
          }}
        >
          <div style={{ fontSize: 12, color: "#64748b" }}>
            Page {currentPage} of {totalPages}
          </div>

          <div style={{ display: "flex", gap: 8 }}>
            <button
              type="button"
              disabled={currentPage <= 1 || expenseHistoryLoading}
              onClick={() => loadExpenseHistory(currentPage - 1)}
              style={{
                padding: "8px 14px",
                border: "1px solid #cbd5e1",
                borderRadius: 7,
                background: "#fff",
                color: "#475569",
                fontWeight: 700,
                cursor: "pointer",
                opacity: currentPage <= 1 ? 0.4 : 1,
              }}
            >
              Previous
            </button>

            <button
              type="button"
              disabled={currentPage >= totalPages || expenseHistoryLoading}
              onClick={() => loadExpenseHistory(currentPage + 1)}
              style={{
                padding: "8px 14px",
                border: "1px solid #0f766e",
                borderRadius: 7,
                background: "#0f766e",
                color: "#fff",
                fontWeight: 700,
                cursor: "pointer",
                opacity: currentPage >= totalPages ? 0.4 : 1,
              }}
            >
              Next
            </button>
          </div>
        </div>
      </div>

      {/* ===================================== */}
      {/* EDIT EXPENSE MODAL */}
      {/* ===================================== */}

      {expenseEditModalOpen && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            background: "rgba(15,23,42,.65)",
            zIndex: 9999,
            display: "flex",
            justifyContent: "center",
            alignItems: "center",
            padding: 12,
            overflowY: "auto",
          }}
        >
          <div
            style={{
              width: "100%",
              maxWidth: 650,
              maxHeight: "92vh",
              overflowY: "auto",
              background: "#fff",
              borderRadius: 12,
              boxShadow: "0 15px 40px rgba(0,0,0,.25)",
            }}
          >
            <div
              style={{
                background: "#172554",
                color: "#fff",
                padding: "17px 20px",
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
                gap: 10,
              }}
            >
              <div>
                <h3 style={{ margin: 0, fontSize: 18, fontWeight: 800 }}>
                  Edit Expense
                </h3>
                <p style={{ margin: "4px 0 0", fontSize: 12, color: "#cbd5e1" }}>
                  Correct expense information
                </p>
              </div>

              <button
                type="button"
                disabled={expenseEditLoading}
                onClick={() => setExpenseEditModalOpen(false)}
                style={{
                  background: "transparent",
                  border: "none",
                  color: "#fff",
                  fontSize: 25,
                  cursor: "pointer",
                }}
              >
                Ã—
              </button>
            </div>

            <div style={{ padding: 20 }}>
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))",
                  gap: 14,
                }}
              >
                <div>
                  <label style={labelStyle}>Expense Date *</label>
                  <input
                    type="date"
                    value={expenseEditFormData.expenseDate}
                    onChange={(e) =>
                      handleExpenseEditChange("expenseDate", e.target.value)
                    }
                    style={inputStyleExpense}
                  />
                </div>

                <div>
                  <label style={labelStyle}>Expense Category *</label>
                  <select
                    value={expenseEditFormData.categoryId}
                    onChange={(e) =>
                      handleExpenseEditChange("categoryId", e.target.value)
                    }
                    style={inputStyleExpense}
                  >
                    <option value="">Select Category</option>
                    {activeCategories.map((category) => (
                      <option key={category._id} value={category._id}>
                        {category.name}
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label style={labelStyle}>Account *</label>
                  <select
                    value={expenseEditFormData.accountId}
                    onChange={(e) =>
                      handleExpenseEditChange("accountId", e.target.value)
                    }
                    style={inputStyleExpense}
                  >
                    <option value="">Select Account</option>
                    {activeAccounts.map((account) => (
                      <option key={account._id} value={account._id}>
                        {account.accountName} ({account.accountType})
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label style={labelStyle}>Amount (à§³) *</label>
                  <input
                    type="number"
                    min="0.01"
                    step="0.01"
                    value={expenseEditFormData.amount}
                    onChange={(e) =>
                      handleExpenseEditChange("amount", e.target.value)
                    }
                    placeholder="Enter amount"
                    style={inputStyleExpense}
                  />
                </div>

                <div>
                  <label style={labelStyle}>Voucher Number</label>
                  <input
                    type="text"
                    value={expenseEditFormData.voucherNumber}
                    onChange={(e) =>
                      handleExpenseEditChange("voucherNumber", e.target.value)
                    }
                    placeholder="Voucher number"
                    style={inputStyleExpense}
                  />
                </div>

                <div>
                  <label style={labelStyle}>Reference</label>
                  <input
                    type="text"
                    value={expenseEditFormData.reference}
                    onChange={(e) =>
                      handleExpenseEditChange("reference", e.target.value)
                    }
                    placeholder="Reference"
                    style={inputStyleExpense}
                  />
                </div>

                <div style={{ gridColumn: "1 / -1" }}>
                  <label style={labelStyle}>Description</label>
                  <textarea
                    rows={3}
                    value={expenseEditFormData.description}
                    onChange={(e) =>
                      handleExpenseEditChange("description", e.target.value)
                    }
                    placeholder="Expense description"
                    style={{
                      ...inputStyleExpense,
                      resize: "vertical",
                    }}
                  />
                </div>

                <div style={{ gridColumn: "1 / -1" }}>
                  <label style={{ ...labelStyle, color: "#dc2626" }}>
                    Correction Reason *
                  </label>
                  <textarea
                    rows={3}
                    value={expenseEditFormData.reason}
                    onChange={(e) =>
                      handleExpenseEditChange("reason", e.target.value)
                    }
                    placeholder="Why are you correcting this expense?"
                    style={{
                      ...inputStyleExpense,
                      resize: "vertical",
                      borderColor: "#fca5a5",
                    }}
                  />
                  <p style={{ fontSize: 11, color: "#64748b", marginTop: 5 }}>
                    Correction reason will be saved permanently in the history.
                  </p>
                </div>
              </div>

              <div
                style={{
                  display: "flex",
                  justifyContent: "flex-end",
                  gap: 9,
                  flexWrap: "wrap",
                  marginTop: 20,
                  paddingTop: 15,
                  borderTop: "1px solid #e2e8f0",
                }}
              >
                <button
                  type="button"
                  disabled={expenseEditLoading}
                  onClick={() => setExpenseEditModalOpen(false)}
                  style={{
                    padding: "10px 17px",
                    background: "#fff",
                    color: "#475569",
                    border: "1px solid #cbd5e1",
                    borderRadius: 7,
                    fontWeight: 700,
                    cursor: "pointer",
                  }}
                >
                  Cancel
                </button>

                <button
                  type="button"
                  disabled={expenseEditLoading}
                  onClick={saveExpenseEdit}
                  style={{
                    padding: "10px 20px",
                    background: "#0f766e",
                    color: "#fff",
                    border: "none",
                    borderRadius: 7,
                    fontWeight: 800,
                    cursor: expenseEditLoading ? "not-allowed" : "pointer",
                    opacity: expenseEditLoading ? 0.6 : 1,
                  }}
                >
                  {expenseEditLoading ? "Updating..." : "Save Correction"}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ===================================== */}
      {/* CORRECTION HISTORY MODAL */}
      {/* ===================================== */}

      {expenseCorrectionModalOpen && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            background: "rgba(15,23,42,.65)",
            zIndex: 10000,
            display: "flex",
            justifyContent: "center",
            alignItems: "center",
            padding: 12,
            overflowY: "auto",
          }}
        >
          <div
            style={{
              width: "100%",
              maxWidth: 750,
              maxHeight: "92vh",
              overflowY: "auto",
              background: "#fff",
              borderRadius: 12,
              boxShadow: "0 15px 40px rgba(0,0,0,.25)",
            }}
          >
            <div
              style={{
                background: "#172554",
                color: "#fff",
                padding: "17px 20px",
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
                gap: 10,
              }}
            >
              <div>
                <h3 style={{ margin: 0, fontSize: 18, fontWeight: 800 }}>
                  Expense Correction History
                </h3>
                <p style={{ margin: "4px 0 0", fontSize: 12, color: "#cbd5e1" }}>
                  Complete expense modification records
                </p>
              </div>

              <button
                type="button"
                onClick={() => {
                  setExpenseCorrectionModalOpen(false);
                  setExpenseCorrectionData(null);
                }}
                style={{
                  background: "transparent",
                  border: "none",
                  color: "#fff",
                  fontSize: 25,
                  cursor: "pointer",
                }}
              >
                Ã—
              </button>
            </div>

            <div style={{ padding: 20 }}>
              {expenseCorrectionLoading ? (
                <div
                  style={{
                    padding: 35,
                    textAlign: "center",
                    color: "#64748b",
                  }}
                >
                  Loading correction history...
                </div>
              ) : !expenseCorrectionData ? (
                <div
                  style={{
                    padding: 25,
                    textAlign: "center",
                    color: "#64748b",
                  }}
                >
                  No history data available.
                </div>
              ) : (
                <>
                  {/* CURRENT EXPENSE SUMMARY */}
                  <div
                    style={{
                      background: "#f8fafc",
                      border: "1px solid #e2e8f0",
                      borderRadius: 9,
                      padding: 15,
                      marginBottom: 18,
                    }}
                  >
                    <div
                      style={{
                        display: "flex",
                        justifyContent: "space-between",
                        gap: 10,
                        flexWrap: "wrap",
                      }}
                    >
                      <strong style={{ color: "#172554" }}>
                        Current Expense
                      </strong>

                      <span
                        style={{
                          background: "#ccfbf1",
                          color: "#0f766e",
                          padding: "4px 9px",
                          borderRadius: 20,
                          fontSize: 11,
                          fontWeight: 800,
                        }}
                      >
                        {expenseCorrectionData.totalCorrections || 0} Corrections
                      </span>
                    </div>

                    <div
                      style={{
                        display: "grid",
                        gridTemplateColumns: "repeat(auto-fit, minmax(140px, 1fr))",
                        gap: 12,
                        marginTop: 13,
                      }}
                    >
                      <div>
                        <div style={{ fontSize: 11, color: "#64748b" }}>
                          Voucher
                        </div>
                        <strong style={{ fontSize: 13 }}>
                          {expenseCorrectionData.expense?.voucherNumber || "-"}
                        </strong>
                      </div>

                      <div>
                        <div style={{ fontSize: 11, color: "#64748b" }}>
                          Category
                        </div>
                        <strong style={{ fontSize: 13 }}>
                          {expenseCorrectionData.expense?.categoryName || "-"}
                        </strong>
                      </div>

                      <div>
                        <div style={{ fontSize: 11, color: "#64748b" }}>
                          Account
                        </div>
                        <strong style={{ fontSize: 13 }}>
                          {expenseCorrectionData.expense?.accountName || "-"}
                        </strong>
                      </div>

                      <div>
                        <div style={{ fontSize: 11, color: "#64748b" }}>
                          Current Amount
                        </div>
                        <strong style={{ fontSize: 15, color: "#dc2626" }}>
                          à§³ {formatMoney(expenseCorrectionData.expense?.amount)}
                        </strong>
                      </div>
                    </div>
                  </div>

                  {/* HISTORY LIST */}
                  <h4
                    style={{
                      margin: "0 0 12px",
                      color: "#172554",
                      fontSize: 15,
                      fontWeight: 800,
                    }}
                  >
                    Correction Records
                  </h4>

                  {!expenseCorrectionData.history?.length ? (
                    <div
                      style={{
                        padding: 25,
                        textAlign: "center",
                        background: "#f8fafc",
                        borderRadius: 8,
                        color: "#64748b",
                        fontSize: 13,
                      }}
                    >
                      No corrections have been made to this expense yet.
                    </div>
                  ) : (
                    <div style={{ display: "grid", gap: 12 }}>
                      {expenseCorrectionData.history.map((history, index) => {
                        const previous = history.previousData || {};

                        return (
                          <div
                            key={history._id || index}
                            style={{
                              border: "1px solid #e2e8f0",
                              borderLeft: "4px solid #0f766e",
                              borderRadius: 9,
                              padding: 15,
                            }}
                          >
                            <div
                              style={{
                                display: "flex",
                                justifyContent: "space-between",
                                gap: 10,
                                flexWrap: "wrap",
                                marginBottom: 12,
                              }}
                            >
                              <strong style={{ color: "#172554", fontSize: 13 }}>
                                Correction #{expenseCorrectionData.history.length - index}
                              </strong>

                              <span style={{ fontSize: 11, color: "#64748b" }}>
                                {history.editedAt
                                  ? new Date(history.editedAt).toLocaleString("en-GB")
                                  : "-"}
                              </span>
                            </div>

                            <div
                              style={{
                                display: "grid",
                                gridTemplateColumns: "repeat(auto-fit, minmax(140px, 1fr))",
                                gap: 12,
                              }}
                            >
                              <div>
                                <div style={{ fontSize: 11, color: "#64748b" }}>
                                  Previous Date
                                </div>
                                <strong style={{ fontSize: 12 }}>
                                  {previous.expenseDate
                                    ? new Date(previous.expenseDate).toLocaleDateString("en-GB")
                                    : "-"}
                                </strong>
                              </div>

                              <div>
                                <div style={{ fontSize: 11, color: "#64748b" }}>
                                  Previous Category
                                </div>
                                <strong style={{ fontSize: 12 }}>
                                  {previous.categoryName || "-"}
                                </strong>
                              </div>

                              <div>
                                <div style={{ fontSize: 11, color: "#64748b" }}>
                                  Previous Account
                                </div>
                                <strong style={{ fontSize: 12 }}>
                                  {previous.accountName || "-"}
                                </strong>
                              </div>

                              <div>
                                <div style={{ fontSize: 11, color: "#64748b" }}>
                                  Previous Amount
                                </div>
                                <strong style={{ fontSize: 13, color: "#dc2626" }}>
                                  à§³ {formatMoney(previous.amount)}
                                </strong>
                              </div>

                              <div>
                                <div style={{ fontSize: 11, color: "#64748b" }}>
                                  Previous Voucher
                                </div>
                                <strong style={{ fontSize: 12 }}>
                                  {previous.voucherNumber || "-"}
                                </strong>
                              </div>
                            </div>

                            <div
                              style={{
                                marginTop: 12,
                                padding: 10,
                                background: "#fff7ed",
                                borderRadius: 7,
                              }}
                            >
                              <div
                                style={{
                                  fontSize: 11,
                                  fontWeight: 800,
                                  color: "#9a3412",
                                  marginBottom: 4,
                                }}
                              >
                                CORRECTION REASON
                              </div>
                              <div style={{ fontSize: 12, color: "#7c2d12" }}>
                                {history.reason || "-"}
                              </div>
                            </div>

                            <div
                              style={{
                                marginTop: 10,
                                fontSize: 11,
                                color: "#64748b",
                              }}
                            >
                              Edited By:{" "}
                              <strong>
                                {history.editedBy?.name ||
                                  history.editedBy?.username ||
                                  "Admin"}
                              </strong>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </>
              )}

              <div
                style={{
                  display: "flex",
                  justifyContent: "flex-end",
                  marginTop: 18,
                  paddingTop: 14,
                  borderTop: "1px solid #e2e8f0",
                }}
              >
                <button
                  type="button"
                  onClick={() => {
                    setExpenseCorrectionModalOpen(false);
                    setExpenseCorrectionData(null);
                  }}
                  style={{
                    padding: "10px 20px",
                    background: "#172554",
                    color: "#fff",
                    border: "none",
                    borderRadius: 7,
                    fontWeight: 700,
                    cursor: "pointer",
                  }}
                >
                  Close
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}




function renderDateWiseExpenseReport() {
  const activeAccounts = accounts.filter(
    (account) => account.isActive !== false
  );

  const activeCategories = expenseCategories.filter(
    (category) => category.isActive !== false
  );

  const formatMoney = (amount) =>
    Number(amount || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

  const labelStyle = {
    display: "block",
    fontSize: 12,
    fontWeight: 700,
    color: "#475569",
    marginBottom: 6,
  };

  const inputStyle = {
    width: "100%",
    padding: "10px 12px",
    border: "1px solid #cbd5e1",
    borderRadius: 7,
    fontSize: 13,
    background: "#fff",
    boxSizing: "border-box",
    outline: "none",
  };

  const updateFilter = (key, value) => {
    setDateWiseExpenseFilters((prev) => ({
      ...prev,
      [key]: value,
    }));
  };

  const clearFilters = () => {
    const emptyFilters = {
      fromDate: "",
      toDate: "",
      categoryId: "",
      accountId: "",
    };

    setDateWiseExpenseFilters(emptyFilters);
    loadDateWiseExpenseReport(emptyFilters);
    setExpandedExpenseDate("");
  };

  const toggleDateDetails = (dateKey) => {
    setExpandedExpenseDate((prev) =>
      prev === dateKey ? "" : dateKey
    );
  };

  const getDateKey = (date) => {
    const d = new Date(date);
    if (Number.isNaN(d.getTime())) return "";

    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");

    return `${year}-${month}-${day}`;
  };

  const getDateLabel = (date) => {
    const d = new Date(date);

    if (Number.isNaN(d.getTime())) return "-";

    return d.toLocaleDateString("en-GB", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    });
  };

  const getExpensesForDate = (date) => {
    const targetDate = getDateKey(date);

    return dateWiseExpenseDetails.filter(
      (expense) => getDateKey(expense.expenseDate) === targetDate
    );
  };

  return (
    <div style={{ display: "grid", gap: 16 }}>

      {/* PAGE HEADER */}
      <div
        style={{
          background: "#172554",
          color: "#fff",
          padding: "18px 20px",
          borderRadius: 10,
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          gap: 12,
          flexWrap: "wrap",
          boxShadow: "0 3px 10px rgba(15,23,42,.12)",
        }}
      >
        <div>
          <h2 style={{ margin: 0, fontSize: 21, fontWeight: 800 }}>
            Date-wise Expense Report
          </h2>

          <p style={{ margin: "4px 0 0", fontSize: 12, color: "#cbd5e1" }}>
            Daily expense summary and detailed records
          </p>

          <br></br>
<button
  type="button"
  onClick={() => exportExpenseReportPDF("date")}
  disabled={
    dateWiseExpenseLoading ||
    dateWiseExpenseReport.length === 0
  }
  style={{
    padding: "9px 16px",
    background: "#dc2626",
    color: "#fff",
    border: "none",
    borderRadius: 7,
    fontSize: 12,
    fontWeight: 700,
    cursor: "pointer",
    opacity:
      dateWiseExpenseLoading ||
      dateWiseExpenseReport.length === 0
        ? 0.5
        : 1,
  }}
>
  <Download size={15} style={{ marginRight: 6, verticalAlign: "middle" }} />
  Export PDF
</button>

        </div>



        <button
          type="button"
          onClick={() => loadDateWiseExpenseReport()}
          disabled={dateWiseExpenseLoading}
          style={{
            padding: "9px 14px",
            background: "#fff",
            color: "#172554",
            border: "none",
            borderRadius: 7,
            fontWeight: 700,
            cursor: "pointer",
          }}
        >
          {dateWiseExpenseLoading ? "Loading..." : "â†» Refresh"}
        </button>
      </div>

      {/* SUMMARY CARDS */}
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
          gap: 14,
        }}
      >
        <div
          style={{
            background: "#fff",
            border: "1px solid #e2e8f0",
            borderLeft: "4px solid #ea580c",
            borderRadius: 10,
            padding: 17,
          }}
        >
          <div style={{ fontSize: 12, color: "#64748b", fontWeight: 700 }}>
            TOTAL EXPENSE
          </div>

          <div style={{ fontSize: 23, fontWeight: 800, color: "#ea580c", marginTop: 7 }}>
            à§³ {formatMoney(dateWiseExpenseSummary.totalAmount)}
          </div>
        </div>

        <div
          style={{
            background: "#fff",
            border: "1px solid #e2e8f0",
            borderLeft: "4px solid #0f766e",
            borderRadius: 10,
            padding: 17,
          }}
        >
          <div style={{ fontSize: 12, color: "#64748b", fontWeight: 700 }}>
            TOTAL ENTRIES
          </div>

          <div style={{ fontSize: 23, fontWeight: 800, color: "#0f766e", marginTop: 7 }}>
            {Number(dateWiseExpenseSummary.totalEntries || 0).toLocaleString("en-BD")}
          </div>
        </div>

        <div
          style={{
            background: "#fff",
            border: "1px solid #e2e8f0",
            borderLeft: "4px solid #2563eb",

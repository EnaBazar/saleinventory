                </div>
              </div>


{/* SELECT ACCOUNT FOR CUSTOMER COLLECTION */}
<label style={labelStyle}>
  à¦Ÿà¦¾à¦•à¦¾ à¦•à§‹à¦¨ Account-à¦ à¦œà¦®à¦¾ à¦¹à¦¬à§‡?
</label>

<select
  required
  style={inputStyle}

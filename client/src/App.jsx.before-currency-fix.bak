                    </td>
                    <td style={{ padding: 10, border: "1px solid #e2e8f0" }}>
                      {Number(item.labourTotal || 0).toFixed(2)}
                    </td>
                    <td style={{ padding: 10, border: "1px solid #e2e8f0" }}>
                      {Number(item.lineTotal || 0).toFixed(2)}
                    </td>

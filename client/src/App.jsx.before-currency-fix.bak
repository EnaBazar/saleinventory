function renderLoanProviders() {
  const fieldStyle = {
    width: "100%",
    padding: "10px 12px",
    border: "1px solid #dbe1ea",
    borderRadius: 9,
    fontSize: 13,
    outline: "none",
    boxSizing: "border-box",
    background: "#fff",
    minHeight: 43,
    color: "#334155",
  };

  const labelStyle = {
    display: "block",
    marginBottom: 7,
    fontSize: 13,
    fontWeight: 600,
    color: "#475569",
  };

  const sectionStyle = {
    padding: 17,
    background: "#f8fafc",
    border: "1px solid #e2e8f0",
    borderRadius: 12,
  };

  const sectionTitleStyle = {
    margin: "0 0 15px",
    fontSize: 14,
    fontWeight: 700,
    color: "#334155",
  };

  const gridStyle = {
    display: "grid",

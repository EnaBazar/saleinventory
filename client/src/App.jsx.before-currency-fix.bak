                                                      <th>COMMISSION</th>
                                                      <th>LABOUR</th>
                                                      <th>ITEM COST</th>
                                                      <th>PROFIT</th>
                                                    </tr>
                                                  </thead>
                                                  <tbody>
                                                    {(invoice.items || []).map((item, itemIndex) => (
                                                      <tr key={`${invoiceId}-item-${itemIndex}`}>
                                                        <td>{item.lotCode || "-"}</td>
                                                        <td>{item.productName || "-"}</td>
                                                        <td>{Number(item.bags || 0).toLocaleString("en-BD")}</td>
                                                        <td>{Number(item.weightKg || 0).toLocaleString("en-BD")}</td>
                                                        <td>à§³ {Number(item.rate || 0).toLocaleString("en-BD")}</td>
                                                        <td>à§³ {Number(item.productTotal || 0).toLocaleString("en-BD")}</td>
                                                        <td>à§³ {Number(item.commission || 0).toLocaleString("en-BD")}</td>
                                                        <td>à§³ {Number(item.labour || 0).toLocaleString("en-BD")}</td>
                                                       <td>à§³ {Number(item.cost || 0).toLocaleString("en-BD")}</td>
                                                        <td>à§³ {Number(item.profit || 0).toLocaleString("en-BD")}</td>

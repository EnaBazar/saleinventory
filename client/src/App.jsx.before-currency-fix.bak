const deactivateCategory = async (id) => {
  if (!window.confirm("à¦à¦‡ Category Deactivate à¦•à¦°à¦¤à§‡ à¦šà¦¾à¦¨?")) return;

  try {
    const result = await apiRequest(`/categories/${id}`, {
      method: "DELETE",
    });

    if (result.success) {
      toast.success("Category deactivated");
      loadCategories();
    } else {
      toast.error(result.message || "Category deactivate à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
    }
  } catch (error) {
    toast.error(error.message || "à¦¸à¦®à¦¸à§à¦¯à¦¾ à¦¹à§Ÿà§‡à¦›à§‡");
  }
};

  async function saveProduct(e) {
    e.preventDefault();

    try {
      const payload = {
        ...productForm,
        purchasePrice: Number(productForm.purchasePrice),
        salePrice: Number(productForm.salePrice),
        minimumStockKg: Number(productForm.minimumStockKg),
        supplier: productForm.supplier || null,
      };

      const url = editingId
        ? `/products/${editingId}`
        : "/products";

      await apiRequest(url, {
        method: editingId ? "PUT" : "POST",
        body: JSON.stringify(payload),
      });

      toast.success(editingId ? "Product updated" : "Product added");
      setShowForm(false);
      setEditingId(null);
      setProductForm({ ...emptyProduct });
      loadProducts();
    } catch (error) {
      toast.error(error.message);
    }
  }

  async function saveSupplier(e) {
    e.preventDefault();

    try {
      const payload = {
        ...supplierForm,
        openingBalance: Number(supplierForm.openingBalance),
      };

      const url = editingId
        ? `/suppliers/${editingId}`
        : "/suppliers";

      await apiRequest(url, {
        method: editingId ? "PUT" : "POST",
        body: JSON.stringify(payload),
      });

      toast.success(editingId ? "Supplier updated" : "Supplier added");
      setShowForm(false);
      setEditingId(null);
      setSupplierForm({ ...emptySupplier });
      loadSuppliers();
    } catch (error) {
      toast.error(error.message);
    }
  }


  async function saveCustomer(e) {
  e.preventDefault();

  try {
    const payload = {
      ...customerForm,
      openingBalance: Number(customerForm.openingBalance),
    };

    const url = editingCustomerId
      ? `/customers/${editingCustomerId}`
      : "/customers";

    await apiRequest(url, {
      method: editingCustomerId ? "PUT" : "POST",
      body: JSON.stringify(payload),
    });

    toast.success(
      editingCustomerId ? "Customer updated" : "Customer added"
    );

    setShowCustomerForm(false);
    setEditingCustomerId(null);

    setCustomerForm({
      customerName: "",
      companyName: "",
      contactPerson: "",
      mobile: "",
      alternateMobile: "",
      address: "",
      customerType: "REGULAR",
      openingBalance: "0",
      notes: "",
    });

    loadCustomers();
  } catch (error) {
    toast.error(error.message);
  }
}

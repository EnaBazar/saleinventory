      if (!salesReturnSubmitting) {
        setShowSalesReturn(false);
      }
    }}
  >
    <div
      style={{
        width: "100%",
        maxWidth: 1050,
        maxHeight: "94vh",
        display: "flex",
        flexDirection: "column",
        background: "#f8fafc",
        borderRadius: 11,
        overflow: "hidden",
        boxShadow: "0 15px 45px rgba(0,0,0,.25)",
      }}
      onClick={(e) => e.stopPropagation()}
    >
      {/* HEADER */}
      <div

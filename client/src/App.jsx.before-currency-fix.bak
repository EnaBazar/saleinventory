    </button>
  )}
</div>

      </div>

      <div className="panel" style={{ padding: 22 }}>
        <div style={pageHeaderStyle}>
          <div>
            <h3 style={{ margin: 0, fontSize: 16 }}>Account List</h3>
            <p style={{ color: "#7b8494", margin: "6px 0 0" }}>
              Total Active Accounts: {activeAccounts.length}
            </p>
          </div>
        </div>

        {accountLoading ? (
          <p>Loading accounts...</p>
        ) : accounts.length === 0 ? (
          <p style={{ color: "#7b8494", fontSize: 13 }}>
            à¦à¦–à¦¨à§‹ à¦•à§‹à¦¨à§‹ Account à¦¤à§ˆà¦°à¦¿ à¦•à¦°à¦¾ à¦¹à§Ÿà¦¨à¦¿à¥¤
          </p>
        ) : (
          <div className="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>ACCOUNT NAME</th>
                  <th>TYPE</th>
                  <th>BANK</th>
                  <th>ACCOUNT NUMBER</th>
                  <th>OPENING BALANCE</th>
                  <th>CURRENT BALANCE</th>
                  <th>STATUS</th>
                  <th>ACTIONS</th>
                </tr>
              </thead>

              
<tbody>
  {accounts.map((account) => (
    <tr key={account._id}>
      <td>{account.accountName}</td>

      <td>{account.accountType}</td>

      <td>{account.bankName || "-"}</td>

      <td>{account.accountNumber || "-"}</td>

      <td style={{ textAlign: "left", whiteSpace: "nowrap" }}>
        à§³ {Number(account.openingBalance || 0).toLocaleString("en-BD")}
      </td>


      <td
        style={{
          textAlign: "left",
          whiteSpace: "nowrap",
          fontWeight: 700,
          color: "#15803d",
        }}
      >
        à§³ {Number(
          account.currentBalance ?? account.openingBalance ?? 0
        ).toLocaleString("en-BD")}
      </td>



   <td>
  {account.isActive !== false ? "Active" : "Inactive"}
</td>


<td>
  {account.isActive !== false ? (
    <div style={{ display: "flex", gap: 7 }}>
      <button
        type="button"
        className="secondary-button"
        onClick={() => startEditAccount(account)}
      >
        Edit
      </button>

      <button
        type="button"
        className="secondary-button"
        onClick={() => deactivateAccount(account)}
        style={{
          color: "#dc2626",
          borderColor: "#fecaca",
        }}
      >
        Deactivate
      </button>
    </div>
  ) : (
    <button
      type="button"
      className="secondary-button"
      onClick={() => reactivateAccount(account)}
      style={{
        color: "#15803d",
        borderColor: "#bbf7d0",
      }}
    >
      Reactivate
    </button>
  )}
</td>

    </tr>
  ))}
</tbody>

            </table>
          </div>
        )}
      </div>
    </div>
  );
}



function renderActivityLog() {
  const metadata = selectedActivity?.metadata || {};

  const oldValues =
    metadata.oldValues && typeof metadata.oldValues === "object"
      ? metadata.oldValues
      : {};

  const newValues =
    metadata.newValues && typeof metadata.newValues === "object"
      ? metadata.newValues
      : {};

  const comparisonKeys = [
    ...new Set([
      ...Object.keys(oldValues),
      ...Object.keys(newValues),
    ]),
  ];

  function formatActivityValue(value) {
    if (value === null || value === undefined || value === "") {
      return "-";
    }

    if (typeof value === "boolean") {
      return value ? "Yes" : "No";
    }

    if (typeof value === "object") {
      return JSON.stringify(value, null, 2);
    }

    return String(value);
  }

  function formatActivityLabel(key) {
   const labels = {
  amount: "Amount",
  paymentMethod: "Payment Method",
  transactionId: "Transaction ID",
  transactionDate: "Transaction Date",
  balanceBefore: "Previous Balance",
  balanceAfter: "New Balance",
  notes: "Notes",
  bagsReturned: "Bags Returned",
  weightReturnedKg: "Weight Returned (KG)",
  purchasePricePerKg: "Purchase Price / KG",
  returnAmount: "Return Amount",
  returnDate: "Return Date",
  supplierId: "Supplier",
  oldValues: "Previous Values",
  newValues: "Updated Values",
  editReason: "Edit Reason",
  productName: "Product Name",
  supplierName: "Supplier Name",
  totalWeightKg: "Total Weight (KG)",
  totalPurchaseAmount: "Total Purchase Amount",
  bagsReceived: "Bags Received",
  remainingWeightKg: "Remaining Weight (KG)",
  remainingBags: "Remaining Bags",
  stockType: "Stock Type",
  purchaseDate: "Purchase Date",
  category: "Category",
  subcategory: "Subcategory",
  brand: "Brand",
  supplier: "Supplier",
  packingType: "Packing Type",
  unit: "Unit",
  purchasePrice: "Purchase Price",
  salePrice: "Sale Price",
  minimumStockKg: "Minimum Stock (KG)",
  description: "Description",
  isActive: "Active Status",
  lotCode: "Lot Code",
};
    return labels[key] ||
      key.replace(/([A-Z])/g, " $1")
        .replace(/^./, (s) => s.toUpperCase());
  }

  function formatMetadataValue(key, value) {
    if (value === null || value === undefined || value === "") {
      return "-";
    }
if (
  [
    "amount",
    "balanceBefore",
    "balanceAfter",
    "returnAmount",
    "totalPurchaseAmount",
    "purchasePricePerKg",
    "purchasePrice",
    "salePrice",
  ].includes(key)
) {
  return `à§³${Number(value).toLocaleString("en-BD")}`;
}
 

    if (key === "paymentMethod") {
      return String(value).replace(/_/g, " ");
    }

    if (["transactionDate", "returnDate", "purchaseDate"].includes(key)) {
      const date = new Date(value);
      return Number.isNaN(date.getTime())
        ? String(value)
        : date.toLocaleDateString("en-BD");
    }

    return formatActivityValue(value);
  }


// ========================================
// SUBMIT SALES COLLECTION
// ========================================



async function submitSalesCollection() {
  if (!selectedCollectionCustomer?._id) {
    toast.error("à¦ªà§à¦°à¦¥à¦®à§‡ Customer à¦¨à¦¿à¦°à§à¦¬à¦¾à¦šà¦¨ à¦•à¦°à§à¦¨");
    return;
  }

  const amount = Number(collectionAmount);

  if (!Number.isFinite(amount) || amount <= 0) {
    toast.error("à¦¸à¦ à¦¿à¦• Payment Amount à¦²à¦¿à¦–à§à¦¨");
    return;
  }

  const currentDue = Number(
    selectedCollectionCustomer.currentBalance || 0
  );

  if (amount > currentDue + 0.009) {
    toast.error(
      `Customer-à¦à¦° à¦¬à¦°à§à¦¤à¦®à¦¾à¦¨ à¦¬à¦•à§‡à§Ÿà¦¾ ${currentDue.toFixed(2)} à¦Ÿà¦¾à¦•à¦¾`
    );
    return;
  }
if (requiresCollectionAccount && !collectionAccountId) {
  toast.error("à¦ªà§à¦°à¦¥à¦®à§‡ à¦à¦•à¦Ÿà¦¿ Account à¦¨à¦¿à¦°à§à¦¬à¦¾à¦šà¦¨ à¦•à¦°à§à¦¨");
  return;
}
  try {
    setCollectionLoading(true);

    const result = await apiRequest(
      `/customers/${selectedCollectionCustomer._id}/payments`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          amount,
          paymentMethod: collectionPaymentMethod,
          accountId: collectionAccountId || null,
          transactionId: collectionTransactionId,
          reference: collectionReference,
          description: collectionDescription,
          transactionDate: collectionTransactionDate,
        }),
      }
    );

    toast.success(
      result.message || "Customer Payment à¦¸à¦«à¦²à¦­à¦¾à¦¬à§‡ à¦¸à¦‚à¦°à¦•à§à¦·à¦£ à¦¹à§Ÿà§‡à¦›à§‡"
    );

    setCollectionAmount("");
    setCollectionTransactionId("");
    setCollectionReference("");
    setCollectionDescription("");
setCollectionAccountId("");
    setSelectedCollectionCustomer(null);
    setCollectionCustomerSearch("");
    setCollectionCustomerOptions([]);
    setShowCollectionCustomerOptions(false);

    await loadCustomers();

  } catch (error) {
    toast.error(
      error.message || "Customer Payment à¦¸à¦‚à¦°à¦•à§à¦·à¦£ à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿"
    );
  } finally {
    setCollectionLoading(false);
  }
}






          onClick={() => {
  setSalesSearch("");
  setSalesStartDate("");
  setSalesEndDate("");
  setSalesStatusFilter("");

  loadSalesInvoices({
    search: "",
    status: "",
    startDate: "",
    endDate: "",
  });
}}
          >
            Clear Filters

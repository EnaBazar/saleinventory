function startEditAccountTransaction(transaction) {
  if (
    !["DEPOSIT", "WITHDRAWAL", "TRANSFER_IN", "TRANSFER_OUT"].includes(
      transaction.transactionType
    )
  ) {
    toast.error("à¦à¦‡ Transaction Edit à¦•à¦°à¦¾ à¦¯à¦¾à¦¬à§‡ à¦¨à¦¾");
    return;
  }

  const isTransfer =
    transaction.transactionType === "TRANSFER_IN" ||
    transaction.transactionType === "TRANSFER_OUT";

  setEditingTransaction({
    id: transaction._id,
    transactionType: isTransfer
      ? "TRANSFER"
      : transaction.transactionType,
    accountId:
      transaction.transactionType === "TRANSFER_IN"
        ? transaction.relatedAccountId?._id
        : transaction.accountId?._id || transaction.accountId,
    relatedAccountId: isTransfer
      ? transaction.transactionType === "TRANSFER_IN"
        ? transaction.accountId?._id
        : transaction.relatedAccountId?._id
      : "",
    amount: String(transaction.amount || ""),
    transactionDate: transaction.transactionDate
      ? new Date(transaction.transactionDate).toISOString().slice(0, 10)
      : new Date().toISOString().slice(0, 10),
    reference: transaction.reference || "",
    description: transaction.description || "",
    reason: "",
  });
}

async function updateAccountTransaction() {
  if (!editingTransaction) return;

  if (!editingTransaction.accountId) {
    toast.error("Account à¦¨à¦¿à¦°à§à¦¬à¦¾à¦šà¦¨ à¦•à¦°à§à¦¨");
    return;
  }

  if (
    editingTransaction.transactionType === "TRANSFER" &&
    !editingTransaction.relatedAccountId
  ) {
    toast.error("Destination Account à¦¨à¦¿à¦°à§à¦¬à¦¾à¦šà¦¨ à¦•à¦°à§à¦¨");
    return;
  }

  if (
    editingTransaction.transactionType === "TRANSFER" &&
    editingTransaction.accountId === editingTransaction.relatedAccountId
  ) {
    toast.error("à¦à¦•à¦‡ Account-à¦ Transfer à¦•à¦°à¦¾ à¦¯à¦¾à¦¬à§‡ à¦¨à¦¾");
    return;
  }

  const amount = Number(editingTransaction.amount);

  if (!Number.isFinite(amount) || amount <= 0) {
    toast.error("à¦¸à¦ à¦¿à¦• Amount à¦²à¦¿à¦–à§à¦¨");
    return;
  }

  if (!editingTransaction.reason?.trim()) {
    toast.error("Edit à¦•à¦°à¦¾à¦° à¦•à¦¾à¦°à¦£ à¦²à¦¿à¦–à§à¦¨");
    return;
  }

  try {
    setTransactionEditSaving(true);

    await apiRequest(
      `/accounts/transactions/${editingTransaction.id}`,
      {
        method: "PATCH",
        body: JSON.stringify({
          ...editingTransaction,
          amount,
          reason: editingTransaction.reason.trim(),
        }),
      }
    );

    toast.success("Transaction à¦¸à¦«à¦²à¦­à¦¾à¦¬à§‡ Update à¦¹à§Ÿà§‡à¦›à§‡");

    setEditingTransaction(null);

    await Promise.all([
      loadAccounts(),
      loadAccountTransactions(transactionPagination.currentPage || 1),
    ]);
  } catch (error) {
    toast.error(error.message || "Transaction Update à¦¹à§Ÿà¦¨à¦¿");
  } finally {
    setTransactionEditSaving(false);
  }
}

async function voidAccountTransaction(transaction) {
  if (
    !["DEPOSIT", "WITHDRAWAL", "TRANSFER_IN", "TRANSFER_OUT"].includes(
      transaction.transactionType
    )
  ) {
    toast.error("à¦à¦‡ Transaction à¦¬à¦¾à¦¤à¦¿à¦² à¦•à¦°à¦¾ à¦¯à¦¾à¦¬à§‡ à¦¨à¦¾");
    return;
  }

  const reason = window.prompt(
    "Transaction à¦¬à¦¾à¦¤à¦¿à¦² à¦•à¦°à¦¾à¦° à¦•à¦¾à¦°à¦£ à¦²à¦¿à¦–à§à¦¨:"
  );

  if (reason === null) return;

  if (!reason.trim()) {
    toast.error("à¦¬à¦¾à¦¤à¦¿à¦² à¦•à¦°à¦¾à¦° à¦•à¦¾à¦°à¦£ à¦²à¦¿à¦–à¦¤à§‡ à¦¹à¦¬à§‡");
    return;
  }

  const confirmed = window.confirm(
    "à¦†à¦ªà¦¨à¦¿ à¦•à¦¿ à¦¨à¦¿à¦¶à§à¦šà¦¿à¦¤ à¦à¦‡ Transaction à¦¬à¦¾à¦¤à¦¿à¦² à¦•à¦°à¦¤à§‡ à¦šà¦¾à¦¨? Transfer à¦¹à¦²à§‡ à¦¦à§à¦‡ à¦ªà¦¾à¦¶à§‡à¦° Entry à¦¬à¦¾à¦¤à¦¿à¦² à¦¹à¦¬à§‡à¥¤"
  );

  if (!confirmed) return;

  try {
    setTransactionActionLoading(true);

    await apiRequest(
      `/accounts/transactions/${transaction._id}/void`,
      {
        method: "PATCH",
        body: JSON.stringify({
          reason: reason.trim(),
        }),
      }
    );

    toast.success("Transaction à¦¬à¦¾à¦¤à¦¿à¦² à¦•à¦°à¦¾ à¦¹à§Ÿà§‡à¦›à§‡");

    await Promise.all([
      loadAccounts(),
      loadAccountTransactions(transactionPagination.currentPage || 1),
    ]);
  } catch (error) {
    toast.error(error.message || "Transaction à¦¬à¦¾à¦¤à¦¿à¦² à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
  } finally {
    setTransactionActionLoading(false);
  }
}


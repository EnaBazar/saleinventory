  ["Report Generated", new Date().toLocaleString("en-BD")],
    [],
    ["SUPPLIER-WISE SUMMARY"],
    [
      "Supplier",
      "Address",
      "Mobile",
      "Transactions",
      "Purchase",
      "Payment",
      "Purchase Return",
      "Debit",
      "Credit",
      "Net Balance",
    ],
    ...supplierSummary.map((s) => [
      s.supplierName,
      s.address,
      s.mobile,
      s.transactionCount,
      s.totalPurchase,
      s.totalPayment,
      s.totalPurchaseReturn,
      s.totalDebit,
      s.totalCredit,
      Number(s.totalDebit || 0) - Number(s.totalCredit || 0),
    ]),
    [],
    
    ["ALL TRANSACTIONS"],

...supplierSummary.map((s) => [
  s.supplierName,
  s.address,
  s.mobile,
  s.transactionCount,
  s.totalPurchase,
  s.totalPayment,
  s.totalPurchaseReturn,
  s.totalDebit,
  s.totalCredit,
  Number(s.totalDebit || 0) - Number(s.totalCredit || 0),
]),
[
  "GRAND TOTAL",
  "",
  "",
  summary.totalTransactions || 0,
  summary.totalPurchase || 0,
  summary.totalPayment || 0,
  summary.totalPurchaseReturn || 0,
  summary.totalDebit || 0,
  summary.totalCredit || 0,
  netSupplierBalance,
],
[],
["ALL TRANSACTIONS"],

    [
      "Date",
      "Supplier",
      "Type",
      "Lot Number",
      "Description",
      "Payment Method",
      "Debit",
      "Credit",
      "Status",
    ],
    ...reportTransactions.map((item) => [
      item.transactionDate
        ? new Date(item.transactionDate).toLocaleDateString("en-GB")
        : "",
      item.supplierName,
      transactionLabel(item.type),
      item.lotCode,
      item.description || item.reference,
      item.paymentMethod,
      item.debit,
      item.credit,
      item.isVoided ? "VOIDED" : "Active",
    ]),
  ];

  const csvContent =
    "\uFEFF" +
    rows.map((row) => row.map(escapeCSV).join(",")).join("\r\n");

  const blob = new Blob([csvContent], {
    type: "text/csv;charset=utf-8;",
  });

  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");

  link.href = url;
  link.download = "all-supplier-report.csv";
  link.click();

  URL.revokeObjectURL(url);
};

  const transactionLabel = (type) => {
    const labels = {
      PURCHASE: "Purchase",
      PURCHASE_RETURN: "Purchase Return",
      PAYMENT: "Supplier Payment",
      ADJUSTMENT: "Adjustment",
    };

    return labels[type] || type || "-";
  };

  return (
    <div className="panel all-supplier-report-print" style={{ padding: 22 }}>
      <div style={{
        ...pageHeaderStyle,
        flexWrap: "wrap",
        gap: 12,
      }}>
        <div>
          <h2 style={{ margin: 0 }}>All Supplier Report</h2>
          <p style={{ color: "#7b8494", margin: "6px 0 0" }}>
            All suppliers transaction summary and details
          </p>
<p style={{
  color: "#64748b",
  fontSize: 12,
  margin: "5px 0 0",
}}>
  Report Generated: {new Date().toLocaleString("en-BD")}
</p>

        </div>

        <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
          <button
            className="secondary-button"
            onClick={() => window.print()}
            disabled={!report}
          >
            <Printer size={17} /> Print / PDF
          </button>
<button
  className="secondary-button"
  onClick={downloadAllSupplierReportCSV}
  disabled={!report || reportTransactions.length === 0}
>
  <Download size={17} /> Export CSV
</button>
          <button
            className="secondary-button"
            onClick={() => setActivePage("Suppliers")}
          >
            Back to Suppliers
          </button>
        </div>
      </div>

      {/* FILTER PANEL */}
      <div
        className="all-supplier-report-filter"
        style={{
          marginTop: 20,
          padding: 18,
          border: "1px solid #e2e8f0",
          borderRadius: 12,
          background: "#f8fafc",
        }}
      >
        <h3 style={{ margin: "0 0 15px", fontSize: 16 }}>
          Report Filters
        </h3>

        <div style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(190px, 1fr))",
          gap: 14,
        }}>
          {/* START DATE */}
          <div>
            <label style={fieldStyle}>Start Date</label>
            <input
              type="date"
              style={inputStyle}
              value={allSupplierReportFilters.startDate}
              onChange={(e) => updateFilter("startDate", e.target.value)}
            />
          </div>

          {/* END DATE */}
          <div>
            <label style={fieldStyle}>End Date</label>
            <input
              type="date"
              style={inputStyle}
              value={allSupplierReportFilters.endDate}
              onChange={(e) => updateFilter("endDate", e.target.value)}
            />
          </div>

          {/* SEARCHABLE SUPPLIER */}
          <div style={{ position: "relative" }}>
            <label style={fieldStyle}>Supplier</label>

            <input
              style={inputStyle}
              placeholder="Search supplier name..."
              value={
                showSupplierReportSupplierOptions
                  ? supplierReportSearch
                  : selectedSupplier?.supplierName || "All Suppliers"
              }
              onFocus={() => {
                setSupplierReportSearch("");
                setShowSupplierReportSupplierOptions(true);
              }}
              onChange={(e) => {
                setSupplierReportSearch(e.target.value);
                setShowSupplierReportSupplierOptions(true);
              }}
              onBlur={() => {
                setTimeout(() => {
                  setShowSupplierReportSupplierOptions(false);
                }, 150);
              }}
            />

            {showSupplierReportSupplierOptions && (
              <div
                style={{
                  position: "absolute",
                  top: "100%",
                  left: 0,
                  right: 0,
                  zIndex: 100,
                  background: "#fff",
                  border: "1px solid #dce1e8",
                  borderRadius: 8,
                  maxHeight: 230,
                  overflowY: "auto",
                  boxShadow: "0 5px 15px rgba(0,0,0,0.10)",
                }}
              >
                <div
                  onMouseDown={() => {
                    updateFilter("supplierId", "");
                    setSupplierReportSearch("");
                    setShowSupplierReportSupplierOptions(false);
                  }}
                  style={{
                    padding: "11px 12px",
                    cursor: "pointer",
                    borderBottom: "1px solid #eee",
                    fontSize: 14,
                    fontWeight: 600,
                  }}
                >
                  All Suppliers
                </div>

                {filteredSupplierOptions.map((s) => (
                  <div
                    key={s._id}
                    onMouseDown={() => {
                      updateFilter("supplierId", s._id);
                      setSupplierReportSearch("");
                      setShowSupplierReportSupplierOptions(false);
                    }}
                    style={{
                      padding: "11px 12px",
                      cursor: "pointer",
                      borderBottom: "1px solid #f1f5f9",
                      fontSize: 14,
                    }}
                  >
                    {s.supplierName}
                  </div>
                ))}

                {filteredSupplierOptions.length === 0 && (
                  <div style={{
                    padding: 12,
                    color: "#64748b",
                    fontSize: 13,
                  }}>
                    No supplier found
                  </div>
                )}
              </div>
            )}
          </div>

          {/* TRANSACTION TYPE */}
          <div>
            <label style={fieldStyle}>Transaction Type</label>
            <select
              style={inputStyle}
              value={allSupplierReportFilters.type}
              onChange={(e) => updateFilter("type", e.target.value)}
            >
              <option value="">All Types</option>
              <option value="PURCHASE">Purchase</option>
              <option value="PURCHASE_RETURN">Purchase Return</option>
              <option value="PAYMENT">Supplier Payment</option>
              <option value="ADJUSTMENT">Adjustment</option>
            </select>
          </div>

          {/* PAYMENT METHOD */}
          <div>
            <label style={fieldStyle}>Payment Method</label>
            <select
              style={inputStyle}
              value={allSupplierReportFilters.paymentMethod}
              onChange={(e) => updateFilter("paymentMethod", e.target.value)}
            >
              <option value="">All Methods</option>
              <option value="CASH">Cash</option>
              <option value="BANK">Bank</option>
              <option value="BKASH">bKash</option>
              <option value="NAGAD">Nagad</option>
              <option value="ROCKET">Rocket</option>
              <option value="OTHER">Other</option>
            </select>
          </div>

          {/* MINIMUM AMOUNT */}
          <div>
            <label style={fieldStyle}>Minimum Amount</label>
            <input
              type="number"
              min="0"
              style={inputStyle}
              placeholder="Minimum amount"
              value={allSupplierReportFilters.minAmount}
              onChange={(e) => updateFilter("minAmount", e.target.value)}
            />
          </div>

          {/* MAXIMUM AMOUNT */}
          <div>
            <label style={fieldStyle}>Maximum Amount</label>
            <input
              type="number"
              min="0"
              style={inputStyle}
              placeholder="Maximum amount"
              value={allSupplierReportFilters.maxAmount}
              onChange={(e) => updateFilter("maxAmount", e.target.value)}
            />
          </div>

          {/* GENERAL SEARCH */}
          <div>
            <label style={fieldStyle}>Search</label>
            <input
              style={inputStyle}
              placeholder="Supplier / Lot / Transaction ID"
              value={allSupplierReportFilters.search}
              onChange={(e) => updateFilter("search", e.target.value)}
            />
          </div>
        </div>

        {/* FILTER BUTTONS */}
        <div style={{
          display: "flex",
          gap: 10,
          marginTop: 16,
          flexWrap: "wrap",
        }}>
          <button
            className="primary-button"
            disabled={allSupplierReportLoading}
            onClick={() => loadAllSupplierReport()}
          >
            {allSupplierReportLoading ? "Loading..." : "Apply Filter"}
          </button>

          <button
            className="secondary-button"
            onClick={clearFilters}
            disabled={allSupplierReportLoading}
          >
            Clear Filter
          </button>
        </div>
      </div>

      {/* LOADING */}
      {allSupplierReportLoading && (
        <p style={{ textAlign: "center", padding: 25 }}>
          Loading supplier report...
        </p>
      )}

      {/* REPORT DATA */}
      {!allSupplierReportLoading && report && (
        <>
          {/* SUMMARY CARDS */}
          <div style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
            gap: 14,
            marginTop: 20,
          }}>
            {[
              {
                title: "Total Suppliers",
                value: summary.supplierCount || 0,
                color: "#2563eb",
              },
              {
                title: "Total Purchase",
                value: money(summary.totalPurchase),
                color: "#2563eb",
              },
              {
                title: "Total Payment",
                value: money(summary.totalPayment),
                color: "#16a34a",
              },
              {
  title: "Net Supplier Balance",
  value: money(Math.abs(netSupplierBalance)),
  subtitle:
    netSupplierBalance > 0
      ? "Payable to Suppliers"
      : netSupplierBalance < 0
      ? "Supplier Advance"
      : "Fully Settled",
  color: netSupplierBalance > 0 ? "#dc2626" : "#16a34a",
},
              {
                title: "Purchase Return",
                value: money(summary.totalPurchaseReturn),
                color: "#d97706",
              },
              {
                title: "Adjustment Debit",
                value: money(summary.totalAdjustmentDebit),
                color: "#64748b",
              },
              {
                title: "Adjustment Credit",
                value: money(summary.totalAdjustmentCredit),
                color: "#64748b",
              },
            ].map((item) => (
              <div
                key={item.title}
                style={{
                  padding: 17,
                  border: "1px solid #e2e8f0",
                  borderRadius: 10,
                  background: "#fff",
                }}
              >
                <p style={{
                  margin: 0,
                  color: "#64748b",
                  fontSize: 13,
                }}>
                  {item.title}
                </p>
                <h3 style={{
                  margin: "9px 0 0",
                  color: item.color,
                  fontSize: 19,
                }}>
                  {item.value}
                </h3>
{item.subtitle && (
  <p style={{
    margin: "6px 0 0",
    fontSize: 12,
    color: item.color,
    fontWeight: 600,
  }}>
    {item.subtitle}
  </p>
)}

              </div>
            ))}
          </div>

          {/* TOTALS */}
          <div style={{
            display: "flex",
            gap: 20,
            flexWrap: "wrap",
            margin: "16px 0 22px",
            color: "#64748b",
            fontSize: 13,
          }}>
            <span>
              Total Transactions: <strong>{summary.totalTransactions || 0}</strong>
            </span>
            <span>
              Total Debit: <strong>{money(summary.totalDebit)}</strong>
            </span>
            <span>
              Total Credit: <strong>{money(summary.totalCredit)}</strong>
            </span>
            <span>
              Voided Payments: <strong>{money(summary.totalVoidedPayment)}</strong>
            </span>
          </div>

          {/* SUPPLIER WISE SUMMARY */}
          <h3 style={{ margin: "25px 0 12px" }}>
            Supplier-wise Summary
          </h3>

          <div className="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>SUPPLIER</th>
                  <th>ADDRESS</th>
                  <th>MOBILE</th>
                  <th>TRANSACTIONS</th>
                  <th>TOTAL PURCHASE</th>
                  <th>TOTAL PAYMENT</th>
                  <th>PURCHASE RETURN</th>
                  <th>DEBIT</th>
                  <th>CREDIT</th>
                  <th>NET BALANCE</th>
                </tr>
              </thead>

              <tbody>
                {supplierSummary.map((s, index) => (
                  <tr key={s.supplierId || index}>
                    <td><strong>{s.supplierName}</strong></td>
                   <td>{s.address || "-"}</td>
                    <td>{s.mobile || "-"}</td>
                    <td>{s.transactionCount}</td>
                    <td>{money(s.totalPurchase)}</td>
                    <td style={{ color: "#16a34a" }}>
                      {money(s.totalPayment)}
                    </td>
                    <td>{money(s.totalPurchaseReturn)}</td>
                    <td>{money(s.totalDebit)}</td>
                    <td>{money(s.totalCredit)}</td>
                    <td
  style={{
    color:
      Number(s.totalDebit || 0) - Number(s.totalCredit || 0) > 0
        ? "#dc2626"
        : "#16a34a",
    fontWeight: 700,
  }}
>
  {money(
    Number(s.totalDebit || 0) - Number(s.totalCredit || 0)
  )}
  <small style={{ display: "block", fontWeight: 400 }}>
    {Number(s.totalDebit || 0) - Number(s.totalCredit || 0) > 0
      ? "Payable"
      : Number(s.totalDebit || 0) - Number(s.totalCredit || 0) < 0
      ? "Advance"
      : "Settled"}
  </small>
</td>
                  </tr>
                ))}
{supplierSummary.length > 0 && (
  <tr style={{ background: "#f1f5f9", fontWeight: 700 }}>
    <td colSpan="3">GRAND TOTAL</td>
    <td>{summary.totalTransactions || 0}</td>
    <td>{money(summary.totalPurchase)}</td>
    <td>{money(summary.totalPayment)}</td>
    <td>{money(summary.totalPurchaseReturn)}</td>
    <td>{money(summary.totalDebit)}</td>
    <td>{money(summary.totalCredit)}</td>
    <td>{money(netSupplierBalance)}</td>
  </tr>
)}
                {supplierSummary.length === 0 && (
                  <tr>
                    <td colSpan="8" style={{ textAlign: "center", padding: 20 }}>
                      No supplier records found
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          {/* ALL TRANSACTIONS */}
          <h3 style={{ margin: "28px 0 12px" }}>
            All Supplier Transactions
          </h3>

          <div className="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>DATE</th>
                  <th>SUPPLIER</th>
                  <th>TYPE</th>
                  <th>LOT NUMBER</th>
                  <th>DESCRIPTION</th>
                  <th>METHOD</th>
                  <th>DEBIT</th>
                  <th>CREDIT</th>
                  <th>STATUS</th>
                </tr>
              </thead>

              <tbody>
                {reportTransactions.map((item) => (
                  <tr key={item._id}>
                    <td>
                      {item.transactionDate
                        ? new Date(item.transactionDate).toLocaleDateString("en-GB")
                        : "-"}
                    </td>
                    <td>
                      <strong>{item.supplierName || "Unknown Supplier"}</strong>
                    </td>
                    <td>{transactionLabel(item.type)}</td>
                    <td>{item.lotCode || "-"}</td>
                    <td>{item.description || item.reference || "-"}</td>
                    <td>{item.paymentMethod || "-"}</td>
                    <td>{money(item.debit)}</td>
                    <td>{money(item.credit)}</td>
                    <td>
                      {item.isVoided ? (
                        <span style={{ color: "#dc2626", fontWeight: 600 }}>
                          VOIDED
                        </span>
                      ) : (
                        <span style={{ color: "#16a34a" }}>
                          Active
                        </span>
                      )}
                    </td>
                  </tr>
                ))}

                {reportTransactions.length === 0 && (
                  <tr>
                    <td colSpan="10" style={{ textAlign: "center", padding: 20 }}>
                      No transactions found
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </>
      )}

      {!allSupplierReportLoading && !report && (
        <div style={{
          textAlign: "center",
          padding: 35,
          color: "#64748b",
        }}>
          Apply filters to load the supplier report.
        </div>
      )}
    </div>
  );
}

function renderAllCustomerReport() {
  const report = allCustomerReport;
  const summary = report?.summary || {};
  const customerSummary = report?.customerSummary || [];
  const reportTransactions = report?.transactions || [];

 const netCustomerBalance = Number(
  summary.netCustomerBalance ??
  (
    Number(summary.totalOpeningBalance || 0) +
    Number(summary.totalDebit || 0) -
    Number(summary.totalCredit || 0)
  )
);

  const updateFilter = (key, value) => {
    setAllCustomerReportFilters((prev) => ({
      ...prev,
      [key]: value,
    }));
  };

  const clearFilters = () => {
    const emptyFilters = {
      startDate: "",
      endDate: "",
      customerId: "",
      type: "",
      paymentMethod: "",
      minAmount: "",
      maxAmount: "",
      search: "",
    };

    setAllCustomerReportFilters(emptyFilters);
    setCustomerReportSearch("");
    setShowCustomerReportCustomerOptions(false);
    loadAllCustomerReport(emptyFilters);
  };

  const selectedCustomer = customers.find(
    (c) => c._id === allCustomerReportFilters.customerId
  );

  const filteredCustomerOptions = customers
    .filter((c) => c.isActive !== false)
    .filter((c) =>
      (c.customerName || "")
        .toLowerCase()
        .includes(customerReportSearch.trim().toLowerCase())
    );

  const money = (value) =>
    `à§³ ${Number(value || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    })}`;

  const transactionLabel = (type) => {
    const labels = {
      SALE: "Sale",
      SALE_RETURN: "Sale Return",
      PAYMENT: "Customer Payment",
      ADJUSTMENT: "Adjustment",
    };

    return labels[type] || type || "-";
  };

  const downloadAllCustomerReportCSV = () => {
    const escapeCSV = (value) =>
      `"${String(value ?? "").replace(/"/g, '""')}"`;

    const rows = [
      ["ALL CUSTOMER REPORT"],
      ["Report Generated", new Date().toLocaleString("en-BD")],
      [],
      ["CUSTOMER-WISE SUMMARY"],
      [
        "Customer",
        "Company",
        "Mobile",
        "Address",
        "Transactions",
        "Total Sales",
        "Total Payment",
        "Sales Return",
        "Debit",
        "Credit",
        "Net Balance",
      ],

      ...customerSummary.map((c) => [
        c.customerName,
        c.companyName,
        c.mobile,
        c.address,
        c.transactionCount,
        c.totalSales,
        c.totalPayment,
        c.totalSalesReturn,
        c.totalDebit,
        c.totalCredit,
        Number(c.totalDebit || 0) - Number(c.totalCredit || 0),
      ]),

      [
        "GRAND TOTAL",
        "",
        "",
        "",
        summary.totalTransactions || 0,
        summary.totalSales || 0,
        summary.totalPayment || 0,
        summary.totalSalesReturn || 0,
        summary.totalDebit || 0,
        summary.totalCredit || 0,
        netCustomerBalance,
      ],

      [],
      ["ALL CUSTOMER TRANSACTIONS"],
      [
        "Date",
        "Customer",
        "Type",
        "Transaction ID",
        "Description",
        "Payment Method",
        "Debit",
        "Credit",
        "Status",
      ],

      ...reportTransactions.map((item) => [
        item.transactionDate
          ? new Date(item.transactionDate).toLocaleDateString("en-GB")
          : "",
        item.customerName || "Unknown Customer",
        transactionLabel(item.type),
        item.transactionId || item.reference,
        item.description || item.reference,
        item.paymentMethod,
        item.debit,
        item.credit,
        item.isVoided ? "VOIDED" : "Active",
      ]),
    ];

    const csvContent =
      "\uFEFF" +
      rows.map((row) => row.map(escapeCSV).join(",")).join("\r\n");

    const blob = new Blob([csvContent], {
      type: "text/csv;charset=utf-8;",
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "all-customer-report.csv";
    link.click();

    URL.revokeObjectURL(url);
  };

  return (
    <div className="panel all-customer-report-print" style={{ padding: 22 }}>
      {/* HEADER */}
      <div
        style={{
          ...pageHeaderStyle,
          flexWrap: "wrap",
          gap: 12,
        }}
      >
        <div>
          <h2 style={{ margin: 0 }}>All Customer Report</h2>

          <p style={{ color: "#7b8494", margin: "6px 0 0" }}>
            All customers transaction summary and details
          </p>

          <p
            style={{
              color: "#64748b",
              fontSize: 12,
              margin: "5px 0 0",
            }}
          >
            Report Generated: {new Date().toLocaleString("en-BD")}
          </p>
        </div>

        <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
          <button
            className="secondary-button"
            onClick={() => window.print()}
            disabled={!report}
          >
            <Printer size={17} /> Print / PDF
          </button>

          <button
            className="secondary-button"
            onClick={downloadAllCustomerReportCSV}
            disabled={!report || reportTransactions.length === 0}
          >
            <Download size={17} /> Export CSV
          </button>

          <button
            className="secondary-button"
            onClick={() => setActivePage("Customers")}
          >
            Back to Customers
          </button>
        </div>
      </div>

      {/* FILTER PANEL */}
      <div
        className="all-customer-report-filter"
        style={{
          marginTop: 20,
          padding: 18,
          border: "1px solid #e2e8f0",
          borderRadius: 12,
          background: "#f8fafc",
        }}
      >
        <h3 style={{ margin: "0 0 15px", fontSize: 16 }}>
          Report Filters
        </h3>

        <div
          style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(190px, 1fr))",
            gap: 14,
          }}
        >
          {/* START DATE */}
          <div>
            <label style={fieldStyle}>Start Date</label>
            <input
              type="date"
              style={inputStyle}
              value={allCustomerReportFilters.startDate}
              onChange={(e) => updateFilter("startDate", e.target.value)}
            />
          </div>

          {/* END DATE */}
          <div>
            <label style={fieldStyle}>End Date</label>
            <input
              type="date"
              style={inputStyle}
              value={allCustomerReportFilters.endDate}
              onChange={(e) => updateFilter("endDate", e.target.value)}
            />
          </div>

          {/* SEARCHABLE CUSTOMER */}
          <div style={{ position: "relative" }}>
            <label style={fieldStyle}>Customer</label>

            <input
              style={inputStyle}
              placeholder="Search customer name..."
              value={
                showCustomerReportCustomerOptions
                  ? customerReportSearch
                  : selectedCustomer?.customerName || "All Customers"
              }
              onFocus={() => {
                setCustomerReportSearch("");
                setShowCustomerReportCustomerOptions(true);
              }}
              onChange={(e) => {
                setCustomerReportSearch(e.target.value);
                setShowCustomerReportCustomerOptions(true);
              }}
              onBlur={() => {
                setTimeout(() => {
                  setShowCustomerReportCustomerOptions(false);
                }, 150);
              }}
            />

            {showCustomerReportCustomerOptions && (
              <div
                style={{
                  position: "absolute",
                  top: "100%",
                  left: 0,
                  right: 0,
                  zIndex: 100,
                  background: "#fff",
                  border: "1px solid #dce1e8",
                  borderRadius: 8,
                  maxHeight: 230,
                  overflowY: "auto",
                  boxShadow: "0 5px 15px rgba(0,0,0,0.10)",
                }}
              >
                <div
                  onMouseDown={() => {
                    updateFilter("customerId", "");
                    setCustomerReportSearch("");
                    setShowCustomerReportCustomerOptions(false);
                  }}
                  style={{
                    padding: "11px 12px",
                    cursor: "pointer",
                    borderBottom: "1px solid #eee",
                    fontSize: 14,
                    fontWeight: 600,
                  }}
                >
                  All Customers
                </div>

                {filteredCustomerOptions.map((c) => (
                  <div
                    key={c._id}
                    onMouseDown={() => {
                      updateFilter("customerId", c._id);
                      setCustomerReportSearch("");
                      setShowCustomerReportCustomerOptions(false);
                    }}
                    style={{
                      padding: "11px 12px",
                      cursor: "pointer",
                      borderBottom: "1px solid #f1f5f9",
                      fontSize: 14,
                    }}
                  >
                    {c.customerName}
                  </div>
                ))}

                {filteredCustomerOptions.length === 0 && (
                  <div
                    style={{
                      padding: 12,
                      color: "#64748b",
                      fontSize: 13,
                    }}
                  >
                    No customer found
                  </div>
                )}
              </div>
            )}
          </div>

          {/* TRANSACTION TYPE */}
          <div>
            <label style={fieldStyle}>Transaction Type</label>
            <select
              style={inputStyle}
              value={allCustomerReportFilters.type}
              onChange={(e) => updateFilter("type", e.target.value)}
            >
              <option value="">All Types</option>
              <option value="SALE">Sale</option>
              <option value="SALE_RETURN">Sale Return</option>
              <option value="PAYMENT">Customer Payment</option>
              <option value="ADJUSTMENT">Adjustment</option>
            </select>
          </div>

          {/* PAYMENT METHOD */}
          <div>
            <label style={fieldStyle}>Payment Method</label>
            <select
              style={inputStyle}
              value={allCustomerReportFilters.paymentMethod}
              onChange={(e) => updateFilter("paymentMethod", e.target.value)}
            >
              <option value="">All Methods</option>
              <option value="CASH">Cash</option>
              <option value="BANK">Bank</option>
              <option value="BKASH">bKash</option>
              <option value="NAGAD">Nagad</option>
              <option value="ROCKET">Rocket</option>
              <option value="OTHER">Other</option>
            </select>
          </div>

          {/* MINIMUM AMOUNT */}
          <div>
            <label style={fieldStyle}>Minimum Amount</label>
            <input
              type="number"
              min="0"
              style={inputStyle}
              placeholder="Minimum amount"
              value={allCustomerReportFilters.minAmount}
              onChange={(e) => updateFilter("minAmount", e.target.value)}
            />
          </div>

          {/* MAXIMUM AMOUNT */}
          <div>
            <label style={fieldStyle}>Maximum Amount</label>
            <input
              type="number"
              min="0"
              style={inputStyle}
              placeholder="Maximum amount"
              value={allCustomerReportFilters.maxAmount}
              onChange={(e) => updateFilter("maxAmount", e.target.value)}
            />
          </div>

          {/* GENERAL SEARCH */}
          <div>
            <label style={fieldStyle}>Search</label>
            <input
              style={inputStyle}
              placeholder="Customer / Transaction ID"
              value={allCustomerReportFilters.search}
              onChange={(e) => updateFilter("search", e.target.value)}
            />
          </div>
        </div>

        {/* FILTER BUTTONS */}
        <div
          style={{
            display: "flex",
            gap: 10,
            marginTop: 16,
            flexWrap: "wrap",
          }}
        >
          <button
            className="primary-button"
            disabled={allCustomerReportLoading}
            onClick={() => loadAllCustomerReport()}
          >
            {allCustomerReportLoading ? "Loading..." : "Apply Filter"}
          </button>

          <button
            className="secondary-button"
            onClick={clearFilters}
            disabled={allCustomerReportLoading}
          >
            Clear Filter
          </button>
        </div>
      </div>

      {/* LOADING */}
      {allCustomerReportLoading && (
        <p style={{ textAlign: "center", padding: 25 }}>
          Loading customer report...
        </p>
      )}

      {/* REPORT DATA */}
      {!allCustomerReportLoading && report && (
        <>
          {/* SUMMARY CARDS */}
          <div
            style={{
              display: "grid",
              gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
              gap: 14,
              marginTop: 20,
            }}
          >
            {[
              {
                title: "Total Customers",
                value: summary.customerCount || 0,
                color: "#2563eb",
              },
              {
                title: "Total Sales",
                value: money(summary.totalSales),
                color: "#2563eb",
              },
              {
                title: "Total Payment",
                value: money(summary.totalPayment),
                color: "#16a34a",
              },
              {
                title: "Net Customer Balance",
                value: money(Math.abs(netCustomerBalance)),
                subtitle:
                  netCustomerBalance > 0
                    ? "Receivable from Customers"
                    : netCustomerBalance < 0
                    ? "Customer Advance"
                    : "Fully Settled",
                color:
                  netCustomerBalance > 0 ? "#dc2626" : "#16a34a",
              },
              {
                title: "Sales Return",
                value: money(summary.totalSalesReturn),
                color: "#d97706",
              },
              {
                title: "Adjustment Debit",
                value: money(summary.totalAdjustmentDebit),
                color: "#64748b",
              },
              {
                title: "Adjustment Credit",
                value: money(summary.totalAdjustmentCredit),
                color: "#64748b",
              },
            ].map((item) => (
              <div
                key={item.title}
                style={{
                  padding: 17,
                  border: "1px solid #e2e8f0",
                  borderRadius: 10,
                  background: "#fff",
                }}
              >
                <p
                  style={{
                    margin: 0,
                    color: "#64748b",
                    fontSize: 13,
                  }}
                >
                  {item.title}
                </p>

                <h3
                  style={{
                    margin: "9px 0 0",
                    color: item.color,
                    fontSize: 19,
                  }}
                >
                  {item.value}
                </h3>

                {item.subtitle && (
                  <p
                    style={{
                      margin: "6px 0 0",
                      fontSize: 12,
                      color: item.color,
                      fontWeight: 600,
                    }}
                  >
                    {item.subtitle}
                  </p>
                )}
              </div>
            ))}
          </div>

          {/* TOTALS */}
          <div
            style={{
              display: "flex",
              gap: 20,
              flexWrap: "wrap",
              margin: "16px 0 22px",
              color: "#64748b",
              fontSize: 13,
            }}
          >
            <span>
              Total Transactions:{" "}
              <strong>{summary.totalTransactions || 0}</strong>
            </span>

            <span>
              Total Debit: <strong>{money(summary.totalDebit)}</strong>
            </span>

            <span>
              Total Credit: <strong>{money(summary.totalCredit)}</strong>
            </span>

            <span>
              Voided Payments:{" "}
              <strong>{money(summary.totalVoidedPayment)}</strong>
            </span>
          </div>

          {/* CUSTOMER WISE SUMMARY */}
          <h3 style={{ margin: "25px 0 12px" }}>
            Customer-wise Summary
          </h3>

          <div className="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>CUSTOMER</th>
                  <th>COMPANY</th>
                  <th>ADDRESS</th>
                  <th>MOBILE</th>
                  <th>TRANSACTIONS</th>
                  <th>TOTAL SALES</th>
                  <th>TOTAL PAYMENT</th>
                  <th>SALES RETURN</th>
                  <th>DEBIT</th>
                  <th>CREDIT</th>
                  <th>NET BALANCE</th>
                </tr>
              </thead>

              <tbody>
                {customerSummary.map((c, index) => {
                 const balance = Number(c.netBalance || 0);

                  return (
                    <tr key={c.customerId || index}>
                      <td>
                        <strong>{c.customerName}</strong>
                      </td>

                      <td>{c.companyName || "-"}</td>
                      <td>{c.address || "-"}</td>
                      <td>{c.mobile || "-"}</td>
                      <td>{c.transactionCount}</td>
                      <td>{money(c.totalSales)}</td>

                      <td style={{ color: "#16a34a" }}>
                        {money(c.totalPayment)}
                      </td>

                      <td>{money(c.totalSalesReturn)}</td>
                      <td>{money(c.totalDebit)}</td>
                      <td>{money(c.totalCredit)}</td>

                      <td
                        style={{
                          color:
                            balance > 0 ? "#dc2626" : "#16a34a",
                          fontWeight: 700,
                        }}
                      >
                        {money(balance)}

                        <small
                          style={{
                            display: "block",
                            fontWeight: 400,
                          }}
                        >
                          {balance > 0
                            ? "Receivable"
                            : balance < 0
                            ? "Advance"
                            : "Settled"}
                        </small>
                      </td>
                    </tr>
                  );
                })}

                {customerSummary.length > 0 && (
                  <tr
                    style={{
                      background: "#f1f5f9",
                      fontWeight: 700,
                    }}
                  >
                    <td colSpan="4">GRAND TOTAL</td>
                    <td>{summary.totalTransactions || 0}</td>
                    <td>{money(summary.totalSales)}</td>
                    <td>{money(summary.totalPayment)}</td>
                    <td>{money(summary.totalSalesReturn)}</td>
                    <td>{money(summary.totalDebit)}</td>
                    <td>{money(summary.totalCredit)}</td>
                    <td>{money(netCustomerBalance)}</td>
                  </tr>
                )}

                {customerSummary.length === 0 && (
                  <tr>
                    <td
                      colSpan="11"
                      style={{ textAlign: "center", padding: 20 }}
                    >
                      No customer records found
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          {/* ALL TRANSACTIONS */}
          <h3 style={{ margin: "28px 0 12px" }}>
            All Customer Transactions
          </h3>

          <div className="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>DATE</th>
                  <th>CUSTOMER</th>
                  <th>TYPE</th>
                  <th>TRANSACTION ID</th>
                  <th>DESCRIPTION</th>
                  <th>METHOD</th>
                  <th>DEBIT</th>
                  <th>CREDIT</th>
                  <th>STATUS</th>
                </tr>
              </thead>

              <tbody>
                {reportTransactions.map((item) => (
                  <tr key={item._id}>
                    <td>
                      {item.transactionDate
                        ? new Date(
                            item.transactionDate
                          ).toLocaleDateString("en-GB")
                        : "-"}
                    </td>

                    <td>
                      <strong>
                        {item.customerName || "Unknown Customer"}
                      </strong>
                    </td>

                    <td>{transactionLabel(item.type)}</td>

                    <td>{item.transactionId || "-"}</td>

                    <td>
                      {item.description || item.reference || "-"}
                    </td>

                    <td>{item.paymentMethod || "-"}</td>
                    <td>{money(item.debit)}</td>
                    <td>{money(item.credit)}</td>

                    <td>
                      {item.isVoided ? (
                        <span
                          style={{
                            color: "#dc2626",
                            fontWeight: 600,
                          }}
                        >
                          VOIDED
                        </span>
                      ) : (
                        <span style={{ color: "#16a34a" }}>
                          Active
                        </span>
                      )}
                    </td>
                  </tr>
                ))}

                {reportTransactions.length === 0 && (
                  <tr>
                    <td
                      colSpan="9"
                      style={{ textAlign: "center", padding: 20 }}
                    >
                      No transactions found
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </>
      )}

      {!allCustomerReportLoading && !report && (
        <div
          style={{
            textAlign: "center",
            padding: 35,
            color: "#64748b",
          }}
        >
          Apply filters to load the customer report.
        </div>
      )}
    </div>
  );
}

function renderSuppliers() {
  return (
    <div className="panel" style={{ padding: 22 }}>
      <div style={pageHeaderStyle}>
        <div>
          <h2 style={{ margin: 0 }}>Supplier List</h2>
          <p style={{ color: "#7b8494", margin: "6px 0 0" }}>
            Total Suppliers: {suppliers.length}
          </p>
        </div>

               <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>
          <button
            className="secondary-button"
            onClick={() => {
              setActivePage("Supplier Report");
              loadAllSupplierReport();
            }}
          >
            <BarChart3 size={18} /> All Supplier Report
          </button>

          <button
            className="primary-button"
            onClick={() => openSupplierForm()}
          >
            <Plus size={18} /> Add Supplier
          </button>
        </div>
      </div>

      <input
        style={{ ...inputStyle, maxWidth: 350, margin: "15px 0" }}
        placeholder="Search supplier name or mobile..."
        value={searchText}
        onChange={(e) => setSearchText(e.target.value)}
      />

      {loading ? (
        <p>Loading suppliers...</p>
      ) : (
        <div className="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>SUPPLIER NAME</th>
                <th>COMPANY</th>
                <th>MOBILE</th>
                <th>CONTACT PERSON</th>
                <th>OPENING BALANCE</th>
                <th>CURRENT BALANCE</th>
                <th>PAYMENT</th>
                <th>LEDGER</th>
                <th>STATEMENT</th>
                <th>ACTION</th>
              </tr>
            </thead>

            <tbody>
              {filteredSuppliers
                .filter((s) => s.isActive !== false)
                .map((s) => (
                  <tr key={s._id}>
                    <td>
                      <strong>{s.supplierName}</strong>
                    </td>

                    <td>{s.companyName || "-"}</td>
                    <td>{s.mobile || "-"}</td>
                    <td>{s.contactPerson || "-"}</td>

                    <td>
                      à§³ {Number(s.openingBalance || 0).toLocaleString("en-BD")}
                    </td>

                    <td>
                      <strong
                        style={{
                          color:
                            Number(s.currentBalance || 0) > 0
                              ? "#dc2626"
                              : Number(s.currentBalance || 0) < 0
                              ? "#16a34a"
                              : "#64748b",
                        }}
                      >
                        à§³ {Number(s.currentBalance || 0).toLocaleString("en-BD", {
                          minimumFractionDigits: 2,
                          maximumFractionDigits: 2,
                        })}
                      </strong>
                    </td>

                    <td>
                      <button
                        className="primary-button"
                        onClick={() => openSupplierPayment(s)}
                        style={{
                          padding: "7px 12px",
                          fontSize: 12,
                        }}
                      >
                        Payment
                      </button>
                    </td>

                    <td>
                      <button
                        className="secondary-button"
                        onClick={() => loadSupplierLedger(s)}
                        style={{
                          padding: "7px 12px",
                          fontSize: 12,
                        }}
                      >
                        Ledger
                      </button>
                    </td>

<td>
  <button
    className="secondary-button"
    onClick={() => {
      setStatementStartDate("");
      setStatementEndDate("");
      loadSupplierStatement(s, "", "");
    }}
    style={{
      padding: "7px 12px",
      fontSize: 12,
    }}
  >
    Statement
  </button>
</td>

                    <td>
                      <button
                        style={actionButtonStyle}
                        onClick={() => openSupplierForm(s)}
                        title="Edit"
                      >
                        <Edit size={16} />
                      </button>

                      <button
                        style={actionButtonStyle}
                        onClick={() => deactivateSupplier(s)}
                        title="Deactivate"
                      >
                        <Trash2 size={16} />
                      </button>
                    </td>
                  </tr>
                ))}

              {filteredSuppliers.filter(
                (s) => s.isActive !== false
              ).length === 0 && (
                <tr>
                  <td
                    colSpan="10"
                    style={{
                      textAlign: "center",
                      padding: 25,
                    }}
                  >
                    No suppliers found
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}

function renderCustomers() {
  const activeCustomerList = customers.filter(
    (c) => c.isActive !== false
  );

  const totalCustomerDue = activeCustomerList.reduce(
    (total, c) => {
      const balance = Number(c.currentBalance || 0);
      return total + (balance > 0 ? balance : 0);
    },
    0
  );

  const zeroDueCustomers = activeCustomerList.filter(
    (c) => Number(c.currentBalance || 0) === 0
  ).length;

  return (
    <div className="panel" style={{ padding: 22 }}>
      <div style={pageHeaderStyle}>
        <div>
          <h2 style={{ margin: 0 }}>Customer List</h2>
          <p style={{ color: "#7b8494", margin: "6px 0 0" }}>
            Total Customers: {customers.length}
          </p>
        </div>

    <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>
  <button
    className="secondary-button"
    onClick={() => {
      loadAllCustomerReport();
      setActivePage("All Customer Report");
    }}
  >
     <FileText size={18} /> All Customer Report
  </button>

  <button
    className="primary-button"
    onClick={() => openCustomerForm()}
  >
    <Plus size={18} /> Add Customer
  </button>
</div>
      </div>
      {/* CUSTOMER SUMMARY */}
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
          gap: 14,
          margin: "20px 0",
        }}
      >
        <div style={{
          background: "#eff6ff",
          padding: 18,
          borderRadius: 10,
          border: "1px solid #bfdbfe",
        }}>
          <p style={{ margin: 0, color: "#1d4ed8" }}>Total Customers</p>
          <h2 style={{ margin: "8px 0 0", color: "#1e40af" }}>
            {activeCustomerList.length}
          </h2>
        </div>

        <div style={{
          background: "#fef2f2",
          padding: 18,
          borderRadius: 10,
          border: "1px solid #fecaca",
        }}>
          <p style={{ margin: 0, color: "#dc2626" }}>Total Customer Due</p>
          <h2 style={{ margin: "8px 0 0", color: "#b91c1c" }}>
            à§³ {totalCustomerDue.toLocaleString("en-BD", {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2,
            })}
          </h2>
        </div>

        <div style={{
          background: "#f0fdf4",
          padding: 18,
          borderRadius: 10,
          border: "1px solid #bbf7d0",
        }}>
          <p style={{ margin: 0, color: "#15803d" }}>Zero Due Customers</p>
          <h2 style={{ margin: "8px 0 0", color: "#166534" }}>
            {zeroDueCustomers}
          </h2>
        </div>
      </div>
      <input
        style={{ ...inputStyle, maxWidth: 350, margin: "15px 0" }}
        placeholder="Search customer name or mobile..."
        value={customerSearch}
        onChange={(e) => setCustomerSearch(e.target.value)}
      />

      {customerLoading ? (
        <p>Loading customers...</p>
      ) : (
        <div className="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>CUSTOMER NAME</th>
                <th>COMPANY</th>
                <th>MOBILE</th>
                <th>CONTACT PERSON</th>
                <th>CUSTOMER TYPE</th>
                <th>OPENING BALANCE</th>
                <th>CURRENT BALANCE</th>
                <th>PAYMENT</th>
                <th>LEDGER</th>
                <th>STATEMENT</th>
                <th>ACTION</th>
              </tr>
            </thead>

            <tbody>
              {filteredCustomers
                .filter((c) => c.isActive !== false)
                .map((c) => (
                  <tr key={c._id}>
                    <td><strong>{c.customerName}</strong></td>
                    <td>{c.companyName || "-"}</td>
                    <td>{c.mobile || "-"}</td>
                    <td>{c.contactPerson || "-"}</td>
                    <td>{c.customerType || "REGULAR"}</td>

                    <td>
                      à§³ {Number(c.openingBalance || 0).toLocaleString("en-BD")}
                    </td>

                    <td>
                      <strong
                        style={{
                          color:
                            Number(c.currentBalance || 0) > 0
                              ? "#dc2626"
                              : Number(c.currentBalance || 0) < 0
                              ? "#16a34a"
                              : "#64748b",
                        }}
                      >
                        à§³ {Number(c.currentBalance || 0).toLocaleString(
                          "en-BD",
                          {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2,
                          }
                        )}
                      </strong>
                    </td>

                    <td>
                      <button
                        className="primary-button"
                        onClick={() => openCustomerPayment(c)}
                        style={{ padding: "7px 12px", fontSize: 12 }}
                      >
                        Payment
                      </button>
                    </td>

                    <td>
                      <button
                        className="secondary-button"
                        onClick={() => loadCustomerLedger(c)}
                        style={{ padding: "7px 12px", fontSize: 12 }}
                      >
                        Ledger
                      </button>
                    </td>

                    <td>
                      <button
                        className="secondary-button"
                        onClick={() => loadCustomerStatement(c, "", "")}
                        style={{ padding: "7px 12px", fontSize: 12 }}
                      >
                        Statement
                      </button>
                    </td>

                    <td>
                      <button
                        style={actionButtonStyle}
                        onClick={() => openCustomerForm(c)}
                        title="Edit"
                      >
                        <Edit size={16} />
                      </button>

                      <button
                        style={actionButtonStyle}
                        onClick={() => deactivateCustomer(c)}
                        title="Deactivate"
                      >
                        <Trash2 size={16} />
                      </button>
                    </td>
                  </tr>
                ))}

              {filteredCustomers.filter(
                (c) => c.isActive !== false
              ).length === 0 && (
                <tr>
                  <td
                    colSpan="11"
                    style={{ textAlign: "center", padding: 25 }}
                  >
                    No customers found
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}
// ========================================
// CUSTOMER DUE SUMMARY
// ========================================

function renderCustomerDueSummary() {
  const formatMoney = (amount) =>
    Number(amount || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

  const handleSearch = () => {
    loadCustomerDueSummary({
      startDate: dueStartDate,
      endDate: dueEndDate,
      search: dueCustomerSearch,
      address: dueCustomerAddress,
    });
  };

  const handlePrint = () => {
    const printWindow = window.open("", "_blank");

    if (!printWindow) {
      toast.error("Please allow popups to print");
      return;
    }

    const rows = dueSummaryCustomers.map((c, index) => `
      <tr>
        <td>${index + 1}</td>
        <td>${c.customerName || "-"}</td>
        <td>${c.companyName || "-"}</td>
        <td>${c.mobile || "-"}</td>
        <td>${c.address || "-"}</td>
        <td style="text-align:right">
          ${formatMoney(c.openingDueAtStart)}
        </td>
        <td style="text-align:right">
          ${formatMoney(c.currentBalance)}
        </td>
      </tr>
    `).join("");

    printWindow.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Customer Due Summary</title>
        <style>
          body {
            font-family: Arial, sans-serif;
            padding: 20px;
          }
          h2 { text-align: center; }
          table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
          }
          th, td {
            border: 1px solid #999;
            padding: 8px;
            font-size: 12px;
          }
          th { background: #eee; }
          .total {
            margin-top: 15px;
            text-align: right;
            font-weight: bold;
          }
        </style>
      </head>
      <body>
        <h2>Customer Due Summary</h2>
        <p>
          Period: ${dueStartDate || "Beginning"} -
          ${dueEndDate || "Today"}
        </p>
        <table>
          <thead>
            <tr>
              <th>SL</th>
              <th>Customer</th>
              <th>Company</th>
              <th>Mobile</th>
              <th>Address</th>
              <th>Opening Due</th>
              <th>Closing Due</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
        <div class="total">
          Total Due Customers: ${dueSummary.totalDueCustomers || 0}
          <br />
          Total Customer Due: à§³ ${formatMoney(dueSummary.totalDueAmount)}
        </div>
        <script>
          window.onload = function() {
            window.print();
            window.onafterprint = function() {
              window.close();
            };
          };
        </script>
      </body>
      </html>
    `);

    printWindow.document.close();
  };

  return (
    <div className="panel" style={{ padding: 22 }}>
      <div style={pageHeaderStyle}>
        <div>
          <h2 style={{ margin: 0 }}>Customer Due Summary</h2>
          <p style={{ color: "#7b8494", margin: "6px 0 0" }}>
            Customers with outstanding balance
          </p>
        </div>

        <button
          className="secondary-button"
          onClick={handlePrint}
        >
          <FileText size={18} /> Print
        </button>
      </div>

      {/* SUMMARY CARDS */}
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
          gap: 14,
          margin: "20px 0",
        }}
      >
        <div style={{
          background: "#eff6ff",
          padding: 18,
          borderRadius: 10,
          border: "1px solid #bfdbfe",
        }}>
          <p style={{ margin: 0, color: "#1d4ed8" }}>
            Total Due Customers
          </p>
          <h2 style={{ margin: "8px 0 0", color: "#1e40af" }}>
            {dueSummary.totalDueCustomers || 0}
          </h2>
        </div>

        <div style={{
          background: "#fef2f2",
          padding: 18,
          borderRadius: 10,
          border: "1px solid #fecaca",
        }}>
          <p style={{ margin: 0, color: "#dc2626" }}>
            Total Customer Due
          </p>
          <h2 style={{ margin: "8px 0 0", color: "#b91c1c" }}>
            à§³ {formatMoney(dueSummary.totalDueAmount)}
          </h2>
        </div>
      </div>

      {/* FILTERS */}
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
          gap: 12,
          margin: "20px 0",
          alignItems: "end",
        }}
      >
        <div>
          <label>Start Date</label>
          <input
            type="date"
            style={inputStyle}
            value={dueStartDate}
            onChange={(e) => setDueStartDate(e.target.value)}
          />
        </div>

        <div>
          <label>End Date</label>
          <input
            type="date"
            style={inputStyle}
            value={dueEndDate}
            onChange={(e) => setDueEndDate(e.target.value)}
          />
        </div>

        <div>
          <label>Customer Name / Mobile</label>
          <input
            style={inputStyle}
            placeholder="Search customer..."
            value={dueCustomerSearch}
            onChange={(e) => setDueCustomerSearch(e.target.value)}
          />
        </div>

        <div>
          <label>Customer Address</label>
          <input
            style={inputStyle}
            placeholder="Search address..."
            value={dueCustomerAddress}
            onChange={(e) => setDueCustomerAddress(e.target.value)}
          />
        </div>

        <div style={{ display: "flex", gap: 8 }}>
          <button
            className="primary-button"
            onClick={handleSearch}
          >
            Search
          </button>

          <button
            className="secondary-button"
            onClick={() => {
              setDueStartDate("");
              setDueEndDate("");
              setDueCustomerSearch("");
              setDueCustomerAddress("");

              loadCustomerDueSummary({});
            }}
          >
            Reset
          </button>
        </div>
      </div>

      {/* CUSTOMER TABLE */}
      {dueSummaryLoading ? (
        <p>Loading customer due summary...</p>
      ) : (
        <div className="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>CUSTOMER NAME</th>
                <th>COMPANY</th>
                <th>MOBILE</th>
                <th>ADDRESS</th>
                <th>OPENING DUE</th>
                <th>CURRENT DUE</th>
                <th>POCKET LIST</th>
                <th>PAYMENT</th>
           
              </tr>
            </thead>

            <tbody>
              {dueSummaryCustomers.map((c) => (
                <tr key={c._id}>
                  <td>
                    <strong>{c.customerName}</strong>
                  </td>

                  <td>{c.companyName || "-"}</td>
                  <td>{c.mobile || "-"}</td>
                  <td>{c.address || "-"}</td>

                  <td>
                    à§³ {formatMoney(c.openingDueAtStart)}
                  </td>

                  <td>
                    <strong style={{ color: "#dc2626" }}>
                      à§³ {formatMoney(c.currentBalance)}
                    </strong>
                  </td>

                  <td>
                    <button
                      className="secondary-button"
                      onClick={() => loadCustomerLedger(c)}
                      style={{ padding: "7px 12px", fontSize: 12 }}
                    >
                      Ladger
                    </button>
                  </td>

                  <td>
                    <button
                      className="primary-button"
                      onClick={() => openCustomerPayment(c)}
                      style={{ padding: "7px 12px", fontSize: 12 }}
                    >
                      Payment
                    </button>
                  </td>

                  
                </tr>
              ))}

              {dueSummaryCustomers.length === 0 && (
                <tr>
                  <td
                    colSpan="8"
                    style={{ textAlign: "center", padding: 25 }}
                  >
                    No customers with outstanding due found
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}
function renderProductModal() {
  return (
    <div style={modalOverlayStyle}>
      <div style={modalStyle}>
        <div style={modalHeaderStyle}>
          <h2 style={{ margin: 0 }}>
            {editingId ? "Edit Product" : "Add New Product"}
          </h2>

          <button
            style={closeButtonStyle}
            onClick={() => setShowForm(false)}
          >
            <X />
          </button>
        </div>

        <form onSubmit={saveProduct}>
          <div style={formGridStyle}>

            {/* Product Name */}
            <Field label="Product Name *">
              <input
                style={inputStyle}
                required
                value={productForm.productName}
                onChange={(e) =>
                  setProductForm({
                    ...productForm,
                    productName: e.target.value,
                    category: "",
                    subcategory: "",
                  })
                }
                placeholder="Example: Onion"
              />
            </Field>

            {/* Category Dropdown */}
            <Field label="Category *">
              <select
                style={inputStyle}
                required
                value={productForm.category}
                onChange={(e) =>
                  setProductForm({
                    ...productForm,
                    category: e.target.value,
                    subcategory: "",
                  })
                }
              >
                <option value="">Select Category</option>

                {categories
                  .filter(
                    (cat) =>
                      cat.isActive !== false &&
                      cat.productName.trim().toLowerCase() ===
                        productForm.productName.trim().toLowerCase()
                  )
                  .map((cat) => (
                    <option key={cat._id} value={cat.categoryName}>
                      {cat.categoryName}
                    </option>
                  ))}
              </select>
            </Field>

            {/* Subcategory Dropdown */}
            <Field label="Subcategory">
              <select
                style={inputStyle}
                value={productForm.subcategory}
                disabled={!productForm.category}
                onChange={(e) =>
                  setProductForm({
                    ...productForm,
                    subcategory: e.target.value,
                  })
                }
              >
                <option value="">Select Subcategory</option>

                {categories
                  .filter(
                    (cat) =>
                      cat.isActive !== false &&
                      cat.productName.trim().toLowerCase() ===
                        productForm.productName.trim().toLowerCase() &&
                      cat.categoryName === productForm.category
                  )
                  .flatMap((cat) =>
                    (cat.subcategories || [])
                      .filter((sub) => sub.isActive)
                      .map((sub) => (
                        <option key={sub._id} value={sub.name}>
                          {sub.name}
                        </option>
                      ))
                  )}
              </select>
            </Field>

            {/* Brand */}
            <Field label="Brand">
              <input
                style={inputStyle}
                value={productForm.brand}
                onChange={(e) =>
                  setProductForm({
                    ...productForm,
                    brand: e.target.value,
                  })
                }
              />
            </Field>

            {/* Stock Type */}
            <Field label="Stock Type">
              <select
                style={inputStyle}
                value={productForm.stockType}
                onChange={(e) =>
                  setProductForm({
                    ...productForm,
                    stockType: e.target.value,
                  })
                }
              >
                <option value="OWN">Own Stock</option>
                <option value="COMMISSION">Commission Stock</option>
              </select>
            </Field>

            {/* Supplier */}
            <Field label="Supplier">
              <select
                style={inputStyle}
                value={productForm.supplier}
                onChange={(e) =>
                  setProductForm({
                    ...productForm,
                    supplier: e.target.value,
                  })
                }
              >
                <option value="">No Supplier Selected</option>

                {suppliers
                  .filter((s) => s.isActive !== false)
                  .map((s) => (
                    <option key={s._id} value={s._id}>
                      {s.supplierName}
                    </option>
                  ))}
              </select>
            </Field>

            {/* Packing Type */}
            <Field label="Packing Type">
              <select
                style={inputStyle}
                value={productForm.packingType}
                onChange={(e) =>
                  setProductForm({
                    ...productForm,
                    packingType: e.target.value,
                  })
                }
              >
                <option value="BAG">Bag</option>
                <option value="LOOSE">Loose</option>
                <option value="BOX">Box</option>
                <option value="OTHER">Other</option>
              </select>
            </Field>

            {/* Unit */}
            <Field label="Unit">
              <select
                style={inputStyle}
                value={productForm.unit}
                onChange={(e) =>
                  setProductForm({
                    ...productForm,
                    unit: e.target.value,
                  })
                }
              >
                <option value="KG">KG</option>
                <option value="GRAM">Gram</option>
                <option value="TON">Ton</option>
                <option value="PCS">Pieces</option>
              </select>
            </Field>

            {/* Minimum Stock */}
            <Field label="Minimum Stock (KG)">
              <input
                style={inputStyle}
                type="number"
                min="0"
                step="0.01"
                value={productForm.minimumStockKg}
                onChange={(e) =>
                  setProductForm({
                    ...productForm,
                    minimumStockKg: e.target.value,
                  })
                }
              />
            </Field>

          </div>

          {/* Description */}
          <Field label="Description">
            <textarea
              style={{ ...inputStyle, minHeight: 75 }}
              value={productForm.description}
              onChange={(e) =>
                setProductForm({
                  ...productForm,
                  description: e.target.value,
                })
              }
            />
          </Field>

          <p style={{ fontSize: 12, color: "#7b8494" }}>
            SKU à¦¸à§à¦¬à§Ÿà¦‚à¦•à§à¦°à¦¿à§Ÿà¦­à¦¾à¦¬à§‡ à¦¤à§ˆà¦°à¦¿ à¦¹à¦¬à§‡à¥¤ à¦•à§à¦°à§Ÿà¦®à§‚à¦²à§à¦¯ Lot Entry-à¦¤à§‡ à¦à¦¬à¦‚ à¦¬à¦¿à¦•à§à¦°à§Ÿà¦®à§‚à¦²à§à¦¯ Sales Entry-à¦¤à§‡ à¦¨à¦¿à¦°à§à¦§à¦¾à¦°à¦£ à¦•à¦°à¦¾ à¦¹à¦¬à§‡à¥¤ à¦¬à¦¸à§à¦¤à¦¾à¦° à¦¨à¦¿à¦°à§à¦¦à¦¿à¦·à§à¦Ÿ à¦“à¦œà¦¨ à¦¦à¦¿à¦¤à§‡ à¦¹à¦¬à§‡ à¦¨à¦¾à¥¤
          </p>

          <div style={modalFooterStyle}>
            <button
              type="button"
              className="date-button"
              onClick={() => setShowForm(false)}
            >
              Cancel
            </button>

            <button type="submit" className="primary-button">
              {editingId ? "Update Product" : "Save Product"}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}


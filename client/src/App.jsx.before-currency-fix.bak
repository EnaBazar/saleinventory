async function cancelSalesInvoice(invoiceId) {
  const reason = window.prompt("Invoice cancel à¦•à¦°à¦¾à¦° à¦•à¦¾à¦°à¦£ à¦²à¦¿à¦–à§à¦¨:");

  if (!reason || !reason.trim()) {
    toast.error("Cancellation reason à¦¦à¦¿à¦¤à§‡ à¦¹à¦¬à§‡");
    return;
  }

  const confirmed = window.confirm(
    "à¦†à¦ªà¦¨à¦¿ à¦•à¦¿ à¦¨à¦¿à¦¶à§à¦šà¦¿à¦¤ à¦à¦‡ Invoice Cancel à¦•à¦°à¦¤à§‡ à¦šà¦¾à¦¨? Stock à¦à¦¬à¦‚ Customer Ledger à¦¸à¦®à¦¨à§à¦¬à§Ÿ à¦•à¦°à¦¾ à¦¹à¦¬à§‡à¥¤"
  );

  if (!confirmed) return;

  try {
    setCancellingSalesInvoice(true);

    const result = await apiRequest(`/sales/${invoiceId}/cancel`, {
      method: "PATCH",
      body: JSON.stringify({
        reason: reason.trim(),
      }),
    });

    toast.success(result.message || "Invoice successfully cancelled");

    setCancelReason("");

    // Cancel à¦¹à¦“à§Ÿà¦¾à¦° à¦ªà¦° Invoice Details à¦†à¦¬à¦¾à¦° Load
    await loadSalesDetails(invoiceId);

  } catch (error) {
    toast.error(error.message || "Invoice cancel à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
  } finally {
    setCancellingSalesInvoice(false);
  }
}


              onChange={(e) =>
                setExpenseForm((prev) => ({
                  ...prev,
                  description: e.target.value,
                }))
              }
            />
          </div>
        </div>

        {/* SELECTED ACCOUNT DETAILS */}
        {selectedAccount && (
          <div
            style={{
              marginTop: 20,
              padding: 17,
              borderRadius: 9,
              background: "#f8fafc",
              border: "1px solid #e2e8f0",
              display: "grid",
              gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
              gap: 15,
            }}
          >
            <div>
              <div
                style={{
                  color: "#64748b",
                  fontSize: 11,
                  fontWeight: 600,
                  marginBottom: 6,
                }}
              >
                Selected Account
              </div>

              <strong style={{ fontSize: 14, color: "#1e293b" }}>
                {selectedAccount.accountName}
              </strong>

              <div style={{ fontSize: 11, color: "#64748b", marginTop: 4 }}>
                {selectedAccount.accountType}
              </div>
            </div>

            <div>
              <div
                style={{
                  color: "#64748b",
                  fontSize: 11,
                  fontWeight: 600,
                  marginBottom: 6,
                }}
              >

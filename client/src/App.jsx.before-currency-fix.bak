          ))}
        </div>

        {/* SALES TREND */}
        <div style={{
          padding: 15,
          border: "1px solid #e2e8f0",
          borderRadius: 9,
          background: "#fff",
          marginBottom: 20,
        }}>
          <div style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            gap: 10,
            flexWrap: "wrap",
            marginBottom: 18,
          }}>
            <div>
              <h3 style={{
                margin: 0,
                fontSize: 15,
                fontWeight: 800,
                color: "#172554",
              }}>
                Sales Trend
              </h3>
              <p style={{
                margin: "4px 0 0",
                fontSize: 11,
                color: "#64748b",
              }}>
                Daily sales performance
              </p>
            </div>

            <div style={{
              display: "flex",
              alignItems: "center",
              gap: 7,
            }}>
              <select
                value={salesDashboardPeriod}
                onChange={(e) => {
                  setSalesDashboardPeriod(e.target.value);
                  loadSalesDashboard(e.target.value);
                }}
                style={{
                  padding: "7px 10px",
                  border: "1px solid #cbd5e1",
                  borderRadius: 6,
                  fontSize: 12,
                  background: "#fff",
                }}
              >
                <option value="7">Last 7 Days</option>
                <option value="30">Last 30 Days</option>
              </select>

              <button
                type="button"
                className="secondary-button"
                onClick={() => loadSalesDashboard()}
                disabled={salesDashboardLoading}
              >
                {salesDashboardLoading ? "Loading..." : "Refresh"}
              </button>
            </div>
          </div>

          {salesDashboard.salesTrend?.length > 0 ? (
            <>
              {(() => {
                const maxSales = Math.max(
                  1,
                  ...salesDashboard.salesTrend.map(
                    (item) => Number(item.netSales || 0)
                  )
                );

                return (
                  <div style={{
                    display: "flex",
                    alignItems: "flex-end",
                    gap: salesDashboardPeriod === "30" ? 3 : 12,
                    height: 210,
                    overflowX: "auto",
                    padding: "10px 3px 0",
                    borderBottom: "1px solid #e2e8f0",
                  }}>
                    {salesDashboard.salesTrend.map((item) => {
                      const sales = Number(item.netSales || 0);
                      const height = Math.max(
                        sales > 0 ? 5 : 2,
                        (sales / maxSales) * 155
                      );

                      return (
                        <div
                          key={item.date}
                          title={`${item.date}\nNet Sales: à§³ ${sales.toLocaleString("en-BD")}\nReturns: à§³ ${Number(item.returns || 0).toLocaleString("en-BD")}\nInvoices: ${item.invoices}`}
                          style={{
                            flex: "1 0 22px",
                            minWidth: salesDashboardPeriod === "30" ? 16 : 30,
                            display: "flex",
                            flexDirection: "column",
                            justifyContent: "flex-end",
                            alignItems: "center",
                            height: "100%",
                          }}
                        >
                          <div style={{
                            fontSize: 9,
                            color: "#64748b",
                            marginBottom: 4,
                            whiteSpace: "nowrap",
                          }}>
                            {sales > 0
                              ? sales >= 100000
                                ? `${(sales / 100000).toFixed(1)}L`
                                : sales >= 1000
                                ? `${(sales / 1000).toFixed(1)}K`
                                : sales.toFixed(0)
                              : ""}
                          </div>

                          <div style={{
                            width: "75%",
                            height: `${height}px`,
                            minHeight: 2,
                            background: "#2563eb",
                            borderRadius: "5px 5px 0 0",
                          }} />

                          <div style={{
                            fontSize: 9,
                            color: "#64748b",
                            marginTop: 6,
                            whiteSpace: "nowrap",
                            transform: salesDashboardPeriod === "30"
                              ? "rotate(-45deg)"
                              : "none",
                            transformOrigin: "top center",
                          }}>
                            {new Date(item.date + "T12:00:00").toLocaleDateString(
                              "en-GB",
                              { day: "2-digit", month: "short" }
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                );
              })()}

              <div style={{
                display: "flex",
                gap: 18,
                flexWrap: "wrap",
                marginTop: 18,
                fontSize: 11,
                color: "#64748b",
              }}>
                <span>
                  <span style={{
                    display: "inline-block",
                    width: 9,
                    height: 9,
                    background: "#2563eb",
                    borderRadius: 2,
                    marginRight: 5,
                  }} />
                  Net Sales
                </span>
                <span>
                  Hover over a bar to see sales, returns and invoices
                </span>
              </div>
            </>
          ) : (
            <p style={{
              textAlign: "center",
              padding: 25,
              color: "#64748b",
              fontSize: 12,
            }}>
              No sales trend data available.
            </p>
          )}
        </div>
      </>
    ) : (
      <div style={{
        padding: 20,
        textAlign: "center",
        color: "#dc2626",
        background: "#fff",
        borderRadius: 9,
      }}>
        Dashboard data à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤ Refresh à¦•à¦°à§à¦¨à¥¤
        <div style={{ marginTop: 10 }}>
          <button
            type="button"
            className="primary-button"
            onClick={() => loadSalesDashboard()}
          >
            Try Again
          </button>
        </div>
      </div>
    )}
  </>
)}


{/* OWN SALES REPORTS */}
{[
  "Daily Sales Summary",
  "Weekly Sales Summary",
  "Monthly Sales Summary",
  "Yearly Sales Summary",
  "Lot Wise Sales",
  "Product Wise Sales",
  "Category Wise Sales",
  "Supplier Wise Sales",
  "OWN Profit / Loss",
].includes(activePage) && (
  <div style={{
    background: "#fff",
    border: "1px solid #e2e8f0",
    borderRadius: 10,
    padding: 15,
    marginBottom: 15,
  }}>
    <h2 style={{ margin: 0, fontSize: 18, color: "#172554" }}>
      {activePage}
    </h2>

    <div style={{
      display: "flex",
      gap: 10,
      flexWrap: "wrap",
      marginTop: 15,
      alignItems: "end",
    }}>
      <div>
        <label style={fieldLabel}>Start Date</label>
        <input
          type="date"
          style={compactInput}
          value={ownSalesReportFrom}
          onChange={(e) => setOwnSalesReportFrom(e.target.value)}
        />
      </div>

      <div>
        <label style={fieldLabel}>End Date</label>
        <input
          type="date"
          style={compactInput}
          value={ownSalesReportTo}
          onChange={(e) => setOwnSalesReportTo(e.target.value)}
        />
      </div>

      <button
        type="button"
        className="primary-button"
        disabled={ownSalesReportLoading}
        onClick={() => {
          if (activePage === "OWN Profit / Loss") {
            loadOwnSalesRegister();
            return;
          }

          const reportTypes = {
            "Daily Sales Summary": "daily",
            "Weekly Sales Summary": "weekly",
            "Monthly Sales Summary": "monthly",
            "Yearly Sales Summary": "yearly",
            "Lot Wise Sales": "lot",
            "Product Wise Sales": "product",
            "Category Wise Sales": "category",
            "Supplier Wise Sales": "supplier",
          };

          loadOwnSalesReport(reportTypes[activePage]);
        }}
      >
        {ownSalesReportLoading ? "Loading..." : "Search Report"}
      </button>
    </div>

    {ownSalesReportLoading && (
      <p style={{ textAlign: "center", padding: 20 }}>
        Loading OWN Sales Report...
      </p>
    )}

    {/* OWN PROFIT / LOSS: INVOICE REGISTER */}
    {activePage === "OWN Profit / Loss" &&
      !ownSalesReportLoading && ownSalesRegister && (
     
     <>

         <div
      className="no-print"
      style={{
        display: "flex",
        justifyContent: "flex-end",
        marginTop: 15,
      }}
    >
      <button
        type="button"
        className="primary-button"
        onClick={() => window.print()}
      >
        <i className="fa fa-print" /> Print Profit / Loss
      </button>
    </div>

    <div className="own-profit-print-area">
        <div style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(150px, 1fr))",
          gap: 10,
          marginTop: 15,
        }}>
          {[
            ["Total Invoice No", ownSalesRegister.summary?.totalInvoices, true],
            ["Total Sale Amount", ownSalesRegister.summary?.totalSaleAmount],
            ["Paid Amount", ownSalesRegister.summary?.paidAmount],
            ["Dues Amount", ownSalesRegister.summary?.dueAmount],
            ["Balance Amount", ownSalesRegister.summary?.balanceAmount],
            ["Profit", ownSalesRegister.summary?.profit],
          ].map(([label, value, isCount]) => (
            <div key={label} style={{
              padding: 12,
              border: "1px solid #e2e8f0",
              borderRadius: 8,
              background: "#f8fafc",
            }}>
              <div style={{ fontSize: 11, color: "#64748b" }}>{label}</div>
              <strong style={{ fontSize: 17, color: "#172554" }}>
                {isCount
                  ? Number(value || 0).toLocaleString("en-BD")
                  : `à§³ ${Number(value || 0).toLocaleString("en-BD", {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2,
                    })}`}
              </strong>
            </div>
          ))}
        </div>

        <div style={{ marginTop: 20 }}>
          <h3 style={{ margin: "0 0 10px", fontSize: 15, color: "#172554" }}>
            Invoice Wise Sales Register
          </h3>
          <div style={{ overflowX: "auto", border: "1px solid #e2e8f0", borderRadius: 8 }}>
            <table style={{ minWidth: 1050, width: "100%" }}>
              <thead>
                <tr>
                  <th>DATE</th>
                  <th>CUSTOMER NAME</th>
                  <th>ADDRESS</th>
                  <th>INVOICE NUMBER</th>
                  <th>SALE AMOUNT</th>

      Total Transactions:{" "}
      {Number(
        ledgerData.pagination?.totalTransactions || 0
      ).toLocaleString()}
    </small>
  </div>

  <div style={{ display: "flex", gap: 8 }}>
    <button
      type="button"
      className="secondary-button"
      disabled={
        ledgerLoading ||
        !ledgerData.pagination?.hasPrevPage
      }
      onClick={() =>
        loadSupplierLedger(
          ledgerSupplier,
          ledgerPage - 1,
          ledgerFilters
        )
      }
    >
      Previous
    </button>

    <button
      type="button"
      disabled={
        ledgerLoading ||
        !ledgerData.pagination?.hasNextPage
      }
      onClick={() =>
        loadSupplierLedger(
          ledgerSupplier,
          ledgerPage + 1,
          ledgerFilters
        )
      }
    >
      Next
    </button>
  </div>
</div>

            </>
          ) : (
            <p>Ledger data à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤</p>
          )}
        </div>

       <div className="supplier-ledger-modal-footer" style={modalFooterStyle}>
          <button
            className="secondary-button"
            onClick={() => setShowSupplierLedger(false)}
          >
            Close
          </button>
        </div>
      </div>
    </div>
  );
}




function renderCustomerLedgerModal() {
  const transactions = customerLedgerData?.transactions || [];
  const pagination = customerLedgerData?.pagination || {};
  const customerSummary = customerLedgerData?.summary || {};

  const emptyFilters = {
    startDate: "",
    endDate: "",
    type: "",
    paymentMethod: "",
    search: "",
    minAmount: "",
    maxAmount: "",
  };

  const money = (value) =>
    Number(value || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

  const openingBalance =
    customerLedgerData?.customer?.openingBalance ??
    customerSummary.openingBalance ??
    0;

  const closingBalance =
    customerSummary.closingBalance ??
    customerSummary.currentBalance ??
    0;

  const cardStyle = {
    padding: 18,
    borderRadius: 12,
    border: "1px solid #e2e8f0",
    background: "#ffffff",
    boxShadow: "0 2px 8px rgba(15,23,42,0.04)",
    minWidth: 0,
  };

  const filterInputStyle = {
    width: "100%",
    boxSizing: "border-box",
    padding: "10px 12px",
    border: "1px solid #dbe2ea",
    borderRadius: 8,
    outline: "none",
    background: "#fff",
    color: "#334155",
    fontSize: 13,
    marginTop: 6,
  };

  const filterLabelStyle = {
    fontSize: 12,
    fontWeight: 700,
    color: "#475569",
  };

  const typeBadge = (type, isVoided) => {
    if (isVoided) {
      return {
        background: "#fee2e2",
        color: "#b91c1c",
        label: "VOIDED",
      };
    }

    const styles = {
      SALE: {
        background: "#dbeafe",
        color: "#1d4ed8",
        label: "SALE",
      },
      SALE_RETURN: {
        background: "#fef3c7",
        color: "#92400e",
        label: "SALE RETURN",
      },
      PAYMENT: {
        background: "#dcfce7",
        color: "#15803d",
        label: "PAYMENT",
      },
      ADJUSTMENT: {
        background: "#f3e8ff",
        color: "#7e22ce",
        label: "ADJUSTMENT",
      },
    };

    return (
      styles[type] || {
        background: "#f1f5f9",
        color: "#475569",
        label: type || "OTHER",
      }
    );
  };

  const actionButton = {
    border: "1px solid #dbe2ea",
    borderRadius: 7,
    padding: "6px 10px",
    fontSize: 12,
    fontWeight: 700,
    cursor: "pointer",
    whiteSpace: "nowrap",
  };

  return (
    <div
      className="customer-ledger-print-overlay"
      style={{
        ...modalOverlayStyle,
        padding: 12,
        background: "rgba(15,23,42,0.65)",
        backdropFilter: "blur(4px)",
        overflowY: "auto",
      }}
    >
      <div
        className="customer-ledger-print-area"
        style={{
          ...modalStyle,
          width: "98%",
          maxWidth: 1450,
          maxHeight: "96vh",
          overflowY: "auto",
          borderRadius: 16,
          padding: 0,
          background: "#f8fafc",
          boxShadow: "0 20px 60px rgba(0,0,0,0.2)",
        }}
      >
        {/* HEADER */}
        <div
          className="customer-statement-header"
          style={{
            padding: "22px 25px",
            background: "#ffffff",
            borderBottom: "1px solid #e2e8f0",
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            gap: 15,
          }}
        >
          <div style={{ display: "flex", gap: 14, alignItems: "center" }}>
            <div
              style={{
                width: 48,
                height: 48,
                minWidth: 48,
                borderRadius: 12,
                background: "#fff7ed",
                color: "#ea580c",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
              }}
            >
              <FileText size={25} />
            </div>

            <div>
              <h2
                style={{
                  margin: 0,
                  color: "#0f172a",
                  fontSize: 21,
                  fontWeight: 800,
                }}
              >
                Customer Ledger
              </h2>

              <h3
                style={{
                  margin: "5px 0 0",
                  color: "#334155",
                  fontSize: 16,
                }}
              >
                {ledgerCustomer?.customerName || "Customer"}
              </h3>

              <p
                style={{
                  margin: "5px 0 0",
                  color: "#64748b",
                  fontSize: 12,
                }}
              >
                <MapPin
                  size={13}
                  style={{ verticalAlign: "middle", marginRight: 4 }}
                />
                {ledgerCustomer?.address || "Address not provided"}
                {ledgerCustomer?.mobile
                  ? `  |  ${ledgerCustomer.mobile}`
                  : ""}
              </p>
            </div>
          </div>

          <button
            type="button"
            onClick={() => setShowCustomerLedger(false)}
            style={{
              width: 38,
              height: 38,
              border: "1px solid #e2e8f0",
              background: "#f8fafc",
              color: "#475569",
              borderRadius: 9,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
            }}
            title="Close Ledger"
          >
            <X size={20} />
          </button>
        </div>

        <div
          className="customer-statement-body"
          style={{ padding: 22 }}
        >
          {/* SUMMARY CARDS */}
          {customerLedgerData && (
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit, minmax(190px, 1fr))",
                gap: 14,
                marginBottom: 20,
              }}
            >
              <div style={cardStyle}>
                <div style={{ color: "#64748b", fontSize: 12, fontWeight: 700 }}>
                  OPENING BALANCE
                </div>
                <h2 style={{ color: "#334155", fontSize: 21, margin: "12px 0 0" }}>
                  à§³ {money(openingBalance)}
                </h2>
              </div>

              <div style={cardStyle}>
                <div style={{ color: "#64748b", fontSize: 12, fontWeight: 700 }}>
                  TOTAL DEBIT
                </div>
                <h2 style={{ color: "#dc2626", fontSize: 21, margin: "12px 0 0" }}>
                  à§³ {money(customerSummary.totalDebit)}
                </h2>
              </div>

              <div style={cardStyle}>
                <div style={{ color: "#64748b", fontSize: 12, fontWeight: 700 }}>
                  TOTAL CREDIT
                </div>
                <h2 style={{ color: "#16a34a", fontSize: 21, margin: "12px 0 0" }}>
                  à§³ {money(customerSummary.totalCredit)}
                </h2>
              </div>

              <div
                style={{
                  ...cardStyle,
                  background: "#fff7ed",
                  borderColor: "#fed7aa",
                }}
              >
                <div style={{ color: "#9a3412", fontSize: 12, fontWeight: 700 }}>
                  CURRENT BALANCE
                </div>
                <h2 style={{ color: "#c2410c", fontSize: 21, margin: "12px 0 0" }}>
                  à§³ {money(closingBalance)}
                </h2>
              </div>
            </div>
          )}

          {/* FILTER PANEL */}
          <div
            className="customer-ledger-filter-panel customer-statement-filter"
            style={{
              background: "#ffffff",
              padding: 20,
              borderRadius: 12,
              border: "1px solid #e2e8f0",
              marginBottom: 20,
              boxShadow: "0 2px 8px rgba(15,23,42,0.03)",
            }}
          >
            <div
              style={{
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
                flexWrap: "wrap",
                gap: 8,
                marginBottom: 16,
              }}
            >
              <div>
                <h3 style={{ margin: 0, fontSize: 16, color: "#0f172a" }}>
                  <Search
                    size={17}
                    style={{ verticalAlign: "middle", marginRight: 7 }}
                  />
                  Find Transactions
                </h3>
                <small style={{ color: "#64748b" }}>
                  Filter customer transaction history
                </small>
              </div>
            </div>

            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
                gap: 14,
              }}
            >
              <div style={{ gridColumn: "1 / -1" }}>
                <label style={filterLabelStyle}>Search Transactions</label>
                <input
                  type="text"
                  style={filterInputStyle}
                  placeholder="Search Transaction ID or Reference..."
                  value={customerLedgerFilters.search}
                  onChange={(e) =>
                    setCustomerLedgerFilters((prev) => ({
                      ...prev,
                      search: e.target.value,
                    }))
                  }
                />
              </div>

              <div>
                <label style={filterLabelStyle}>Start Date</label>
                <input
                  type="date"
                  style={filterInputStyle}
                  value={customerLedgerFilters.startDate}
                  onChange={(e) =>
                    setCustomerLedgerFilters((prev) => ({
                      ...prev,
                      startDate: e.target.value,
                    }))
                  }
                />
              </div>

              <div>
                <label style={filterLabelStyle}>End Date</label>
                <input
                  type="date"
                  style={filterInputStyle}
                  value={customerLedgerFilters.endDate}
                  onChange={(e) =>
                    setCustomerLedgerFilters((prev) => ({
                      ...prev,
                      endDate: e.target.value,
                    }))
                  }
                />
              </div>

              <div>
                <label style={filterLabelStyle}>Transaction Type</label>
                <select
                  style={filterInputStyle}
                  value={customerLedgerFilters.type}
                  onChange={(e) =>
                    setCustomerLedgerFilters((prev) => ({
                      ...prev,
                      type: e.target.value,
                    }))
                  }
                >
                  <option value="">All Types</option>
                  <option value="SALE">Sale</option>
                  <option value="SALE_RETURN">Sale Return</option>
                  <option value="PAYMENT">Payment</option>
                  <option value="ADJUSTMENT">Adjustment</option>
                </select>
              </div>

              <div>
                <label style={filterLabelStyle}>Payment Method</label>
                <select
                  style={filterInputStyle}
                  value={customerLedgerFilters.paymentMethod}
                  onChange={(e) =>
                    setCustomerLedgerFilters((prev) => ({
                      ...prev,
                      paymentMethod: e.target.value,
                    }))
                  }
                >
                  <option value="">All Methods</option>
                  <option value="CASH">Cash</option>
                  <option value="BANK">Bank</option>
                  <option value="BKASH">bKash</option>
                  <option value="NAGAD">Nagad</option>
                  <option value="ROCKET">Rocket</option>
                  <option value="OTHER">Other</option>
                </select>
              </div>

              <div>
                <label style={filterLabelStyle}>Minimum Amount (à§³)</label>
                <input
                  type="number"
                  min="0"
                  style={filterInputStyle}
                  placeholder="Minimum amount"
                  value={customerLedgerFilters.minAmount}
                  onChange={(e) =>
                    setCustomerLedgerFilters((prev) => ({
                      ...prev,
                      minAmount: e.target.value,
                    }))
                  }
                />
              </div>

              <div>
                <label style={filterLabelStyle}>Maximum Amount (à§³)</label>
                <input
                  type="number"
                  min="0"
                  style={filterInputStyle}
                  placeholder="Maximum amount"
                  value={customerLedgerFilters.maxAmount}
                  onChange={(e) =>
                    setCustomerLedgerFilters((prev) => ({
                      ...prev,
                      maxAmount: e.target.value,
                    }))
                  }
                />
              </div>
            </div>

    <div
  style={{
    display: "flex",
    gap: 12,
    flexWrap: "wrap",
    justifyContent: "flex-end",
    alignItems: "center",
    marginTop: 20,
    paddingTop: 18,
    borderTop: "1px solid #f1f5f9",
  }}
>
              <button
                type="button"
                className="secondary-button"
                onClick={() => {
                  setCustomerLedgerFilters(emptyFilters);
                  loadCustomerLedger(ledgerCustomer, 1, emptyFilters);
                }}
                disabled={customerLedgerLoading}
              >
                Clear Filter
              </button>

              <button
                type="button"
                className="primary-button"
                onClick={() =>
                  loadCustomerLedger(
                    ledgerCustomer,
                    1,
                    customerLedgerFilters
                  )
                }
                disabled={customerLedgerLoading}
              >
                <Search size={15} style={{ verticalAlign: "middle", marginRight: 5 }} />
                {customerLedgerLoading ? "Searching..." : "Apply Filter"}
              </button>

              <button
                type="button"
                className="secondary-button"
                onClick={() => window.print()}
                disabled={
                  !customerLedgerData ||
                  customerLedgerLoading ||
                  transactions.length === 0
                }
              >
                <Printer size={15} style={{ verticalAlign: "middle", marginRight: 5 }} />
                Print Report
              </button>
            </div>
          </div>

          {/* TRANSACTION TABLE */}
          {customerLedgerLoading ? (
            <div
              style={{
                background: "#fff",
                borderRadius: 12,
                padding: 35,
                textAlign: "center",
                color: "#64748b",
              }}
            >
              Loading customer ledger...
            </div>
          ) : customerLedgerData ? (
            <>
              <div
                style={{
                  background: "#ffffff",
                  border: "1px solid #e2e8f0",
                  borderRadius: 12,
                  overflow: "hidden",
                }}
              >
                <div
                  style={{
                    padding: "16px 18px",
                    display: "flex",
                    justifyContent: "space-between",
                    alignItems: "center",
                    flexWrap: "wrap",
                    gap: 8,
                    borderBottom: "1px solid #e2e8f0",
                  }}
                >
                  <div>
                    <h3 style={{ margin: 0, fontSize: 16, color: "#0f172a" }}>
                      Transaction History
                    </h3>
                    <small style={{ color: "#64748b" }}>
                      Customer account activity and balance
                    </small>
                  </div>

                  <span
                    style={{
                      background: "#f1f5f9",
                      color: "#475569",
                      padding: "6px 10px",
                      borderRadius: 20,
                      fontSize: 12,
                      fontWeight: 700,
                    }}
                  >
                    {Number(pagination.totalTransactions || 0).toLocaleString()} Transactions
                  </span>
                </div>

                <div
                  className="table-wrapper"
                  style={{
                    overflowX: "auto",
                    width: "100%",
                  }}
                >
                  <table
                    className="customer-statement-table"
                    style={{
                      width: "100%",
                      minWidth: 1050,
                      borderCollapse: "collapse",
                      fontSize: 13,
                    }}
                  >
                    <thead>
                      <tr style={{ background: "#f1f5f9" }}>
                        {[
                          "DATE",
                          "TYPE",
                          "DESCRIPTION",
                          "METHOD",
                          "DEBIT",
                          "CREDIT",
                          "BALANCE",
                          "ACTION",
                        ].map((heading) => (
                          <th
                            key={heading}
                            style={{
                              padding: "13px 12px",
                              textAlign: "left",
                              color: "#475569",
                              fontSize: 11,
                              fontWeight: 800,
                              whiteSpace: "nowrap",
                              borderBottom: "1px solid #e2e8f0",
                            }}
                          >
                            {heading}
                          </th>
                        ))}
                      </tr>
                    </thead>

                    <tbody>
                      {transactions.map((item) => {
                        const isVoided =
                          item.type === "PAYMENT" &&
                          item.isVoided === true;

                        const badge = typeBadge(item.type, isVoided);

                        return (
                          <tr
                            key={item._id}
                            style={{
                              borderBottom: "1px solid #f1f5f9",
                              background: isVoided ? "#fffafa" : "#ffffff",
                            }}
                          >
                            <td style={{ padding: "13px 12px", whiteSpace: "nowrap", color: "#475569" }}>
                              {item.transactionDate
                                ? new Date(item.transactionDate).toLocaleDateString("en-GB")
                                : "-"}
                            </td>

                            <td style={{ padding: "13px 12px" }}>
                              <span
                                style={{
                                  display: "inline-block",
                                  padding: "5px 9px",
                                  borderRadius: 20,
                                  background: badge.background,
                                  color: badge.color,
                                  fontSize: 10,
                                  fontWeight: 800,
                                  whiteSpace: "nowrap",
                                }}
                              >
                                {badge.label}
                              </span>
                            </td>

                            <td style={{ padding: "13px 12px", minWidth: 190, color: "#334155" }}>
                              <div style={{ fontWeight: 600 }}>
                                {item.description || item.reference || "-"}
                              </div>

                              {item.transactionId && (
                                <small style={{ display: "block", marginTop: 4, color: "#94a3b8" }}>
                                  ID: {item.transactionId}
                                </small>
                              )}

                              {isVoided && (
                                <div
                                  style={{
                                    marginTop: 7,
                                    padding: 8,
                                    background: "#fff1f2",
                                    borderRadius: 6,
                                    color: "#be123c",
                                    fontSize: 11,
                                  }}
                                >
                                  Original Amount: à§³ {money(item.amount)}
                                  <br />
                                  Reason: {item.voidReason || "Not provided"}
                                </div>
                              )}
                            </td>

                            <td style={{ padding: "13px 12px", color: "#64748b", whiteSpace: "nowrap" }}>
                              {item.paymentMethod || "-"}
                            </td>

                            <td style={{ padding: "13px 12px", color: "#dc2626", fontWeight: 600, whiteSpace: "nowrap" }}>
                              à§³ {money(isVoided ? 0 : item.debit)}
                            </td>

                            <td style={{ padding: "13px 12px", color: "#16a34a", fontWeight: 600, whiteSpace: "nowrap" }}>
                              à§³ {money(isVoided ? 0 : item.credit)}
                            </td>

                            <td style={{ padding: "13px 12px", fontWeight: 800, color: "#0f172a", whiteSpace: "nowrap" }}>
                              à§³ {money(item.balanceAfter)}
                            </td>

                            <td style={{ padding: "13px 12px", whiteSpace: "nowrap" }}>
                              {item.type === "PAYMENT" && !isVoided ? (
                                <div style={{ display: "flex", gap: 6 }}>
                                  <button
                                    type="button"
                                    style={{
                                      ...actionButton,
                                      background: "#eff6ff",
                                      color: "#1d4ed8",
                                      borderColor: "#bfdbfe",
                                    }}
                                    onClick={() => {
                                      setEditingCustomerPayment(item);
                                      loadSalesCollectionAccounts();

const selectedAccountId =
  item.accountId?._id || item.accountId || "";
loadCustomerCollectionAccounts();
                                      setCustomerPaymentEditForm({
                            amount: item.amount || item.credit || "",
paymentMethod: item.paymentMethod || "CASH",

accountId: item.accountId?._id || item.accountId || "",
transactionId: item.transactionId || "",
                                        reference: item.reference || "",
                                        transactionDate: item.transactionDate
                                          ? new Date(item.transactionDate).toISOString().slice(0, 10)
                                          : "",
                                        description: item.description || "",
                                        reason: "",
                                      });

                                      setShowCustomerPaymentEdit(true);
                                    }}
                                  >
                                    <Edit size={12} style={{ verticalAlign: "middle", marginRight: 3 }} />
                                    Edit
                                  </button>

                                  <button
                                    type="button"
                                    style={{
                                      ...actionButton,
                                      background: "#fff1f2",
                                      color: "#be123c",
                                      borderColor: "#fecdd3",
                                    }}
                                    onClick={() => {
                                      setVoidingCustomerPayment(item);
                                      setCustomerPaymentVoidReason("");
                                      setShowCustomerPaymentVoid(true);
                                    }}
                                  >
                                    <Trash2 size={12} style={{ verticalAlign: "middle", marginRight: 3 }} />
                                    Void
                                  </button>
                                </div>
                              ) : (
                                <span style={{ color: "#cbd5e1" }}>â€”</span>
                              )}
                            </td>
                          </tr>
                        );
                      })}

                      {transactions.length === 0 && (
                        <tr>
                          <td
                            colSpan="8"
                            style={{
                              textAlign: "center",
                              padding: 40,
                              color: "#94a3b8",
                            }}
                          >
                            <FileText size={30} style={{ marginBottom: 8, opacity: 0.5 }} />
                            <div>No transactions found</div>
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
              </div>

              {/* PAGINATION */}
              <div
                className="customer-ledger-pagination"
                style={{
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  gap: 12,
                  flexWrap: "wrap",
                  marginTop: 16,
                  padding: "15px 18px",
                  background: "#ffffff",
                  border: "1px solid #e2e8f0",
                  borderRadius: 12,
                }}
              >
                <div>
                  <strong style={{ color: "#334155", fontSize: 13 }}>
                    Page {pagination.page || 1} of {pagination.totalPages || 1}
                  </strong>

                  <small style={{ display: "block", marginTop: 4, color: "#64748b" }}>
                    Total Transactions:{" "}
                    {Number(pagination.totalTransactions || 0).toLocaleString()}
                  </small>
                </div>

                <div style={{ display: "flex", gap: 8 }}>
                  <button
                    type="button"
                    className="secondary-button"
                    disabled={
                      customerLedgerLoading ||
                      !pagination.hasPrevPage
                    }
                    onClick={() =>
                      loadCustomerLedger(
                        ledgerCustomer,
                        customerLedgerPage - 1,
                        customerLedgerFilters
                      )
                    }
                  >
                    Previous
                  </button>

                  <button
                    type="button"
                    className="primary-button"
                    disabled={
                      customerLedgerLoading ||
                      !pagination.hasNextPage
                    }
                    onClick={() =>
                      loadCustomerLedger(
                        ledgerCustomer,
                        customerLedgerPage + 1,
                        customerLedgerFilters
                      )
                    }
                  >
                    Next
                  </button>
                </div>
              </div>
            </>
          ) : (
            <div style={{ padding: 25, textAlign: "center", color: "#64748b" }}>
              Customer Ledger data à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤
            </div>
          )}
        </div>

        {/* FOOTER */}
        <div
          className="customer-ledger-modal-footer"
          style={{
            padding: "15px 22px",
            background: "#ffffff",
            borderTop: "1px solid #e2e8f0",
            display: "flex",
            justifyContent: "flex-end",
          }}
        >
          <button
            type="button"
            className="secondary-button"
            onClick={() => setShowCustomerLedger(false)}
          >
            Close
          </button>
        </div>
      </div>
    </div>
  );
}





function renderCustomerStatementModal() {
  const data = customerStatementData || {};
  const summary = data.summary || {};
  const transactions = data.transactions || [];

  const filteredTransactions =
    customerStatementType === "ALL"
      ? transactions
      : transactions.filter(
          (item) => item.type === customerStatementType
        );

  const money = (value) =>
    Number(value || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

  return (
   <div
  className="customer-statement-print-overlay"
  style={modalOverlayStyle}
>
<div
  className="customer-statement-print-area"
  style={{ ...modalStyle, maxWidth: 1200, width: "96%" }}
>
        <div className="customer-statement-header">
          <div>
            <h2>Customer Statement</h2>
            <p>
              {statementCustomer?.customerName || "Customer"}
              {statementCustomer?.mobile
                ? ` | ${statementCustomer.mobile}`
                : ""}
            </p>
          </div>

          <button
            type="button"
            onClick={() => setShowCustomerStatement(false)}
          >
            <X size={20} />
          </button>
        </div>

        <div className="customer-statement-body">
          {/* FILTER */}
     <div
  className="customer-statement-filter"
  style={{
    display: "flex",
    flexWrap: "wrap",
    alignItems: "end",
    gap: 12,
  }}
>
            <div>
              <label>Transaction Type</label>
              <select
                style={inputStyle}
                value={customerStatementType}
                onChange={(e) =>
                  setCustomerStatementType(e.target.value)
                }
              >
                <option value="ALL">All Transactions</option>
                <option value="SALE">Sale</option>
                <option value="PAYMENT">Payment</option>
                <option value="SALE_RETURN">Sales Return</option>
                <option value="ADJUSTMENT">Adjustment</option>
              </select>
            </div>

            <div>
              <label>Start Date</label>
              <input
                type="date"
                style={inputStyle}
                value={customerStatementFilters.startDate}
                onChange={(e) =>
                  setCustomerStatementFilters((prev) => ({
                    ...prev,
                    startDate: e.target.value,
                  }))
                }
              />
            </div>

            <div>
              <label>End Date</label>
              <input
                type="date"
                style={inputStyle}
                value={customerStatementFilters.endDate}
                onChange={(e) =>
                  setCustomerStatementFilters((prev) => ({
                    ...prev,
                    endDate: e.target.value,
                  }))
                }
              />
            </div>

            <button
              className="primary-button"
              onClick={() =>
                loadCustomerStatement(
                  statementCustomer,
                  customerStatementFilters.startDate,
                  customerStatementFilters.endDate
                )
              }
              disabled={customerStatementLoading}
            >
              Filter Statement
            </button>

            <button
              className="secondary-button"
              onClick={() => {
                setCustomerStatementFilters({
                  startDate: "",
                  endDate: "",
                });
                setCustomerStatementType("ALL");
                loadCustomerStatement(statementCustomer, "", "");
              }}
              disabled={customerStatementLoading}
            >
              All Dates
            </button>
          </div>

          {customerStatementLoading ? (
            <p>Loading statement...</p>
          ) : customerStatementData ? (
            <>
              {/* SUMMARY */}
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "repeat(auto-fit, minmax(170px, 1fr))",
                  gap: 12,
                  marginBottom: 20,
                }}
              >
              
{[
  ["Opening Balance", summary.openingBalance, false],
  ["Total Sales", summary.totalSales, false],
  ["Total Payments", summary.totalPayments, false],
  ["Sales Return", summary.totalSalesReturn, false],
  ["Total Debit", summary.totalDebit, false],
  ["Total Credit", summary.totalCredit, false],
  ["Closing Balance", summary.closingBalance, true],
].map(([label, value, isBalance]) => (
  <div
    key={label}
    className={`customer-statement-card ${
      isBalance ? "balance-card" : ""
    }`}
  >
    <small>{label}</small>
    <h3>à§³ {money(value)}</h3>
  </div>
))}

              </div>

              {/* TRANSACTION TABLE */}
              <div className="table-wrapper">
               <table className="customer-statement-table">
                  <thead>
                    <tr>
                      <th>DATE</th>
                      <th>TYPE</th>
                      <th>DESCRIPTION</th>
                      <th>METHOD</th>
                      <th>DEBIT</th>
                      <th>CREDIT</th>
                      <th>BALANCE</th>
                    </tr>
                  </thead>

                  <tbody>
                    {filteredTransactions.map((item) => {
                      const isVoided =
                        item.type === "PAYMENT" &&
                        item.isVoided === true;

                      return (
                        <tr key={item._id}>
                          <td>
                            {item.transactionDate
                              ? new Date(
                                  item.transactionDate
                                ).toLocaleDateString("en-GB")
                              : "-"}
                          </td>

                          <td>
                            <div>{item.type || "-"}</div>

                            {isVoided && (
                              <span
                                style={{
                                  display: "inline-block",
                                  marginTop: 5,
                                  padding: "3px 8px",
                                  borderRadius: 4,
                                  background: "#fee2e2",
                                  color: "#b91c1c",
                                  fontSize: 11,
                                  fontWeight: 700,
                                }}
                              >
                                VOIDED
                              </span>
                            )}
                          </td>

                          <td>
                            {item.description || item.reference || "-"}
                            {item.transactionId && (
                              <small style={{ display: "block" }}>
                                ID: {item.transactionId}
                              </small>
                            )}
                          </td>

                          <td>{item.paymentMethod || "-"}</td>

                          <td>
                            à§³ {money(isVoided ? 0 : item.debit)}
                          </td>

                          <td>
                            à§³ {money(isVoided ? 0 : item.credit)}
                          </td>

                          <td>
                            <strong>
                              à§³ {money(item.balanceAfter)}
                            </strong>
                          </td>
                        </tr>
                      );
                    })}

                    {filteredTransactions.length === 0 && (
                      <tr>
                        <td
                          colSpan="7"
                          style={{
                            textAlign: "center",
                            padding: 25,
                          }}
                        >
                          No transactions found
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>

              <div style={{ marginTop: 20, textAlign: "right" }}>
                <h3>
                  Closing Balance: à§³ {money(summary.closingBalance)}
                </h3>
              </div>
            </>
          ) : (
            <p>Statement data à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤</p>
          )}
        </div>

       <div className="customer-statement-footer">
          <button
            className="secondary-button"
            onClick={() => setShowCustomerStatement(false)}
          >
            Close
          </button>

          <button
            className="primary-button"
            onClick={() => window.print()}
            disabled={!customerStatementData || customerStatementLoading}
          >
            <Printer size={16} style={{ marginRight: 6 }} />
            Print Statement
          </button>
        </div>
      </div>
    </div>
  );
}




function renderSupplierStatementModal() {
  const summary = statementData?.summary || {};
  const transactions = statementData?.transactions || [];

  const filteredTransactions =
    statementType === "ALL"
      ? transactions
      : transactions.filter((item) => item.type === statementType);

  const money = (value) =>
    Number(value || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

  return (
    <div
      className="supplier-statement-print-overlay"
      style={modalOverlayStyle}
    >
      <div
        className="supplier-statement-print-area"
        style={{ ...modalStyle, maxWidth: 1200, width: "96%" }}
      >
        {/* HEADER */}
        <div className="customer-statement-header">
          <div>
            <h2>Supplier Statement</h2>
            <p>
              {statementSupplier?.supplierName || "Supplier"}
              {statementSupplier?.mobile
                ? ` | ${statementSupplier.mobile}`
                : ""}
            </p>
          </div>

          <button
            type="button"
            onClick={() => setShowSupplierStatement(false)}
          >
            <X size={20} />
          </button>
        </div>

        <div className="customer-statement-body">
          {/* FILTERS */}
          <div className="customer-statement-filter">
            <div>
              <label>Transaction Type</label>
              <select
                style={inputStyle}
                value={statementType}
                onChange={(e) => setStatementType(e.target.value)}
              >
                <option value="ALL">All Transactions</option>
                <option value="PURCHASE">Purchase</option>
                <option value="PAYMENT">Payment</option>
                <option value="PURCHASE_RETURN">Purchase Return</option>
                <option value="ADJUSTMENT">Adjustment</option>
              </select>
            </div>

            <div>
              <label>Start Date</label>
              <input
                type="date"
                style={inputStyle}
                value={statementStartDate}
                onChange={(e) => setStatementStartDate(e.target.value)}
              />
            </div>

            <div>
              <label>End Date</label>
              <input
                type="date"
                style={inputStyle}
                value={statementEndDate}
                onChange={(e) => setStatementEndDate(e.target.value)}
              />
            </div>

            <button
              className="primary-button"
              onClick={() =>
                loadSupplierStatement(
                  statementSupplier,
                  statementStartDate,
                  statementEndDate
                )
              }
              disabled={statementLoading}
            >
              Filter Statement
            </button>

            <button
              className="secondary-button"
              onClick={() => {
                setStatementStartDate("");
                setStatementEndDate("");
                loadSupplierStatement(statementSupplier, "", "");
              }}
              disabled={statementLoading}
            >
              All Dates
            </button>
          </div>

          {statementLoading ? (
            <p>Loading statement...</p>
          ) : statementData ? (
            <>
              {/* SUMMARY CARDS */}
              <div className="customer-statement-summary">
                {[
                  ["Opening Balance", summary.openingBalance],
                  ["Total Purchase", summary.totalPurchase],
                  ["Total Payment", summary.totalPayment],
                  ["Purchase Return", summary.totalPurchaseReturn],
                  ["Total Debit", summary.totalDebit],
                  ["Total Credit", summary.totalCredit],
                  ["Closing Balance", summary.closingBalance],
                ].map(([label, value]) => (
                  <div className="customer-statement-card" key={label}>
                    <small>{label}</small>
                    <h3>à§³ {money(value)}</h3>
                  </div>
                ))}
              </div>

              {/* TRANSACTION TABLE */}
              <div className="table-wrapper">
                <table className="customer-statement-table">
                  <thead>
                    <tr>
                      <th>DATE</th>
                      <th>TYPE</th>
                      <th>LOT / PRODUCT</th>
                      <th>DESCRIPTION</th>
                      <th>METHOD</th>
                      <th>DEBIT</th>
                      <th>CREDIT</th>
                      <th>BALANCE</th>
                    </tr>
                  </thead>

                  <tbody>
                    {filteredTransactions.map((item) => {
                      const isVoided =
                        item.type === "PAYMENT" &&
                        item.isVoided === true;

                      return (
                        <tr key={item._id}>
                          <td>
                            {item.transactionDate
                              ? new Date(
                                  item.transactionDate
                                ).toLocaleDateString("en-GB")
                              : "-"}
                          </td>

                          <td>
                            <div>{item.type || "-"}</div>

                            {isVoided && (
                              <span
                                style={{
                                  display: "inline-block",
                                  marginTop: 5,
                                  padding: "3px 8px",
                                  borderRadius: 4,
                                  background: "#fee2e2",
                                  color: "#b91c1c",
                                  fontSize: 11,
                                  fontWeight: 700,
                                }}
                              >
                                VOIDED
                              </span>
                            )}
                          </td>

                          <td>
                            {item.lotDetails ? (
                              <>
                                <strong>{item.lotDetails.lotCode}</strong>
                                <small style={{ display: "block" }}>
                                  {item.lotDetails.productName}
                                </small>
                              </>
                            ) : (
                              "-"
                            )}
                          </td>

                          <td>
                            {item.description || item.reference || "-"}

                            {item.transactionId && (
                              <small style={{ display: "block" }}>
                                ID: {item.transactionId}
                              </small>
                            )}

                            {isVoided && (
                              <div
                                style={{
                                  marginTop: 5,
                                  color: "#b91c1c",
                                  fontSize: 12,
                                }}
                              >
                                Original Amount: à§³ {money(item.amount)}
                                <br />
                                Void Reason: {item.voidReason || "Not provided"}
                              </div>
                            )}
                          </td>

                          <td>{item.paymentMethod || "-"}</td>
                          <td>à§³ {money(isVoided ? 0 : item.debit)}</td>
                          <td>à§³ {money(isVoided ? 0 : item.credit)}</td>
                          <td>
                            <strong>à§³ {money(item.balanceAfter)}</strong>
                          </td>
                        </tr>
                      );
                    })}

                    {filteredTransactions.length === 0 && (
                      <tr>
                        <td
                          colSpan="8"
                          style={{
                            textAlign: "center",
                            padding: 25,
                          }}
                        >
                          No transactions found
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>

              {/* CLOSING BALANCE */}
              <div className="customer-statement-footer">
                <h3>
                  Closing Balance: à§³ {money(summary.closingBalance)}
                </h3>
              </div>
            </>
          ) : (
            <p>Statement data à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤</p>
          )}
        </div>

        {/* FOOTER BUTTONS */}
        <div className="modal-footer">
          <button
            className="secondary-button"
            onClick={() => setShowSupplierStatement(false)}
          >
            Close
          </button>

          <button
            className="primary-button"
            onClick={() => window.print()}
            disabled={!statementData || statementLoading}
          >
            Print Statement
          </button>
        </div>
      </div>
    </div>
  );
}





function renderPaymentEditModal() {
  const paymentInputStyle = {
    ...inputStyle,
    width: "100%",
    marginTop: 7,
    borderRadius: 9,
    minHeight: 43,
    boxSizing: "border-box",
  };

  const sectionTitleStyle = {
    fontSize: 14,
    fontWeight: 700,
    color: "#334155",
    margin: "0 0 13px",
  };

  const labelStyle = {
    display: "block",
    fontSize: 13,
    fontWeight: 600,
    color: "#475569",
    marginTop: 14,
  };

  const selectedSupplier = suppliers.find(
    (supplier) =>
      String(supplier._id) === String(paymentEditForm.supplierId)
  );

  return (
    <div style={modalOverlayStyle}>
      <div
        style={{
          ...modalStyle,
          maxWidth: 560,
          width: "95%",
          borderRadius: 16,
          overflow: "hidden",
          padding: 0,
        }}
      >
        {/* HEADER */}
        <div
          style={{
            padding: "20px 22px",
            background: "#fff",
            borderBottom: "1px solid #e2e8f0",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
          }}
        >
          <div>
            <h2 style={{ margin: 0, fontSize: 21, color: "#1e293b" }}>
              Edit Supplier Payment
            </h2>
            <p style={{ margin: "5px 0 0", fontSize: 13, color: "#64748b" }}>
              Correct supplier payment information
            </p>
          </div>

          <button
            type="button"
            onClick={() => setShowPaymentEdit(false)}
            disabled={paymentEditLoading}
            style={{
              border: "none",
              background: "#f1f5f9",
              borderRadius: 9,
              width: 36,
              height: 36,
              cursor: "pointer",
              color: "#475569",
            }}
          >
            <X size={19} />
          </button>
        </div>

        <form onSubmit={submitPaymentEdit}>
          <div
            style={{
              padding: 22,
              maxHeight: "70vh",
              overflowY: "auto",
            }}
          >
            {/* SUPPLIER INFORMATION */}
            <div
              style={{
                padding: 17,
                background: "#f8fafc",
                border: "1px solid #e2e8f0",
                borderRadius: 12,
              }}
            >
              <h3 style={sectionTitleStyle}>
                Supplier Information
              </h3>

              <label style={labelStyle}>
                Select Supplier
              </label>

              <select
                style={paymentInputStyle}
                value={paymentEditForm.supplierId}
                onChange={(e) =>
                  setPaymentEditForm((prev) => ({
                    ...prev,
                    supplierId: e.target.value,
                  }))
                }
                required
              >
                <option value="">Select Supplier</option>

                {suppliers.map((supplier) => (
                  <option key={supplier._id} value={supplier._id}>
                    {supplier.supplierName}
                    {supplier.mobile ? ` - ${supplier.mobile}` : ""}
                  </option>
                ))}
              </select>

              <div style={{ marginTop: 14 }}>
                <div style={{ fontSize: 12, color: "#64748b" }}>
                  Supplier Name
                </div>
                <strong style={{ color: "#1e293b", fontSize: 16 }}>
                  {selectedSupplier?.supplierName || "-"}
                </strong>
              </div>

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
                  gap: 12,
                  marginTop: 12,
                }}
              >
                <div>
                  <div style={{ fontSize: 12, color: "#64748b" }}>
                    Address
                  </div>
                  <div style={{ fontSize: 14, color: "#334155" }}>
                    {selectedSupplier?.address || "-"}
                  </div>
                </div>

                <div>
                  <div style={{ fontSize: 12, color: "#64748b" }}>
                    Mobile Number
                  </div>
                  <div style={{ fontSize: 14, color: "#334155" }}>
                    {selectedSupplier?.mobile || "-"}
                  </div>
                </div>
              </div>
            </div>

            {/* PAYMENT DETAILS */}
            <div style={{ marginTop: 22 }}>
              <h3 style={sectionTitleStyle}>
                Payment Details
              </h3>

              <label style={labelStyle}>
                Payment Amount (à§³)
              </label>

              <input
                type="number"
                min="0.01"
                step="0.01"
                required
                placeholder="Enter payment amount"
                style={{
                  ...paymentInputStyle,
                  fontSize: 19,
                  fontWeight: 700,
                  color: "#15803d",
                  minHeight: 50,
                }}
                value={paymentEditForm.amount}
                onChange={(e) =>
                  setPaymentEditForm((prev) => ({
                    ...prev,
                    amount: e.target.value,
                  }))
                }
              />

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
                  gap: 14,
                }}
              >
                <div>
                  <label style={labelStyle}>
                    Payment Method
                  </label>

                  <select
                    style={paymentInputStyle}
                    value={paymentEditForm.paymentMethod}
                    onChange={(e) =>
                      setPaymentEditForm((prev) => ({
                        ...prev,
                        paymentMethod: e.target.value,
                        accountId: "",
                      }))
                    }
                    required
                  >
                    <option value="CASH">Cash</option>
                    <option value="BANK">Bank</option>
                    <option value="BKASH">bKash</option>
                    
                  </select>
                </div>

                <div>
                  <label style={labelStyle}>
                    Transaction Date
                  </label>

                  <input
                    type="date"
                    required
                    style={paymentInputStyle}
                    value={paymentEditForm.transactionDate}
                    onChange={(e) =>
                      setPaymentEditForm((prev) => ({
                        ...prev,
                        transactionDate: e.target.value,
                      }))
                    }
                  />
                </div>
              </div>

              {/* PAYMENT ACCOUNT */}
              {["CASH", "BANK", "BKASH"].includes(
                paymentEditForm.paymentMethod
              ) && (
                <div>
                  <label style={labelStyle}>
                    Payment Account
                  </label>

                  <select
                    style={paymentInputStyle}
                    value={paymentEditForm.accountId}
                    onChange={(e) =>
                      setPaymentEditForm((prev) => ({
                        ...prev,
                        accountId: e.target.value,
                      }))
                    }
                    disabled={supplierPaymentAccountsLoading}
                    required
                  >
                    <option value="">
                      {supplierPaymentAccountsLoading
                        ? "Loading Accounts..."
                        : "Select Account"}
                    </option>

                    {supplierPaymentAccounts
                      .filter(
                        (account) =>
                          account.isActive !== false &&
                          account.accountType === paymentEditForm.paymentMethod
                      )
                      .map((account) => (
                        <option key={account._id} value={account._id}>
                          {account.accountName}
                          {account.bankName ? ` - ${account.bankName}` : ""}
                          {account.accountNumber
                            ? ` (${account.accountNumber})`
                            : ""}
                        </option>
                      ))}
                  </select>
                </div>
              )}

              {/* TRANSACTION ID */}
              <label style={labelStyle}>
                Transaction ID / Reference
              </label>

              <input
                type="text"
                style={paymentInputStyle}
                placeholder="Enter transaction ID"
                value={paymentEditForm.transactionId}
                onChange={(e) =>
                  setPaymentEditForm((prev) => ({
                    ...prev,
                    transactionId: e.target.value,
                  }))
                }
              />

              {/* NOTES */}
              <label style={labelStyle}>
                Notes
              </label>

              <textarea
                style={{
                  ...paymentInputStyle,
                  minHeight: 85,
                  resize: "vertical",
                }}
                rows="3"
                placeholder="Write payment notes..."
                value={paymentEditForm.description}
                onChange={(e) =>
                  setPaymentEditForm((prev) => ({
                    ...prev,
                    description: e.target.value,
                  }))
                }
              />

              {/* CORRECTION REASON */}
              <label style={labelStyle}>
                Correction Reason *
              </label>

              <textarea
                style={{
                  ...paymentInputStyle,
                  minHeight: 85,
                  resize: "vertical",
                  borderColor: "#f59e0b",
                }}
                rows="3"
                placeholder="Why are you correcting this payment?"
                value={paymentEditForm.reason}
                onChange={(e) =>
                  setPaymentEditForm((prev) => ({
                    ...prev,
                    reason: e.target.value,
                  }))
                }
                required
              />

              <div
                style={{
                  background: "#fff7ed",
                  color: "#9a3412",
                  padding: 12,
                  borderRadius: 9,
                  fontSize: 13,
                  marginTop: 15,
                  border: "1px solid #fed7aa",
                }}
              >
                <strong>Important:</strong> Payment Correction à¦•à¦°à¦²à§‡
                Supplier Ledger à¦à¦¬à¦‚ Account Ledger à¦ªà§à¦¨à¦°à¦¾à§Ÿ à¦¹à¦¿à¦¸à¦¾à¦¬ à¦•à¦°à¦¾ à¦¹à¦¬à§‡à¥¤
              </div>
            </div>
          </div>

          {/* FOOTER */}
          <div
            style={{
              padding: "16px 22px",
              borderTop: "1px solid #e2e8f0",
              display: "flex",
              justifyContent: "flex-end",
              gap: 10,
              background: "#fff",
              flexWrap: "wrap",
            }}
          >
            <button
              type="button"
              className="secondary-button"
              onClick={() => setShowPaymentEdit(false)}
              disabled={paymentEditLoading}
            >
              Cancel
            </button>

            <button
              type="submit"
              className="primary-button"
              disabled={paymentEditLoading || supplierPaymentAccountsLoading}
            >
              {paymentEditLoading ? "Saving..." : "Save Correction"}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}



function renderCustomerPaymentEditModal() {
  const paymentInputStyle = {
    ...inputStyle,
    width: "100%",
    marginTop: 7,
    borderRadius: 9,
    minHeight: 43,
  };

  const sectionTitleStyle = {
    fontSize: 14,
    fontWeight: 700,
    color: "#334155",
    margin: "0 0 13px",
  };

  const labelStyle = {
    display: "block",
    fontSize: 13,
    fontWeight: 600,
    color: "#475569",
    marginTop: 14,
  };

  const accountRequiredMethods = ["CASH", "BANK", "BKASH"];

  const needsAccount = accountRequiredMethods.includes(
    customerPaymentEditForm.paymentMethod
  );

  const filteredEditAccounts = customerCollectionAccounts.filter(
    (account) =>
      account.accountType === customerPaymentEditForm.paymentMethod &&
      account.isActive !== false
  );

  return (
    <div style={modalOverlayStyle}>
      <div
        style={{
          ...modalStyle,
          maxWidth: 560,
          width: "95%",
          borderRadius: 16,
          overflow: "hidden",
          padding: 0,
          maxHeight: "90vh",
          display: "flex",
          flexDirection: "column",
        }}
      >
        {/* HEADER */}
        <div
          style={{
            padding: "20px 22px",
            background: "#fff",
            borderBottom: "1px solid #e2e8f0",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            flexShrink: 0,
          }}
        >
          <div>
            <h2 style={{ margin: 0, fontSize: 21, color: "#1e293b" }}>
              Edit Customer Payment
            </h2>
            <p
              style={{
                margin: "5px 0 0",
                fontSize: 13,
                color: "#64748b",
              }}
            >
              Correct customer payment information
            </p>
          </div>

          <button
            type="button"
            onClick={() => setShowCustomerPaymentEdit(false)}
            disabled={customerPaymentEditLoading}
            style={{
              border: "none",
              background: "#f1f5f9",
              borderRadius: 9,
              width: 36,
              height: 36,
              cursor: "pointer",
              color: "#475569",
            }}
          >
            <X size={19} />
          </button>
        </div>

        <form
          onSubmit={submitCustomerPaymentEdit}
          style={{
            display: "flex",
            flexDirection: "column",
            minHeight: 0,
            flex: 1,
          }}
        >
          <div
            style={{
              padding: 22,
              maxHeight: "70vh",
              overflowY: "auto",
              flex: 1,
            }}
          >
            {/* CUSTOMER INFORMATION */}
            <div
              style={{
                padding: 17,
                background: "#f8fafc",
                border: "1px solid #e2e8f0",
                borderRadius: 12,
              }}
            >
              <h3 style={sectionTitleStyle}>
                Customer Information
              </h3>

              <div style={{ marginBottom: 12 }}>
                <div style={{ fontSize: 12, color: "#64748b" }}>
                  Customer Name
                </div>
                <strong style={{ color: "#1e293b", fontSize: 16 }}>
                  {ledgerCustomer?.customerName || "-"}
                </strong>
              </div>

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
                  gap: 12,
                }}
              >
                <div>
                  <div style={{ fontSize: 12, color: "#64748b" }}>
                    Address
                  </div>
                  <div style={{ fontSize: 14, color: "#334155" }}>
                    {ledgerCustomer?.address || "-"}
                  </div>
                </div>

                <div>
                  <div style={{ fontSize: 12, color: "#64748b" }}>
                    Mobile Number
                  </div>
                  <div style={{ fontSize: 14, color: "#334155" }}>
                    {ledgerCustomer?.mobile || "-"}
                  </div>
                </div>
              </div>
            </div>

            {/* PAYMENT DETAILS */}
            <div style={{ marginTop: 22 }}>
              <h3 style={sectionTitleStyle}>
                Payment Details
              </h3>

              {/* AMOUNT */}
              <label style={labelStyle}>
                Payment Amount (à§³)
              </label>

              <input
                type="number"
                min="0.01"
                step="0.01"
                required
                placeholder="Enter payment amount"
                style={{
                  ...paymentInputStyle,
                  fontSize: 19,
                  fontWeight: 700,
                  color: "#15803d",
                  minHeight: 50,
                }}
                value={customerPaymentEditForm.amount}
                onChange={(e) =>
                  setCustomerPaymentEditForm((prev) => ({
                    ...prev,
                    amount: e.target.value,
                  }))
                }
              />

              {/* METHOD AND DATE */}
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
                  gap: 14,
                }}
              >
                <div>
                  <label style={labelStyle}>
                    Payment Method
                  </label>

                  <select
                    style={paymentInputStyle}
                    value={customerPaymentEditForm.paymentMethod}
                    onChange={(e) =>
                      setCustomerPaymentEditForm((prev) => ({
                        ...prev,
                        paymentMethod: e.target.value,
                        accountId: "",
                      }))
                    }
                    required
                  >
                    <option value="CASH">Cash</option>
                    <option value="BANK">Bank</option>
                    <option value="BKASH">bKash</option>
                  
                  </select>
                </div>

                <div>
                  <label style={labelStyle}>
                    Transaction Date
                  </label>

                  <input
                    type="date"
                    required
                    style={paymentInputStyle}
                    value={customerPaymentEditForm.transactionDate}
                    onChange={(e) =>
                      setCustomerPaymentEditForm((prev) => ({
                        ...prev,
                        transactionDate: e.target.value,
                      }))
                    }
                  />
                </div>
              </div>

              {/* DEPOSIT ACCOUNT */}
              {needsAccount && (
                <>
                  <label style={labelStyle}>
                    à¦Ÿà¦¾à¦•à¦¾ à¦•à§‹à¦¨ Account-à¦ à¦œà¦®à¦¾ à¦¹à¦¬à§‡?
                  </label>

                  <select
                    required
                    style={paymentInputStyle}
                    value={customerPaymentEditForm.accountId}
                    onChange={(e) =>
                      setCustomerPaymentEditForm((prev) => ({
                        ...prev,
                        accountId: e.target.value,
                      }))
                    }
                  >
                    <option value="">
                      Select {customerPaymentEditForm.paymentMethod} Account
                    </option>

                    {filteredEditAccounts.map((account) => (
                      <option key={account._id} value={account._id}>
                        {account.accountName} ({account.accountType})
                      </option>
                    ))}
                  </select>

                  {customerCollectionAccountsLoading && (
                    <p style={{ fontSize: 12, color: "#64748b" }}>
                      Account à¦²à§‹à¦¡ à¦¹à¦šà§à¦›à§‡...
                    </p>
                  )}

                  {!customerCollectionAccountsLoading &&
                    filteredEditAccounts.length === 0 && (
                      <p style={{ fontSize: 12, color: "#dc2626" }}>
                        à¦à¦‡ Payment Method-à¦à¦° à¦•à§‹à¦¨à§‹ Active Account à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤
                      </p>
                    )}
                </>
              )}

              {/* TRANSACTION ID */}
              <label style={labelStyle}>
                Transaction ID
              </label>

              <input
                type="text"
                style={paymentInputStyle}
                placeholder="Enter transaction ID"
                value={customerPaymentEditForm.transactionId}
                onChange={(e) =>
                  setCustomerPaymentEditForm((prev) => ({
                    ...prev,
                    transactionId: e.target.value,
                  }))
                }
              />

              {/* REFERENCE */}
              <label style={labelStyle}>
                Reference
              </label>

              <input
                type="text"
                style={paymentInputStyle}
                placeholder="Enter reference"
                value={customerPaymentEditForm.reference}
                onChange={(e) =>
                  setCustomerPaymentEditForm((prev) => ({
                    ...prev,
                    reference: e.target.value,
                  }))
                }
              />

              {/* NOTES */}
              <label style={labelStyle}>
                Notes
              </label>

              <textarea
                style={{
                  ...paymentInputStyle,
                  minHeight: 85,
                  resize: "vertical",
                }}
                rows="3"
                placeholder="Write payment notes..."
                value={customerPaymentEditForm.description}
                onChange={(e) =>
                  setCustomerPaymentEditForm((prev) => ({
                    ...prev,
                    description: e.target.value,
                  }))
                }
              />

              {/* CORRECTION REASON */}
              <label style={labelStyle}>
                Correction Reason *
              </label>

              <textarea
                required
                style={{
                  ...paymentInputStyle,
                  minHeight: 85,
                  resize: "vertical",
                  borderColor: "#f59e0b",
                }}
                rows="3"
                placeholder="à¦•à§‡à¦¨ à¦à¦‡ Payment à¦¸à¦‚à¦¶à§‹à¦§à¦¨ à¦•à¦°à¦›à§‡à¦¨?"
                value={customerPaymentEditForm.reason}
                onChange={(e) =>
                  setCustomerPaymentEditForm((prev) => ({
                    ...prev,
                    reason: e.target.value,
                  }))
                }
              />

              {/* INFORMATION */}
              <div
                style={{
                  marginTop: 18,
                  padding: 14,
                  background: "#fff7ed",
                  color: "#9a3412",
                  border: "1px solid #fed7aa",
                  borderRadius: 9,
                  fontSize: 13,
                  lineHeight: 1.6,
                }}
              >
                <strong>Payment Correction Notice</strong>
                <div>
                  Payment à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨ à¦•à¦°à¦²à§‡ Customer Ledger Balance à¦ªà§à¦¨à¦°à¦¾à§Ÿ à¦¹à¦¿à¦¸à¦¾à¦¬
                  à¦•à¦°à¦¾ à¦¹à¦¬à§‡à¥¤
                </div>
              </div>
            </div>
          </div>

          {/* FOOTER */}
          <div
            style={{
              padding: "16px 22px",
              borderTop: "1px solid #e2e8f0",
              display: "flex",
              justifyContent: "flex-end",
              gap: 10,
              background: "#fff",
              flexWrap: "wrap",
              flexShrink: 0,
            }}
          >
            <button
              type="button"
              className="secondary-button"
              onClick={() => setShowCustomerPaymentEdit(false)}
              disabled={customerPaymentEditLoading}
            >
              Cancel
            </button>

            <button
              type="submit"
              className="primary-button"
              disabled={
                customerPaymentEditLoading ||
                (needsAccount &&
                  !customerCollectionAccountsLoading &&
                  filteredEditAccounts.length === 0)
              }
            >
              {customerPaymentEditLoading
                ? "Saving..."
                : "Save Correction"}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}



function renderCustomerPaymentVoidModal() {

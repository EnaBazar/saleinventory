                                        <td>à§³ {invoiceSaleAmount.toLocaleString("en-BD", { maximumFractionDigits: 2 })}</td>
                                         <td>à§³ {invoiceTotalCost.toLocaleString("en-BD", { maximumFractionDigits: 2 })}</td>
                                        <td>à§³ {invoiceProfit.toLocaleString("en-BD", { maximumFractionDigits: 2 })}</td>
                                          <td>

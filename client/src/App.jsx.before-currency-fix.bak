    flexWrap: "wrap",
    marginTop: 18,
    padding: 12,
    borderTop: "1px solid #ddd",
  }}
>
  <div>
    <strong>
      Page {ledgerData.pagination?.page || 1}
      {" "}of{" "}
      {ledgerData.pagination?.totalPages || 1}
    </strong>


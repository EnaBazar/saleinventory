        <div style={modalHeaderStyle}>
          <div>
            <h2 style={{ color: "#b91c1c" }}>
              Void Customer Payment
            </h2>
            <p>Payment à¦¬à¦¾à¦¤à¦¿à¦² à¦•à¦°à¦¾à¦° à¦¨à¦¿à¦¶à§à¦šà¦¿à¦¤à¦•à¦°à¦£</p>
          </div>

          <button
            type="button"

        opacity: cancellingSalesInvoice ? 0.6 : 1,
        fontWeight: 600,
      }}
    >
      {cancellingSalesInvoice ? "Cancelling..." : "Cancel Invoice"}
    </button>
  </div>
)}

        </>
      ) : (
        <p>Invoice details à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤</p>
      )}
    </div>
  </div>





)}

{/* ========================================
    SALES RETURN MODAL
======================================== */}
{showSalesReturn && (

      {/* INVOICE TABLE */}
  
{/* INVOICE TABLE */}
<div
  className="table-wrapper"
  style={{
    marginTop: 8,
    border: "1px solid #e2e8f0",
    borderRadius: 8,
    background: "#fff",
    overflowX: "auto",
  }}
>
  <table>
    <thead>
      <tr>
        <th>INVOICE NO</th>
        <th>DATE</th>
        <th>CUSTOMER</th>
        <th>BAGS</th>
        <th>WEIGHT KG</th>
        <th>GRAND TOTAL</th>
        <th>RETURNED BAGS</th>
        <th>RETURNED WEIGHT KG</th>
        <th>RETURN AMOUNT</th>
        <th>NET SALES</th>
        <th>PAID</th>
        <th>DUE</th>
        <th>RETURN STATUS</th>
        <th>STATUS</th>
        <th>ACTION</th>
      </tr>
    </thead>

    <tbody>
      {salesLoading ? (
        <tr>
          <td colSpan={15} style={{ textAlign: "center", padding: 25 }}>
            Loading Sales Invoices...
          </td>
        </tr>
      ) : salesInvoices.length === 0 ? (
        <tr>
          <td colSpan={15} style={{ textAlign: "center", padding: 30 }}>
            No sales invoices found.
          </td>
        </tr>
      ) : salesInvoices.map((invoice) => (
        <tr key={invoice._id}>
          <td>
            <strong>{invoice.invoiceNumber || "-"}</strong>
          </td>

          <td>
            {invoice.invoiceDate
              ? new Date(invoice.invoiceDate).toLocaleDateString("en-GB")
              : "-"}
          </td>

          <td>
            {invoice.customerName ||
              invoice.customerId?.customerName ||
              "-"}
          </td>

          <td>{Number(invoice.totalBags || 0)}</td>

          <td>
            {Number(invoice.totalWeightKg || 0).toLocaleString("en-BD")}
          </td>

          <td style={{ fontWeight: 700 }}>
            à§³ {Number(invoice.grandTotal || 0).toLocaleString("en-BD")}
          </td>

          {/* RETURNED BAGS */}
          <td style={{
            color: Number(invoice.returnedBags || 0) > 0 ? "#ea580c" : "#64748b",
            fontWeight: 700,
          }}>
            {Number(invoice.returnedBags || 0)}
          </td>

          {/* RETURNED WEIGHT */}
          <td style={{
            color: Number(invoice.returnedWeightKg || 0) > 0 ? "#ea580c" : "#64748b",
            fontWeight: 700,
          }}>
            {Number(invoice.returnedWeightKg || 0).toLocaleString("en-BD")}
          </td>

          {/* RETURN AMOUNT */}
          <td style={{
            color: Number(invoice.returnedAmount || 0) > 0 ? "#dc2626" : "#64748b",
            fontWeight: 700,
          }}>
            à§³ {Number(invoice.returnedAmount || 0).toLocaleString("en-BD")}
          </td>

          {/* NET SALES */}
          <td style={{
            fontWeight: 700,
            color: "#15803d",
          }}>
            à§³ {Number(
              invoice.netSalesAmount ?? invoice.grandTotal ?? 0
            ).toLocaleString("en-BD")}
          </td>

          <td>
            à§³ {Number(invoice.paidAmount || 0).toLocaleString("en-BD")}
          </td>

          <td style={{
            color: Number(invoice.dueAmount || 0) > 0 ? "#dc2626" : "#15803d",
            fontWeight: 700,
          }}>
            à§³ {Number(invoice.dueAmount || 0).toLocaleString("en-BD")}
          </td>

          {/* RETURN STATUS */}
          <td>
            <span
              style={{
                display: "inline-block",
                padding: "4px 7px",
                borderRadius: 5,
                fontSize: 10,
                fontWeight: 700,
                whiteSpace: "nowrap",
                background:
                  invoice.returnStatus === "FULL RETURN"
                    ? "#fee2e2"
                    : invoice.returnStatus === "PARTIAL RETURN"
                    ? "#ffedd5"
                    : "#f1f5f9",
                color:
                  invoice.returnStatus === "FULL RETURN"
                    ? "#dc2626"
                    : invoice.returnStatus === "PARTIAL RETURN"
                    ? "#c2410c"
                    : "#64748b",
              }}
            >
              {invoice.returnStatus || "NO RETURN"}
            </span>
          </td>

          <td>{invoice.status || "-"}</td>

          {/* ACTION */}
          <td>
            <div
              style={{
                display: "flex",
                alignItems: "center",
                gap: 5,
                flexWrap: "nowrap",
                whiteSpace: "nowrap",
              }}
            >
              {/* EDIT */}
              {invoice.status === "COMPLETED" && (
                <button
                  type="button"
                  className="secondary-button"
                  onClick={() => editSalesInvoice(invoice._id)}
                  style={{
                    padding: "5px 8px",
                    fontSize: 11,
                    background: "#2563eb",
                    color: "#fff",
                    border: "none",
                    borderRadius: 5,
                  }}
                >
                  Edit
                </button>
              )}

              {/* VIEW */}
              <button
                type="button"
                className="secondary-button"
                onClick={() => loadSalesDetails(invoice._id)}
                style={{ padding: "5px 8px", fontSize: 11 }}
              >
                <FileText size={13} /> View
              </button>

              {/* RETURN */}
              {invoice.status === "COMPLETED" && (
                <button
                  type="button"
                  className="secondary-button"
                  onClick={() => loadSalesReturnDetails(invoice._id)}
                  style={{
                    padding: "5px 8px",
                    fontSize: 11,
                    background: "#ea580c",
                    color: "#fff",
                    border: "none",
                    borderRadius: 5,
                  }}
                >
                  Return
                </button>
              )}

              {/* CANCEL */}
              {invoice.status === "COMPLETED" && (
                <button
                  type="button"
                  disabled={cancellingSalesInvoice}
                  onClick={() => cancelSalesInvoice(invoice._id)}
                  style={{
                    padding: "5px 8px",
                    fontSize: 11,
                    background: "#dc2626",
                    color: "#fff",
                    border: "none",
                    borderRadius: 5,
                    cursor: cancellingSalesInvoice ? "not-allowed" : "pointer",
                  }}
                >
                  Cancel
                </button>
              )}
            </div>
          </td>
        </tr>
      ))}
    </tbody>
   </table>
</div>
        </>
      )}
    </div>

    {/* NEW SALES INVOICE MODAL */}

    {showSalesForm && (
      <div style={{
        ...modalOverlayStyle,
        padding: 8,
        alignItems: "center",
      }}>
        <div style={{
          ...modalStyle,
          width: "98vw",
          maxWidth: 1550,
          height: "96vh",
          maxHeight: "96vh",
          display: "flex",
          flexDirection: "column",
          overflow: "hidden",
          padding: 0,
          borderRadius: 10,
          background: "#f8fafc",
        }}>

          {/* MODAL HEADER */}
          <div style={{
            ...modalHeaderStyle,
            flexShrink: 0,
            padding: "12px 18px",
            background: "#172554",
            color: "#fff",
            borderBottom: "3px solid #f97316",
          }}>
            <div>
           <h2 style={{ margin: 0, fontSize: 18, fontWeight: 800 }}>
  {editingSalesInvoiceId ? "Edit Sales Invoice" : "New Sales Invoice"}
</h2>
              <p style={{ margin: "3px 0 0", fontSize: 11, color: "#cbd5e1" }}>
                Customer Sales & Inventory Transaction
              </p>
            </div>

            <button
              type="button"
              onClick={() => setShowSalesForm(false)}
              style={{ color: "#fff" }}
            >
              <X size={20} />
            </button>
          </div>

          {/* MODAL BODY */}
          <div style={{
            padding: "12px 15px",
            flex: 1,
            minHeight: 0,
            overflowY: "auto",
            overflowX: "hidden",
            background: "#f1f5f9",
          }}>

            {/* 01 CUSTOMER INFORMATION */}
            <div style={sectionStyle}>
              <h3 style={sectionHeading}>
                <span style={{ color: "#f97316" }}>01.</span>
                Customer Information
              </h3>

              <div style={{
                display: "grid",
                gridTemplateColumns: "minmax(0, 2.5fr) minmax(180px, 1fr)",
                gap: 10,
                alignItems: "end",
              }}>
                <div style={{ position: "relative" }}>
                  <label style={fieldLabel}>Customer Name / Mobile *</label>
                  <input
                    style={compactInput}
                    placeholder="Search customer name or mobile..."
                    value={salesCustomerSearch}
                    onChange={(e) => searchSalesCustomers(e.target.value)}
                    onFocus={() => setShowSalesCustomerOptions(true)}
                  />

                  {salesCustomerLoading && (
                    <small style={{ color: "#64748b" }}>Searching customers...</small>
                  )}

                  {showSalesCustomerOptions && salesCustomerOptions.length > 0 && (
                    <div style={{
                      position: "absolute",
                      top: "100%",
                      left: 0,
                      right: 0,
                      zIndex: 30,
                      background: "#fff",
                      border: "1px solid #cbd5e1",
                      borderRadius: 7,
                      maxHeight: 220,
                      overflowY: "auto",
                      boxShadow: "0 6px 18px rgba(15,23,42,.12)",
                    }}>
                      {salesCustomerOptions.map((customer) => (
                        <button
                          type="button"
                          key={customer._id}
                          onClick={() => selectSalesCustomer(customer)}
                          style={{
                            display: "block",
                            width: "100%",
                            padding: "9px 11px",
                            textAlign: "left",
                            border: "none",
                            borderBottom: "1px solid #f1f5f9",
                            background: "#fff",
                            cursor: "pointer",
                          }}
                        >
                          <strong style={{ fontSize: 12 }}>
                            {customer.customerName}
                          </strong>
                          <div style={{ fontSize: 11, color: "#64748b", marginTop: 2 }}>
                            {customer.mobile || "-"}
                            {customer.companyName ? ` | ${customer.companyName}` : ""}
                          </div>
                        </button>
                      ))}
                    </div>
                  )}
                </div>

                <div>
                  <label style={fieldLabel}>Invoice Date *</label>
                  <input
                    type="date"
                    style={compactInput}
                    value={salesForm.invoiceDate}
                    onChange={(e) => updateSalesFormField("invoiceDate", e.target.value)}
                  />
                </div>
              </div>

              {selectedSalesCustomer && (
                <div style={{
                  marginTop: 9,
                  padding: "8px 11px",
                  background: "#f0fdf4",
                  border: "1px solid #bbf7d0",
                  borderRadius: 6,
                  display: "flex",
                  gap: 14,
                  alignItems: "center",
                  flexWrap: "wrap",
                  fontSize: 11,
                }}>
                  <strong style={{ color: "#166534" }}>
                    {selectedSalesCustomer.customerName}
                  </strong>
                  <span>{selectedSalesCustomer.mobile || "-"}</span>
                  <span>{selectedSalesCustomer.address || "-"}</span>
                  <strong style={{ color: "#166534" }}>
                    Current Balance: à§³ {salesPreviousDue.toLocaleString("en-BD")}
                  </strong>
                </div>
              )}
            </div>

            {/* 02 PRODUCT AND LOT */}
            <div style={sectionStyle}>
              <h3 style={sectionHeading}>
                <span style={{ color: "#f97316" }}>02.</span>
                Product & Lot Selection
              </h3>

              <div style={{
                display: "grid",
                gridTemplateColumns: "minmax(0, 1.6fr) minmax(0, 1fr)",
                gap: 10,
              }}>
                <div style={{ position: "relative" }}>
                  <label style={fieldLabel}>Search Product *</label>
                  <input
                    style={compactInput}
                    placeholder="Search product name..."
                    value={salesProductSearch}
                    onChange={(e) => searchSalesProducts(e.target.value)}
                    onFocus={() => setShowSalesProductOptions(true)}
                  />

                  {salesProductLoading && (
                    <small style={{ color: "#64748b" }}>Searching products...</small>
                  )}

                  {showSalesProductOptions && salesProductOptions.length > 0 && (
                    <div style={{
                      position: "absolute",
                      top: "100%",
                      left: 0,
                      right: 0,
                      zIndex: 30,
                      background: "#fff",
                      border: "1px solid #cbd5e1",
                      borderRadius: 7,
                      maxHeight: 220,
                      overflowY: "auto",
                      boxShadow: "0 6px 18px rgba(15,23,42,.12)",
                    }}>
                      {salesProductOptions.map((product) => (
                        <button
                          type="button"
                          key={product._id}
                          onClick={() => selectSalesProduct(product)}
                          style={{
                            display: "block",
                            width: "100%",
                            padding: "9px 11px",
                            textAlign: "left",
                            border: "none",
                            borderBottom: "1px solid #f1f5f9",
                            background: "#fff",
                            cursor: "pointer",
                          }}
                        >
                          <strong style={{ fontSize: 12 }}>
                            {product.productName}
                          </strong>
                          <div style={{ fontSize: 11, color: "#64748b", marginTop: 2 }}>
                            {product.stockType || "-"} | Stock: {product.currentStockBags || 0} Bags / {product.currentStockKg || 0} KG
                          </div>
                        </button>
                      ))}
                    </div>
                  )}
                </div>

                <div>
                  <label style={fieldLabel}>Select Available Lot *</label>
                  <select
                    style={compactInput}
                    value={selectedSalesLot?._id || ""}
                    onChange={(e) => selectSalesLot(e.target.value)}
                    disabled={!selectedSalesProduct || salesLotLoading}
                  >
                    <option value="">
                      {salesLotLoading ? "Loading lots..." : "Select available lot"}
                    </option>
                    {salesAvailableLots.map((lot) => (
                      <option key={lot._id} value={lot._id}>
                        {lot.lotCode} | {lot.stockType} | {lot.remainingBags} Bags | {lot.remainingWeightKg} KG
                      </option>
                    ))}
                  </select>
                </div>
              </div>

              {selectedSalesLot && (
                <div style={{
                  marginTop: 9,
                  padding: "8px 11px",
                  border: "1px solid #bfdbfe",
                  background: "#eff6ff",
                  borderRadius: 6,
                  fontSize: 11,
                  display: "flex",
                  gap: 14,
                  flexWrap: "wrap",
                }}>
                  <span><strong>Lot:</strong> {selectedSalesLot.lotCode}</span>
                  <span><strong>Type:</strong> {selectedSalesLot.stockType}</span>
                  <span>
                    <strong>Supplier:</strong>{" "}
                    {selectedSalesLot.supplierId?.supplierName || selectedSalesLot.supplierName || "-"}
                  </span>
                  <span><strong>Available:</strong> {selectedSalesLot.remainingBags} Bags</span>
                  <span><strong>Remaining:</strong> {selectedSalesLot.remainingWeightKg} KG</span>
                </div>
              )}
            </div>

            {/* 03 SALES ENTRY */}
            <div style={sectionStyle}>
              <h3 style={sectionHeading}>
                <span style={{ color: "#f97316" }}>03.</span>
                Sales Entry
              </h3>

              <div style={{
                display: "grid",
                gridTemplateColumns: "repeat(5, minmax(100px, 1fr))",
                gap: 8,
              }}>
                <div>
                  <label style={fieldLabel}>Bags *</label>
                  <input
                    type="number"
                    min="1"
                    style={compactInput}
                    value={salesLineForm.bags}
                    onChange={(e) => updateSalesLineField("bags", e.target.value)}
                    placeholder="Bags"
                  />
                </div>

                <div>
                  <label style={fieldLabel}>Weight KG *</label>
                  <input
                    type="number"
                    min="0.01"
                    step="0.01"
                    style={compactInput}
                    value={salesLineForm.weightKg}
                    onChange={(e) => updateSalesLineField("weightKg", e.target.value)}
                    placeholder="Weight"
                  />
                </div>

                <div>
                  <label style={fieldLabel}>Sale Rate / KG *</label>
                  <input
                    type="number"
                    min="0"
                    step="0.01"
                    style={compactInput}
                    value={salesLineForm.saleRatePerKg}
                    onChange={(e) => updateSalesLineField("saleRatePerKg", e.target.value)}
                    placeholder="Sale rate"
                  />
                </div>

                <div>
                  <label style={fieldLabel}>Commission / KG</label>
                  <input
                    type="number"
                    min="0"
                    step="0.01"
                    style={compactInput}
                    value={salesLineForm.commissionRatePerKg}
                    onChange={(e) => updateSalesLineField("commissionRatePerKg", e.target.value)}
                    placeholder="Commission"
                  />
                </div>

                <div>
                  <label style={fieldLabel}>Labour / Bag</label>
                  <input
                    type="number"
                    min="0"
                    step="0.01"
                    style={compactInput}
                    value={salesLineForm.labourRatePerBag}
                    onChange={(e) => updateSalesLineField("labourRatePerBag", e.target.value)}
                    placeholder="Labour"
                  />
                </div>
              </div>

              <div style={{
                display: "flex",
                justifyContent: "flex-end",
                marginTop: 10,
              }}>
                <button
                  type="button"
                  className="primary-button"
                  onClick={addSalesItem}
                  style={{ background: "#f97316", borderColor: "#f97316" }}
                >
                  <Plus size={16} /> Add Product to Invoice
                </button>
              </div>
            </div>

            {/* 04 INVOICE ITEMS */}
            <div style={sectionStyle}>
              <h3 style={sectionHeading}>
                <span style={{ color: "#f97316" }}>04.</span>
                Invoice Items
                <span style={{ fontSize: 10, color: "#64748b", fontWeight: 600 }}>
                  ({salesItems.length} items)
                </span>
              </h3>

              <div className="table-wrapper" style={{
                marginTop: 5,
                overflowX: "auto",
              }}>
                <table>
                  <thead>
                    <tr>
                      <th>PRODUCT / LOT</th>
                      <th>TYPE</th>
                      <th>BAGS</th>
                      <th>KG</th>
                      <th>SALE RATE</th>
                      <th>COMMISSION</th>
                      <th>LABOUR</th>
                      <th>TOTAL</th>
                      <th>ACTION</th>
                    </tr>
                  </thead>

                  <tbody>
                    {salesItems.length === 0 ? (
                      <tr>
                        <td colSpan={9} style={{
                          textAlign: "center",
                          padding: 22,
                          color: "#94a3b8",
                          fontSize: 12,
                        }}>
                          No products added yet. Select a product and lot above.
                        </td>
                      </tr>
                    ) : salesItems.map((item, index) => (
                      <tr key={`${item.lotId}-${index}`}>
                        <td>
                          <strong style={{ fontSize: 11 }}>{item.productName}</strong>
                          <div style={{ fontSize: 10, color: "#64748b" }}>
                            {item.lotCode}
                          </div>
                        </td>

                        <td>{item.stockType}</td>

                        <td>
                          <input
                            type="number"
                            min="1"
                            style={{ ...compactInput, width: 65, height: 30, padding: "3px 5px" }}
                            value={item.bags}
                            onChange={(e) => updateSalesItem(index, "bags", e.target.value)}
                          />
                        </td>

                        <td>
                          <input
                            type="number"
                            min="0.01"
                            step="0.01"
                            style={{ ...compactInput, width: 75, height: 30, padding: "3px 5px" }}
                            value={item.weightKg}
                            onChange={(e) => updateSalesItem(index, "weightKg", e.target.value)}
                          />
                        </td>

                        <td>
                          <input
                            type="number"
                            min="0"
                            style={{ ...compactInput, width: 80, height: 30, padding: "3px 5px" }}
                            value={item.saleRatePerKg}
                            onChange={(e) => updateSalesItem(index, "saleRatePerKg", e.target.value)}
                          />
                        </td>

                        <td>
                          <input
                            type="number"
                            min="0"
                            style={{ ...compactInput, width: 80, height: 30, padding: "3px 5px" }}
                            value={item.commissionRatePerKg}
                            onChange={(e) => updateSalesItem(index, "commissionRatePerKg", e.target.value)}
                          />
                        </td>

                        <td>
                          <input
                            type="number"
                            min="0"
                            style={{ ...compactInput, width: 80, height: 30, padding: "3px 5px" }}
                            value={item.labourRatePerBag}
                            onChange={(e) => updateSalesItem(index, "labourRatePerBag", e.target.value)}
                          />
                        </td>

                        <td style={{ fontWeight: 700, whiteSpace: "nowrap" }}>
                          à§³ {Number(item.lineTotal || 0).toLocaleString("en-BD")}
                        </td>

                        <td>
                          <button
                            type="button"
                            className="secondary-button"
                            onClick={() => removeSalesItem(index)}
                            style={{ padding: "5px 8px", fontSize: 11 }}
                          >
                            <Trash2 size={13} /> Remove
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            {/* 05 PAYMENT AND CHARGES */}
            <div style={sectionStyle}>
              <h3 style={sectionHeading}>
                <span style={{ color: "#f97316" }}>05.</span>
                Payment & Additional Charges
              </h3>

              <div style={{
                display: "grid",
                gridTemplateColumns: "repeat(6, minmax(110px, 1fr))",
                gap: 8,
              }}>
                <div>
                  <label style={fieldLabel}>Other Cost</label>
                  <input
                    type="number"
                    min="0"
                    style={compactInput}
                    value={salesForm.otherCost}
                    onChange={(e) => updateSalesFormField("otherCost", e.target.value)}
                    placeholder="0"
                  />
                </div>

                <div>
                  <label style={fieldLabel}>Discount</label>
                  <input
                    type="number"
                    min="0"
                    style={compactInput}
                    value={salesForm.discount}
                    onChange={(e) => updateSalesFormField("discount", e.target.value)}
                    placeholder="0"
                  />
                </div>

                <div>
                  <label style={fieldLabel}>Paid Amount</label>
                  <input
                    type="number"
                    min="0"
                    style={compactInput}
                    value={salesForm.paidAmount}
                    onChange={(e) => updateSalesFormField("paidAmount", e.target.value)}
                    placeholder="0"
                  />
                </div>

                <div>
                  <label style={fieldLabel}>Payment Method</label>
                  <select
                    style={compactInput}
                    value={salesForm.paymentMethod}
                    onChange={(e) => updateSalesFormField("paymentMethod", e.target.value)}
                  >
                    <option value="CASH">Cash</option>
                    <option value="BANK">Bank</option>
                    <option value="BKASH">bKash</option>
                    <option value="DUE">Due</option>
                  </select>
                </div>

{/* Payment Account */}
{Number(salesForm.paidAmount) > 0 &&
  ["CASH", "BANK", "BKASH"].includes(salesForm.paymentMethod) && (
    <div>
      <label style={fieldLabel}>Payment Account</label>
      <select
        style={compactInput}
        value={salesForm.accountId || ""}
        onChange={(e) =>
          updateSalesFormField("accountId", e.target.value)
        }
        disabled={accountsLoading}
      >
        <option value="">
          {accountsLoading ? "Loading Accounts..." : "Select Account"}
        </option>

        {accounts
          .filter(
            (account) =>
              account.accountType === salesForm.paymentMethod &&
              account.isActive !== false
          )
          .map((account) => (
            <option key={account._id} value={account._id}>
              {account.accountName}
              {account.bankName ? ` - ${account.bankName}` : ""}
              {account.accountNumber ? ` (${account.accountNumber})` : ""}
            </option>
          ))}
      </select>
    </div>
  )}


                <div>
                  <label style={fieldLabel}>Payment Reference</label>
                  <input
                    style={compactInput}
                    value={salesForm.paymentReference}
                    onChange={(e) => updateSalesFormField("paymentReference", e.target.value)}
                    placeholder="Transaction ID"
                  />
                </div>

                <div>
                  <label style={fieldLabel}>Notes</label>
                  <input
                    style={compactInput}
                    value={salesForm.notes}
                    onChange={(e) => updateSalesFormField("notes", e.target.value)}
                    placeholder="Invoice notes"
                  />
                </div>
              </div>
            </div>

            {/* 06 INVOICE SUMMARY */}
            <div style={{
              ...sectionStyle,
              background: "#fff",
              border: "1px solid #cbd5e1",
              marginBottom: 4,
            }}>
              <h3 style={sectionHeading}>
                <span style={{ color: "#f97316" }}>06.</span>
                Invoice Summary
              </h3>

              <div style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit, minmax(125px, 1fr))",
                gap: 8,
              }}>
                {[
                  {
                    label: "Product Total",
                    amount: salesSummary.productTotal,
                    color: "#2563eb",
                  },
                  {
                    label: "Commission Total",
                    amount: salesSummary.totalCommission,
                    color: "#7c3aed",
                  },
                  {
                    label: "Labour Total",
                    amount: salesSummary.totalLabour,
                    color: "#0891b2",
                  },
                  {
                    label: "Other Cost",
                    amount: Number(salesForm.otherCost || 0),
                    color: "#475569",
                  },
                  {
                    label: "Discount",
                    amount: Number(salesForm.discount || 0),
                    color: "#dc2626",
                  },
                ].map((item) => (
                  <div key={item.label} style={{
                    background: "#f8fafc",
                    border: "1px solid #e2e8f0",
                    borderRadius: 7,
                    padding: "9px 10px",
                    minWidth: 0,
                  }}>
                    <div style={{
                      fontSize: 10,
                      color: "#64748b",
                      marginBottom: 5,
                      fontWeight: 700,
                    }}>
                      {item.label}
                    </div>
                    <div style={{
                      fontSize: 14,
                      fontWeight: 800,
                      color: item.color,
                      overflowWrap: "anywhere",
                    }}>
                      à§³ {Number(item.amount || 0).toLocaleString("en-BD")}
                    </div>
                  </div>
                ))}
              </div>

              {/* INVOICE TOTAL */}
              <div style={{
                marginTop: 9,
                padding: "12px 15px",
                background: "#172554",
                borderRadius: 7,
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
                gap: 10,
              }}>
                <strong style={{ color: "#fff", fontSize: 14 }}>
                  Invoice Total
                </strong>
                <strong style={{ fontSize: 21, color: "#fed7aa" }}>
                  à§³ {salesGrandTotal.toLocaleString("en-BD")}
                </strong>
              </div>

              {/* CUSTOMER BALANCE SUMMARY */}
              <div style={{
                display: "grid",
                gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
                gap: 8,
                marginTop: 9,
              }}>
                {[
                  {
                    label: "Previous Customer Due",
                    amount: salesPreviousDue,
                    color: "#64748b",
                  },
                  {
                    label: "Total Payable",
                    amount: salesTotalPayable,
                    color: "#1d4ed8",
                  },
                  {
                    label: "Paid Amount",
                    amount: salesPaidAmount,
                    color: "#15803d",
                  },
                ].map((item) => (
                  <div key={item.label} style={{
                    background: "#f8fafc",
                    border: "1px solid #e2e8f0",
                    borderRadius: 7,
                    padding: "9px 10px",
                    minWidth: 0,
                  }}>
                    <div style={{
                      fontSize: 10,
                      color: "#64748b",
                      marginBottom: 5,
                      fontWeight: 700,
                    }}>
                      {item.label}
                    </div>
                    <strong style={{
                      color: item.color,
                      fontSize: 14,
                      overflowWrap: "anywhere",
                    }}>
                      à§³ {Number(item.amount || 0).toLocaleString("en-BD")}
                    </strong>
                  </div>
                ))}
              </div>

              {/* OUTSTANDING DUE */}
              <div style={{
                marginTop: 9,
                padding: "12px 15px",
                borderRadius: 7,
                background: "#fef2f2",
                border: "1px solid #fecaca",
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
                gap: 10,
              }}>
                <strong style={{ color: "#991b1b", fontSize: 14 }}>
                  Outstanding Due
                </strong>
                <strong style={{ color: "#dc2626", fontSize: 21 }}>
                  à§³ {salesDueAmount.toLocaleString("en-BD")}
                </strong>
              </div>
            </div>
          </div>

          {/* FIXED FOOTER */}
          <div style={{
            ...modalFooterStyle,
            flexShrink: 0,
            padding: "10px 18px",
            background: "#fff",
            borderTop: "1px solid #e2e8f0",
            position: "relative",
            zIndex: 5,
          }}>
            <button
              type="button"
              className="secondary-button"
              onClick={() => setShowSalesForm(false)}
              disabled={salesSaving}
            >
              Close
            </button>

            <button
              type="button"
              className="primary-button"
              onClick={saveSalesInvoice}
              disabled={salesSaving}
            >
{salesSaving
  ? "Saving..."
  : editingSalesInvoiceId
    ? "Update Sales Invoice"
    : "Save Sales Invoice"}
            </button>
          </div>
        </div>
      </div>
    )}

{/* SALES INVOICE DETAILS MODAL */}
{showSalesDetails && (
  <div
    style={{
      position: "fixed",
      inset: 0,
      background: "rgba(15, 23, 42, 0.55)",
      zIndex: 9999,
      display: "flex",
      justifyContent: "center",
      alignItems: "center",
      padding: 15,
    }}
    onClick={() => setShowSalesDetails(false)}
  >
    <div
      style={{
        width: "100%",
        maxWidth: 850,
        maxHeight: "90vh",
        overflowY: "auto",
        background: "#fff",
        borderRadius: 12,
        padding: 22,
      }}
      onClick={(e) => e.stopPropagation()}
    >
      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          marginBottom: 20,
        }}
      >
        <h3 style={{ margin: 0 }}>Sales Invoice Details</h3>

        <button
          type="button"
          className="secondary-button"
          onClick={() => setShowSalesDetails(false)}
        >
          âœ• Close
        </button>
      </div>

      {salesDetailsLoading ? (
        <p style={{ textAlign: "center", padding: 30 }}>
          Loading invoice details...
        </p>
      ) : selectedSalesInvoice ? (

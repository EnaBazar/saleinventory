      </button>
    </div>
  </div>

  {/* à¦à¦–à¦¾à¦¨ à¦¥à§‡à¦•à§‡ à¦†à¦ªà¦¨à¦¾à¦° à¦†à¦—à§‡à¦° PURCHASE HISTORY FILTER à¦•à§‹à¦¡ à¦šà¦²à¦¬à§‡ */}


        {/* PURCHASE HISTORY FILTER */}
     <div
  className="purchase-history-filter-panel"
  style={{
    marginTop: 18,
            padding: 18,
            border: "1px solid #e2e8f0",
            borderRadius: 12,
            background: "#f8fafc",
          }}
        >
          <h3 style={{ margin: "0 0 15px", fontSize: 16 }}>
            Purchase History Filters
          </h3>

          <div
            style={{
              display: "grid",
              gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
              gap: 14,
            }}
          >
            <div>
              <label>Start Date</label>
              <input
                type="date"
                style={inputStyle}
                value={purchaseFilters.startDate}
                onChange={(e) =>
                  setPurchaseFilters((prev) => ({
                    ...prev,
                    startDate: e.target.value,
                  }))
                }
              />
            </div>

            <div>
              <label>End Date</label>
              <input
                type="date"
                style={inputStyle}
                value={purchaseFilters.endDate}
                onChange={(e) =>
                  setPurchaseFilters((prev) => ({
                    ...prev,
                    endDate: e.target.value,
                  }))
                }
              />
            </div>

            <div>
              <label>Supplier Name</label>
              <input
                style={inputStyle}
                placeholder="Search supplier..."
                value={purchaseFilters.supplier}
                onChange={(e) =>
                  setPurchaseFilters((prev) => ({
                    ...prev,
                    supplier: e.target.value,
                  }))
                }
              />
            </div>

            <div>
              <label>Product Name</label>
              <input
                style={inputStyle}
                placeholder="Search product..."
                value={purchaseFilters.product}
                onChange={(e) =>
                  setPurchaseFilters((prev) => ({
                    ...prev,
                    product: e.target.value,
                  }))
                }
              />
            </div>


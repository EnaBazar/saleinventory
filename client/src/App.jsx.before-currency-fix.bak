                </h4>
              </div>

              <div>
                <small style={{ color: "#64748b" }}>Loan Type</small>
                <h4 style={{ margin: "5px 0" }}>
                  {selectedTransaction.loanType}
                </h4>
              </div>

              <div>
                <small style={{ color: "#64748b" }}>Principal</small>
                <h4 style={{ margin: "5px 0" }}>
                  à§³{formatAmount(selectedTransaction.principalAmount)}
                </h4>
              </div>

              <div>
                <small style={{ color: "#64748b" }}>Interest</small>
                <h4 style={{ margin: "5px 0" }}>
                  à§³{formatAmount(selectedTransaction.interestAmount)}
                </h4>
              </div>

              <div>
                <small style={{ color: "#64748b" }}>Total Amount</small>
                <h4 style={{ margin: "5px 0" }}>
                  à§³{formatAmount(selectedTransaction.totalAmount)}
                </h4>
              </div>
            </div>
          </div>

          <div className="panel" style={{ padding: 22 }}>
            <h3 style={{ margin: "0 0 18px", color: "#1e293b" }}>
              2. Correction Method
            </h3>

            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit, minmax(230px, 1fr))",
                gap: 14,
              }}
            >
              <label
                style={{
                  display: "flex",
                  alignItems: "flex-start",
                  gap: 10,
                  padding: 15,
                  border: `1px solid ${
                    loanAdjustmentMethod === "DIRECT_EDIT"
                      ? "#2563eb"
                      : "#e2e8f0"
                  }`,
                  borderRadius: 10,
                  cursor: "pointer",
                  background:
                    loanAdjustmentMethod === "DIRECT_EDIT"
                      ? "#eff6ff"
                      : "#fff",
                }}
              >
                <input
                  type="radio"
                  name="loanAdjustmentMethod"
                  value="DIRECT_EDIT"
                  checked={loanAdjustmentMethod === "DIRECT_EDIT"}
                  onChange={(e) =>
                    setLoanAdjustmentMethod(e.target.value)
                  }
                  style={{ marginTop: 3 }}
                />
                <span>
                  <strong>Direct Edit</strong>
                  <small
                    style={{
                      display: "block",
                      marginTop: 5,
                      color: "#64748b",
                    }}
                  >
                    à¦ªà§à¦°à§‹à¦¨à§‹ Transaction à¦¸à¦°à¦¾à¦¸à¦°à¦¿ à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨ à¦¹à¦¬à§‡à¥¤
                  </small>
                </span>
              </label>

              <label
                style={{
                  display: "flex",
                  alignItems: "flex-start",
                  gap: 10,
                  padding: 15,
                  border: `1px solid ${
                    loanAdjustmentMethod === "REVERSE_NEW"
                      ? "#2563eb"
                      : "#e2e8f0"
                  }`,
                  borderRadius: 10,
                  cursor: "pointer",
                  background:
                    loanAdjustmentMethod === "REVERSE_NEW"
                      ? "#eff6ff"
                      : "#fff",
                }}
              >
                <input
                  type="radio"
                  name="loanAdjustmentMethod"
                  value="REVERSE_NEW"
                  checked={loanAdjustmentMethod === "REVERSE_NEW"}
                  onChange={(e) =>
                    setLoanAdjustmentMethod(e.target.value)
                  }
                  style={{ marginTop: 3 }}
                />
                <span>
                  <strong>Reverse + New Entry</strong>
                  <small
                    style={{
                      display: "block",
                      marginTop: 5,
                      color: "#64748b",
                    }}
                  >
                    à¦ªà§à¦°à§‹à¦¨à§‹ Entry à¦¬à¦¾à¦¤à¦¿à¦² à¦¹à¦¬à§‡ à¦à¦¬à¦‚ à¦¨à¦¤à§à¦¨ Entry à¦¤à§ˆà¦°à¦¿ à¦¹à¦¬à§‡à¥¤
                  </small>
                </span>
              </label>
            </div>

            <div
              style={{
                marginTop: 20,
                padding: 14,
                background: "#fff7ed",
                border: "1px solid #fed7aa",
                borderRadius: 9,
                color: "#9a3412",
                fontSize: 13,
              }}
            >
              à¦¸à¦¤à¦°à§à¦•à¦¤à¦¾: à¦à¦‡ Correction Loan Balance à¦à¦¬à¦‚ à¦¸à¦‚à¦¶à§à¦²à¦¿à¦·à§à¦Ÿ Account
              Ledger-à¦ à¦ªà§à¦°à¦­à¦¾à¦¬ à¦«à§‡à¦²à¦¬à§‡à¥¤ Save à¦•à¦°à¦¾à¦° à¦†à¦—à§‡ à¦¸à¦¬ à¦¤à¦¥à§à¦¯ à¦¯à¦¾à¦šà¦¾à¦‡ à¦•à¦°à§à¦¨à¥¤
            </div>
          </div>

          <div className="panel" style={{ padding: 22 }}>
            <h3 style={{ margin: "0 0 18px", color: "#1e293b" }}>
              3. Correct Transaction Details
            </h3>

            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))",
                gap: 16,
              }}
            >
              <div style={fieldStyle}>
                <label style={labelStyle}>Provider *</label>
                <select
                  value={loanAdjustmentForm.providerId}
                  onChange={(e) =>
                    setLoanAdjustmentForm((prev) => ({
                      ...prev,
                      providerId: e.target.value,
                    }))
                  }
                  style={inputStyle}
                >
                  {loanReportProviders.map((provider) => (
                    <option key={provider._id} value={provider._id}>
                      {provider.providerName}
                    </option>
                  ))}
                </select>
              </div>

              <div style={fieldStyle}>
                <label style={labelStyle}>Account *</label>
                <select
                  value={loanAdjustmentForm.accountId}
                  onChange={(e) =>
                    setLoanAdjustmentForm((prev) => ({
                      ...prev,
                      accountId: e.target.value,
                    }))
                  }
                  style={inputStyle}
                >
                  <option value="">Select Account</option>
                  {accounts
                    .filter((account) => account.isActive !== false)
                    .map((account) => (
                      <option key={account._id} value={account._id}>
                        {account.accountName} ({account.accountType})
                      </option>
                    ))}
                </select>
              </div>

              <div style={fieldStyle}>
                <label style={labelStyle}>Principal Amount *</label>
                <input
                  type="number"
                  min="0"
                  step="0.01"
                  value={loanAdjustmentForm.principalAmount}
                  onChange={(e) =>
                    setLoanAdjustmentForm((prev) => ({
                      ...prev,
                      principalAmount: e.target.value,
                    }))
                  }
                  style={inputStyle}
                />
              </div>

              <div style={fieldStyle}>
                <label style={labelStyle}>Interest Amount</label>
                <input
                  type="number"
                  min="0"
                  step="0.01"
                  value={loanAdjustmentForm.interestAmount}
                  disabled={selectedTransaction.loanType === "BANK"}
                  onChange={(e) =>
                    setLoanAdjustmentForm((prev) => ({
                      ...prev,
                      interestAmount: e.target.value,
                    }))
                  }
                  style={inputStyle}
                />
              </div>

              <div style={fieldStyle}>
                <label style={labelStyle}>Transaction Date *</label>
                <input
                  type="date"
                  value={loanAdjustmentForm.transactionDate}
                  onChange={(e) =>
                    setLoanAdjustmentForm((prev) => ({
                      ...prev,
                      transactionDate: e.target.value,
                    }))
                  }
                  style={inputStyle}
                />
              </div>

              <div style={fieldStyle}>
                <label style={labelStyle}>Reference</label>
                <input
                  type="text"
                  value={loanAdjustmentForm.reference}
                  onChange={(e) =>
                    setLoanAdjustmentForm((prev) => ({
                      ...prev,
                      reference: e.target.value,
                    }))
                  }
                  style={inputStyle}
                />
              </div>

              <div style={{ ...fieldStyle, gridColumn: "1 / -1" }}>
                <label style={labelStyle}>Description</label>
                <textarea
                  rows={3}
                  value={loanAdjustmentForm.description}
                  onChange={(e) =>
                    setLoanAdjustmentForm((prev) => ({
                      ...prev,
                      description: e.target.value,
                    }))
                  }
                  style={{ ...inputStyle, resize: "vertical" }}
                />
              </div>

              <div style={{ ...fieldStyle, gridColumn: "1 / -1" }}>
                <label style={labelStyle}>Correction Reason *</label>
                <textarea
                  rows={3}
                  value={loanAdjustmentReason}
                  onChange={(e) =>
                    setLoanAdjustmentReason(e.target.value)
                  }
                  placeholder="à¦•à§‡à¦¨ à¦à¦‡ Transaction à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨ à¦•à¦°à¦›à§‡à¦¨ à¦¤à¦¾ à¦²à¦¿à¦–à§à¦¨..."
                  style={{ ...inputStyle, resize: "vertical" }}
                />
              </div>
            </div>

            <div
              style={{
                display: "flex",
                justifyContent: "flex-end",
                marginTop: 22,
              }}
            >
              <button
                type="button"
                className="primary-button"
                onClick={handleAdjustmentSubmit}
                disabled={loanAdjustmentSaving}
                style={{ minWidth: 190 }}
              >
                {loanAdjustmentSaving
                  ? "Processing..."

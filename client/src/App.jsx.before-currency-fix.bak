// ADMIN LOGOUT
async function handleAdminLogout() {
  try {
    await apiRequest("/auth/logout", {
      method: "POST",
    });

    setAdminUser(null);
  } catch (error) {
    alert(error.message || "Logout à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
  }
}


  return (
    <div className="erp-app">
      <Toaster position="top-right" />

      {sidebarOpen && (
        <div className="sidebar-overlay" onClick={() => setSidebarOpen(false)} />
      )}

      <aside className={`sidebar ${sidebarOpen ? "sidebar-open" : ""}`}>
        <div className="brand">
          <div className="brand-logo">M</div>
          <div className="brand-text">
            <h2>Makkah Traders</h2>
            <span>Sale Management System</span>
          </div>
          <button className="mobile-close" onClick={() => setSidebarOpen(false)}>
            <X size={20} />
          </button>
        </div>

        <div className="company-switch">
          <div className="company-avatar">B</div>
          <div className="company-info">
            <strong>My Business</strong>
            <span>Business Owner</span>
          </div>
          <ChevronDown size={17} />
        </div>

        <nav className="navigation">
       {navigation.map((group) => (
  <div className="nav-group" key={group.title}>
    <p className="nav-heading">{group.title}</p>

    {group.items.map((item) => {
      const Icon = item.icon;
      const hasChildren = Array.isArray(item.children);
      const isExpanded = expandedMenus[item.label] || false;

      return (
        <div key={item.label}>
          <button
            className={`nav-item ${
              activePage === item.label ||
              (hasChildren &&
                item.children.some(
                  (child) => child.label === activePage
                ))
                ? "active"
                : ""
            }`}
           onClick={() => {
  if (hasChildren) {
    setExpandedMenus((prev) =>
      prev[item.label] ? {} : { [item.label]: true }
    );
    return;
  }

  setExpandedMenus({});
  setActivePage(item.label);
  setSearchText("");
  setShowForm(false);
  setSidebarOpen(false);
}}
          >
            <Icon size={19} />

            <span>{item.label}</span>

            {item.label === "Products" && (
              <span className="nav-count">{products.length}</span>
            )}

            {hasChildren && (
              <span
                style={{
                  marginLeft: "auto",
                  fontSize: 12,
                  transform: isExpanded ? "rotate(180deg)" : "rotate(0deg)",
                  transition: "transform 0.2s ease",
                }}
              >
                â–¼
              </span>
            )}
          </button>

      {hasChildren && (
  <div
    className={`submenu-container ${isExpanded ? "submenu-open" : ""}`}
    style={{
      marginLeft: 18,
      paddingLeft: 12,
      borderLeft: "2px solid var(--border-color, #e5e7eb)",
    }}
  >
    {isExpanded && item.children.map((child) => {
      const ChildIcon = child.icon;

      return (
        <button
          key={child.label}
          className={`nav-item ${
            activePage === child.label ? "active" : ""
          }`}
          style={{
            fontSize: 13,
            paddingLeft: 10,
          }}
          onClick={() => {
            setExpandedMenus({});
            setActivePage(child.label);
            setSearchText("");
            setShowForm(false);
            setSidebarOpen(false);
          }}
        >
          <ChildIcon size={17} />
          <span>{child.label}</span>
        </button>
      );
    })}
  </div>
)}
        </div>
      );
    })}
  </div>
))}
        </nav>

        <div className="sidebar-bottom">
          <div className="help-card">
            <div className="help-icon">?</div>
            <strong>Need Help?</strong>
            <p>Contact our support team anytime.</p>
            <button>Get Support</button>
          </div>
        
<button
  className="nav-item logout"
  onClick={handleAdminLogout}
>
  <LogOut size={19} />
  <span>Sign Out</span>
</button>

        </div>
      </aside>

      <main className="main-content">
        <header className="topbar">
          <div className="topbar-left">
            <button className="menu-toggle" onClick={() => setSidebarOpen(true)}>
              <Menu size={22} />
            </button>
            <div>
              <h1>{activePage}</h1>
              <p>{pageDescription[activePage] || "Manage your business."}</p>
            </div>
          </div>

          <div className="topbar-right">
            <div className="search-box">
              <Search size={18} />
              <input placeholder="Search anything..." />
              <kbd>âŒ˜ K</kbd>
            </div>
            <button className="icon-button notification">
              <Bell size={20} /><span />
             </button>
            <div className="profile">
              <div className="profile-avatar">A</div>
              <div className="profile-info">
                <strong>Admin User</strong>

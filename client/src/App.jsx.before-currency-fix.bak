            >
              {loanProviderSaving
                ? "Saving..."
                : loanProviderEditId
                  ? "Update Loan Provider"
                  : "Save Loan Provider"}
            </button>
          </div>
        </form>
      </div>

      {/* PROVIDER LIST */}
      <div className="panel" style={{ padding: 22 }}>
        <div style={{ marginBottom: 16 }}>
          <h3 style={{ margin: 0, fontSize: 16, color: "#1e293b" }}>
            Provider List ({loanProviders.length})
          </h3>

      ? "Saving..."
      : accountEditingId
      ? "Update Account"
      : "Save Account"}
  </button>

  {accountEditingId && (
    <button
      type="button"
      className="secondary-button"
      disabled={accountSaving}
      onClick={() => {
        setAccountEditingId("");

        setAccountForm({
          accountName: "",
          accountType: "CASH",
          bankName: "",
          accountNumber: "",
          branchName: "",

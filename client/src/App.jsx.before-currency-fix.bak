      </div>

      {/* CATEGORY LIST */}
      <div
        style={{
          background: "#fff",
          border: "1px solid #e2e8f0",
          borderRadius: 10,
          padding: 22,
        }}
      >
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            flexWrap: "wrap",
            gap: 10,
            borderBottom: "1px solid #e2e8f0",
            paddingBottom: 14,
          }}
        >
          <div>
            <h3 style={{ margin: 0, fontSize: 16, fontWeight: 700 }}>
              Expense Category List
            </h3>

            <p style={{ margin: "5px 0 0", color: "#64748b", fontSize: 12 }}>
              All expense categories ({expenseCategories.length})
            </p>
          </div>
        </div>

        {expenseCategoryLoading ? (
          <div
            style={{
              padding: 35,
              textAlign: "center",
              color: "#64748b",
              fontSize: 13,
            }}
          >
            Loading categories...
          </div>
        ) : expenseCategories.length === 0 ? (
          <div
            style={{
              padding: 35,
              textAlign: "center",
              color: "#94a3b8",
              fontSize: 13,
            }}
          >
            No Expense Categories found. Add your first category.
          </div>
        ) : (
          <div style={{ overflowX: "auto", marginTop: 16 }}>
            <table
              style={{
                width: "100%",
                borderCollapse: "collapse",
                minWidth: 600,
              }}
            >
              <thead>
                <tr style={{ background: "#f1f5f9" }}>
                  {[
                    "#",
                    "Category Name",
                    "Description",
                    "Status",
                    "Actions",
                  ].map((heading) => (
                    <th
                      key={heading}
                      style={{
                        padding: "12px 14px",
                        textAlign: "left",
                        fontSize: 11,
                        fontWeight: 800,
                        color: "#334155",
                        borderBottom: "1px solid #e2e8f0",
                        whiteSpace: "nowrap",
                      }}
                    >
                      {heading}
                    </th>
                  ))}
                </tr>
              </thead>

              <tbody>
                {expenseCategories.map((category, index) => (
                  <tr
                    key={category._id}
                    style={{ background: index % 2 ? "#fafafa" : "#fff" }}
                  >
                    <td style={cellStyle}>{index + 1}</td>

                    <td
                      style={{
                        ...cellStyle,
                        fontWeight: 700,
                        color: "#1e293b",
                      }}
                    >
                      {category.name}
                    </td>

                    <td style={cellStyle}>
                      {category.description || "â€”"}
                    </td>

                    <td style={cellStyle}>
                      <span
                        style={{
                          display: "inline-block",
                          padding: "5px 10px",
                          borderRadius: 20,
                          fontSize: 10,
                          fontWeight: 800,
                          color:
                            category.isActive !== false
                              ? "#15803d"
                              : "#b91c1c",
                          background:
                            category.isActive !== false
                              ? "#dcfce7"
                              : "#fee2e2",
                        }}
                      >
                        {category.isActive !== false ? "Active" : "Inactive"}
                      </span>
                    </td>

                    <td style={cellStyle}>
                      <div
                        style={{
                          display: "flex",
                          gap: 7,
                          alignItems: "center",
                        }}
                      >
                        <button
                          type="button"
                          style={{
                            ...actionButtonStyle,
                            color: "#0f766e",
                          }}
                          onClick={() => editExpenseCategory(category)}
                        >
                          Edit
                        </button>

                        <button
                          type="button"
                          style={{
                            ...actionButtonStyle,
                            color:
                              category.isActive !== false
                                ? "#dc2626"
                                : "#15803d",
                          }}
                          onClick={() =>
                            toggleExpenseCategoryStatus(category)
                          }
                        >
                          {category.isActive !== false
                            ? "Deactivate"
                            : "Activate"}
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}



// ========================================
// EXPENSE EDIT & CORRECTION HISTORY FUNCTIONS
// ========================================

// Date à¦•à§‡ input type="date" à¦à¦° à¦‰à¦ªà¦¯à§‹à¦—à§€ à¦•à¦°à¦¾
const toExpenseDateInput = (value) => {
  if (!value) return "";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "";

  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");

  return `${year}-${month}-${day}`;
};

// Edit Modal à¦–à§‹à¦²à¦¾ à¦à¦¬à¦‚ à¦†à¦—à§‡à¦° à¦¤à¦¥à§à¦¯ à¦¬à¦¸à¦¾à¦¨à§‹
const openExpenseEditModal = (expense) => {
  setExpenseEditingItem(expense);

  setExpenseEditFormData({
    expenseDate: toExpenseDateInput(expense.expenseDate),
    categoryId: String(expense.categoryId?._id || expense.categoryId || ""),
    accountId: String(expense.accountId?._id || expense.accountId || ""),
    amount: String(expense.amount ?? ""),
    voucherNumber: expense.voucherNumber || "",
    reference: expense.reference || "",
    description: expense.description || "",
    reason: "",
  });

  setExpenseEditModalOpen(true);
};

// Edit Form à¦à¦° Input à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨
const handleExpenseEditChange = (field, value) => {
  setExpenseEditFormData((prev) => ({
    ...prev,
    [field]: value,
  }));
};

// Expense Update API
const saveExpenseEdit = async () => {
  if (!expenseEditingItem?._id) {
    toast.error("Expense à¦¨à¦¿à¦°à§à¦¬à¦¾à¦šà¦¨ à¦•à¦°à¦¾ à¦¹à§Ÿà¦¨à¦¿");
    return;
  }

  const form = expenseEditFormData;

  if (
    !form.expenseDate ||
    !form.categoryId ||
    !form.accountId ||
    !form.amount
  ) {
    toast.error("à¦ªà§à¦°à§Ÿà§‹à¦œà¦¨à§€à§Ÿ à¦¸à¦¬ à¦¤à¦¥à§à¦¯ à¦ªà§‚à¦°à¦£ à¦•à¦°à§à¦¨");
    return;
  }

  if (Number(form.amount) <= 0) {
    toast.error("à¦¸à¦ à¦¿à¦• Amount à¦²à¦¿à¦–à§à¦¨");
    return;
  }

  if (!form.reason.trim()) {
    toast.error("Correction Reason à¦²à¦¿à¦–à§à¦¨");
    return;
  }

  try {
    setExpenseEditLoading(true);

    const result = await apiRequest(
      `/expenses/${expenseEditingItem._id}`,
      {
        method: "PUT",
        body: JSON.stringify({
          expenseDate: form.expenseDate,
          categoryId: form.categoryId,
          accountId: form.accountId,
          amount: Number(form.amount),
          voucherNumber: form.voucherNumber,
          reference: form.reference,
          description: form.description,
          reason: form.reason,
        }),
      }
    );

    toast.success(result.message || "Expense updated successfully");

    setExpenseEditModalOpen(false);
    setExpenseEditingItem(null);

await loadExpenseHistory(
  expenseHistoryPagination.currentPage || 1,
  expenseHistoryFilters
);
  } catch (error) {
    console.error("EXPENSE EDIT ERROR:", error);
    toast.error(error.message || "Expense Update à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
  } finally {
    setExpenseEditLoading(false);
  }
};

// Correction History Load
const loadExpenseCorrectionHistory = async (expenseId) => {
  if (!expenseId) return;

  try {
    setExpenseCorrectionLoading(true);
    setExpenseCorrectionModalOpen(true);
    setExpenseCorrectionData(null);

    const result = await apiRequest(
      `/expenses/${expenseId}/correction-history`
    );

    setExpenseCorrectionData(result);
  } catch (error) {
    console.error("CORRECTION HISTORY ERROR:", error);
    toast.error(error.message || "Correction History à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿");
    setExpenseCorrectionModalOpen(false);
  } finally {
    setExpenseCorrectionLoading(false);
  }
};




function renderExpenseHistory() {
  const activeAccounts = accounts.filter(
    (account) => account.isActive !== false
  );

  const activeCategories = expenseCategories.filter(
    (category) => category.isActive !== false
  );

  const formatMoney = (amount) =>
    Number(amount || 0).toLocaleString("en-BD", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

  const labelStyle = {
    display: "block",
    fontSize: 12,
    fontWeight: 700,
    color: "#475569",
    marginBottom: 6,
  };

  const inputStyleExpense = {
    width: "100%",
    padding: "10px 12px",
    border: "1px solid #cbd5e1",
    borderRadius: 7,
    fontSize: 13,
    background: "#fff",
    boxSizing: "border-box",
    outline: "none",
  };

  const updateFilter = (key, value) => {
    setExpenseHistoryFilters((prev) => ({
      ...prev,
      [key]: value,
    }));
  };

  const clearFilters = () => {
    const emptyFilters = {
      fromDate: "",
      toDate: "",
      categoryId: "",
      accountId: "",
      search: "",
    };

    setExpenseHistoryFilters(emptyFilters);

    const params = new URLSearchParams();
    params.append("page", "1");
    params.append("limit", "50");

    loadExpenseHistoryWithParams(params);
  };

  const currentPage = expenseHistoryPagination.currentPage || 1;
  const totalPages = expenseHistoryPagination.totalPages || 1;

  return (
    <div style={{ display: "grid", gap: 16 }}>

      {/* PAGE HEADER */}
      <div
        style={{
          background: "#172554",
          color: "#fff",
          padding: "18px 20px",
          borderRadius: 10,
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          gap: 12,
          flexWrap: "wrap",
          boxShadow: "0 3px 10px rgba(15,23,42,.12)",
        }}
      >
        <div>
          <h2 style={{ margin: 0, fontSize: 21, fontWeight: 800 }}>
            Expense Management
          </h2>
          <p style={{ margin: "4px 0 0", fontSize: 12, color: "#cbd5e1" }}>
            Expense history, records and reports
          </p>
        </div>

        <button
          type="button"
          onClick={() => loadExpenseHistory(currentPage)}
          disabled={expenseHistoryLoading}
          style={{
            padding: "9px 14px",
            background: "#fff",
            color: "#172554",
            border: "none",
            borderRadius: 7,
            fontWeight: 700,
            cursor: "pointer",
          }}
        >
          {expenseHistoryLoading ? "Loading..." : "â†» Refresh"}
        </button>
      </div>

      {/* SUMMARY CARDS */}
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(190px, 1fr))",
          gap: 14,
        }}
      >
        <div
          style={{
            background: "#fff",
            border: "1px solid #e2e8f0",
            borderRadius: 10,
            padding: 17,
            borderLeft: "4px solid #ea580c",
          }}
        >
          <div style={{ fontSize: 12, color: "#64748b", fontWeight: 700 }}>
            TOTAL EXPENSE AMOUNT
          </div>
          <div
            style={{
              fontSize: 24,
              fontWeight: 800,
              color: "#ea580c",
              marginTop: 7,
            }}
          >
            à§³ {formatMoney(expenseHistorySummary.totalAmount)}
          </div>
        </div>

        <div
          style={{
            background: "#fff",
            border: "1px solid #e2e8f0",
            borderRadius: 10,
            padding: 17,
            borderLeft: "4px solid #0f766e",
          }}
        >
          <div style={{ fontSize: 12, color: "#64748b", fontWeight: 700 }}>
            TOTAL EXPENSE ENTRIES
          </div>
          <div
            style={{
              fontSize: 24,
              fontWeight: 800,
              color: "#0f766e",
              marginTop: 7,
            }}
          >
            {Number(expenseHistorySummary.totalEntries || 0).toLocaleString("en-BD")}
          </div>
        </div>
      </div>

      {/* SEARCH & FILTER CARD */}
      <div
        style={{
          background: "#fff",
          border: "1px solid #e2e8f0",
          borderRadius: 10,
          padding: 18,
        }}
      >
        <h3
          style={{
            margin: "0 0 16px",
            color: "#172554",
            fontSize: 16,
            fontWeight: 800,
          }}
        >
          Search & Filters
        </h3>

        <div
          style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(190px, 1fr))",
            gap: 14,
          }}
        >
          <div>
            <label style={labelStyle}>From Date</label>
            <input
              type="date"
              value={expenseHistoryFilters.fromDate}
              onChange={(e) => updateFilter("fromDate", e.target.value)}
              style={inputStyleExpense}
            />
          </div>

          <div>
            <label style={labelStyle}>To Date</label>
            <input
              type="date"
              value={expenseHistoryFilters.toDate}
              onChange={(e) => updateFilter("toDate", e.target.value)}
              style={inputStyleExpense}
            />
          </div>

          <div>
            <label style={labelStyle}>Expense Category</label>
            <select
              value={expenseHistoryFilters.categoryId}
              onChange={(e) => updateFilter("categoryId", e.target.value)}
              style={inputStyleExpense}
            >
              <option value="">All Categories</option>
              {activeCategories.map((category) => (
                <option key={category._id} value={category._id}>
                  {category.name}
                </option>
              ))}
            </select>

            {!expenseCategoryLoading && activeCategories.length === 0 && (
              <p style={{ color: "#dc2626", fontSize: 11, marginTop: 5 }}>
                No active expense categories found.
              </p>
            )}
          </div>

          <div>
            <label style={labelStyle}>Account</label>
            <select
              value={expenseHistoryFilters.accountId}
              onChange={(e) => updateFilter("accountId", e.target.value)}
              style={inputStyleExpense}
            >
              <option value="">All Accounts</option>
              {activeAccounts.map((account) => (
                <option key={account._id} value={account._id}>
                  {account.accountName} ({account.accountType})
                </option>
              ))}
            </select>
          </div>

          <div style={{ gridColumn: "1 / -1" }}>
            <label style={labelStyle}>Search Expense</label>
            <input
              type="text"
              value={expenseHistoryFilters.search}
              onChange={(e) => updateFilter("search", e.target.value)}
              onKeyDown={(e) => {
                if (e.key === "Enter") loadExpenseHistory(1);
              }}
              placeholder="Voucher Number, Reference, Description..."
              style={inputStyleExpense}
            />
          </div>
        </div>

        <div
          style={{
            display: "flex",
            justifyContent: "flex-end",
            gap: 9,
            marginTop: 18,
            flexWrap: "wrap",
          }}
        >
          <button
            type="button"
            onClick={clearFilters}
            disabled={expenseHistoryLoading}
            style={{
              padding: "10px 17px",
              background: "#fff",
              color: "#475569",
              border: "1px solid #cbd5e1",
              borderRadius: 7,
              fontWeight: 700,
              cursor: "pointer",
            }}
          >
            Clear Filters
          </button>

          <button
            type="button"
            onClick={() => loadExpenseHistory(1)}
            disabled={expenseHistoryLoading}
            style={{
              padding: "10px 20px",
              background: "#0f766e",
              color: "#fff",
              border: "none",
              borderRadius: 7,
              fontWeight: 800,
              cursor: "pointer",
            }}
          >
            {expenseHistoryLoading ? "Searching..." : "âŒ• Search Expenses"}
          </button>
        </div>
      </div>

      {/* EXPENSE HISTORY TABLE */}
      <div
        style={{
          background: "#fff",
          border: "1px solid #e2e8f0",
          borderRadius: 10,
          padding: 16,
        }}
      >
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            gap: 10,
            flexWrap: "wrap",
            marginBottom: 14,
          }}
        >
          <h3
            style={{
              margin: 0,
              color: "#172554",
              fontSize: 16,
              fontWeight: 800,
            }}
          >
            Expense History
          </h3>

          <span style={{ fontSize: 12, color: "#64748b" }}>
            Total Records: {Number(expenseHistoryPagination.totalExpenses || 0).toLocaleString("en-BD")}
          </span>
        </div>

        {expenseHistoryLoading ? (
          <div style={{ padding: 25, textAlign: "center", color: "#64748b" }}>
            Loading expense history...
          </div>
        ) : expenseHistory.length === 0 ? (
          <div
            style={{
              padding: 25,
              textAlign: "center",
              color: "#64748b",
              background: "#f8fafc",
              borderRadius: 7,
              fontSize: 13,
            }}
          >
            No expense records found.
          </div>
        ) : (
          <div style={{ overflowX: "auto" }}>
            <table
              style={{
                width: "100%",
                borderCollapse: "collapse",
                minWidth: 1120,
                fontSize: 12,
              }}
            >
              <thead>
                <tr style={{ background: "#f1f5f9" }}>
                  {[
                    "Date",
                    "Voucher No.",
                    "Category",
                    "Account",
                    "Amount",
                    "Reference",
                    "Description",
                    "Actions",
                  ].map((heading) => (
                    <th
                      key={heading}
                      style={{
                        padding: "12px 9px",
                        textAlign: "left",
                        color: "#475569",
                        borderBottom: "1px solid #e2e8f0",
                        whiteSpace: "nowrap",
                      }}
                    >
                      {heading}
                    </th>
                  ))}
                </tr>
              </thead>

              <tbody>
                {expenseHistory.map((expense) => (
                  <tr
                    key={expense._id}

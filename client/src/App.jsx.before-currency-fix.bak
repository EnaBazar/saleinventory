                ))}
              </tbody>
            </table>
          </div>

          <h4 style={{ marginTop: 22 }}>Invoice Summary</h4>

          <div
            style={{
              maxWidth: 350,
              marginLeft: "auto",
              display: "grid",
              gap: 9,
              fontSize: 14,
            }}
          >
            <div>Product Total: à§³ {Number(selectedSalesInvoice.productTotal || 0).toFixed(2)}</div>
            <div>Commission: à§³ {Number(selectedSalesInvoice.totalCommission || 0).toFixed(2)}</div>
            <div>Labour: à§³ {Number(selectedSalesInvoice.totalLabour || 0).toFixed(2)}</div>
            <div>Other Cost: à§³ {Number(selectedSalesInvoice.otherCost || 0).toFixed(2)}</div>
            <div>Discount: à§³ {Number(selectedSalesInvoice.discount || 0).toFixed(2)}</div>
            <hr />
            <div>Grand Total: à§³ {Number(selectedSalesInvoice.grandTotal || 0).toFixed(2)}</div>
            <div>Previous Due: à§³ {Number(selectedSalesInvoice.previousDue || 0).toFixed(2)}</div>
            <div>Total Payable: à§³ {Number(selectedSalesInvoice.totalPayable || 0).toFixed(2)}</div>
            <div>Paid: à§³ {Number(selectedSalesInvoice.paidAmount || 0).toFixed(2)}</div>
            <div>
              <strong>Due: à§³ {Number(selectedSalesInvoice.dueAmount || 0).toFixed(2)}</strong>
            </div>
          </div>


            >
              <option value="">All Categories</option>

              {activeCategories.map((category) => (
                <option key={category._id} value={category._id}>
                  {category.name}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label style={labelStyle}>Account</label>
            <select
              value={dateWiseExpenseFilters.accountId}
              onChange={(e) => updateFilter("accountId", e.target.value)}
              style={inputStyle}
            >
              <option value="">All Accounts</option>

              {activeAccounts.map((account) => (
                <option key={account._id} value={account._id}>
                  {account.accountName} ({account.accountType})
                </option>
              ))}
            </select>
          </div>
        </div>

        <div
          style={{
            display: "flex",
            justifyContent: "flex-end",
            gap: 9,
            marginTop: 18,
            flexWrap: "wrap",
          }}
        >
          <button
            type="button"
            onClick={clearFilters}
            disabled={dateWiseExpenseLoading}
            style={{
              padding: "10px 17px",
              background: "#fff",
              color: "#475569",
              border: "1px solid #cbd5e1",
              borderRadius: 7,
              fontWeight: 700,
              cursor: "pointer",
            }}
          >
            Clear Filters
          </button>

          <button
            type="button"
            onClick={() => {
              setExpandedExpenseDate("");
              loadDateWiseExpenseReport();
            }}
            disabled={dateWiseExpenseLoading}
            style={{
              padding: "10px 20px",
              background: "#0f766e",
              color: "#fff",
              border: "none",
              borderRadius: 7,
              fontWeight: 800,
              cursor: "pointer",
            }}
          >
            {dateWiseExpenseLoading ? "Loading..." : "âŒ• Generate Report"}
          </button>
        </div>
      </div>

      {/* DAILY REPORT TABLE */}
      <div
        style={{
          background: "#fff",
          border: "1px solid #e2e8f0",
          borderRadius: 10,
          padding: 16,
        }}
      >
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            gap: 10,
            flexWrap: "wrap",
            marginBottom: 14,
          }}
        >
          <h3 style={{ margin: 0, color: "#172554", fontSize: 16, fontWeight: 800 }}>
            Daily Expense Summary
          </h3>

          <span style={{ fontSize: 12, color: "#64748b" }}>
            {dateWiseExpenseReport.length} Days
          </span>
        </div>

        {dateWiseExpenseLoading ? (
          <div style={{ padding: 25, textAlign: "center", color: "#64748b" }}>
            Loading daily expense report...
          </div>
        ) : dateWiseExpenseReport.length === 0 ? (
          <div
            style={{
              padding: 25,
              textAlign: "center",
              color: "#64748b",
              background: "#f8fafc",
              borderRadius: 7,
              fontSize: 13,
            }}
          >
            No expense records found for the selected filters.
          </div>
        ) : (
          <div style={{ overflowX: "auto" }}>
            <table
              style={{
                width: "100%",
                borderCollapse: "collapse",
                minWidth: 650,
                fontSize: 12,
              }}
            >
              <thead>
                <tr style={{ background: "#f1f5f9" }}>
                  {["Date", "Total Entries", "Total Expense", "Details"].map((heading) => (
                    <th
                      key={heading}
                      style={{
                        padding: "12px 10px",
                        textAlign: "left",
                        color: "#475569",
                        borderBottom: "1px solid #e2e8f0",
                        whiteSpace: "nowrap",
                      }}
                    >
                      {heading}
                    </th>
                  ))}
                </tr>
              </thead>

              <tbody>
                {dateWiseExpenseReport.map((day, index) => {
                  const dateKey = getDateKey(day.date);
                  const isExpanded = expandedExpenseDate === dateKey;

                  return (
                    <React.Fragment key={dateKey || index}>
                      <tr style={{ borderBottom: "1px solid #e2e8f0" }}>
                        <td style={{ padding: 11, fontWeight: 700, whiteSpace: "nowrap" }}>
                          {getDateLabel(day.date)}
                        </td>

                        <td style={{ padding: 11 }}>
                          {Number(day.totalEntries || 0).toLocaleString("en-BD")}
                        </td>

                        <td
                          style={{
                            padding: 11,
                            color: "#dc2626",
                            fontWeight: 800,
                            whiteSpace: "nowrap",
                          }}
                        >
                          à§³ {formatMoney(day.totalAmount)}
                        </td>

                        <td style={{ padding: 11 }}>
                          <button
                            type="button"
                            onClick={() => toggleDateDetails(dateKey)}
                            style={{
                              padding: "7px 12px",
                              background: isExpanded ? "#172554" : "#0f766e",
                              color: "#fff",
                              border: "none",
                              borderRadius: 6,
                              fontSize: 11,
                              fontWeight: 700,
                              cursor: "pointer",
                            }}
                          >
                            {isExpanded ? "Hide Details â–²" : "View Details â–¼"}
                          </button>
                        </td>
                      </tr>

                      {isExpanded && (
                        <tr>
                          <td colSpan={4} style={{ padding: 12, background: "#f8fafc" }}>
                            <div style={{ fontWeight: 800, color: "#172554", marginBottom: 10 }}>
                              Expenses on {getDateLabel(day.date)}
                            </div>

                            {getExpensesForDate(day.date).length === 0 ? (
                              <div style={{ color: "#64748b", fontSize: 12 }}>
                                No detailed expenses found.
                              </div>
                            ) : (
                              <div style={{ overflowX: "auto" }}>
                                <table
                                  style={{
                                    width: "100%",
                                    minWidth: 650,
                                    borderCollapse: "collapse",
                                    background: "#fff",
                                    fontSize: 12,
                                  }}
                                >
                                  <thead>
                                    <tr style={{ background: "#e2e8f0" }}>
                                      {[
                                        "Voucher No.",
                                        "Category",
                                        "Account",
                                        "Amount",
                                        "Reference",
                                        "Description",
                                      ].map((heading) => (
                                        <th
                                          key={heading}
                                          style={{
                                            padding: 9,
                                            textAlign: "left",
                                            color: "#475569",
                                            whiteSpace: "nowrap",
                                          }}
                                        >
                                          {heading}
                                        </th>
                                      ))}
                                    </tr>
                                  </thead>

                                  <tbody>
                                    {getExpensesForDate(day.date).map((expense) => (
                                      <tr
                                        key={expense._id}
                                        style={{ borderTop: "1px solid #e2e8f0" }}
                                      >
                                        <td style={{ padding: 9 }}>
                                          {expense.voucherNumber || "-"}
                                        </td>

                                        <td style={{ padding: 9 }}>
                                          {expense.categoryName || "-"}
                                        </td>

                                        <td style={{ padding: 9 }}>
                                          {expense.accountName || "-"}
                                        </td>

                                        <td
                                          style={{
                                            padding: 9,
                                            color: "#dc2626",
                                            fontWeight: 800,
                                            whiteSpace: "nowrap",
                                          }}
                                        >
                                          à§³ {formatMoney(expense.amount)}
                                        </td>

                                        <td style={{ padding: 9 }}>
                                          {expense.reference || "-"}
                                        </td>

                                        <td style={{ padding: 9 }}>
                                          {expense.description || "-"}
                                        </td>
                                      </tr>
                                    ))}
                                  </tbody>
                                </table>
                              </div>
                            )}
                          </td>
                        </tr>
                      )}
                    </React.Fragment>
                  );
                })}
              </tbody>

              <tfoot>
                <tr style={{ background: "#f1f5f9", fontWeight: 800 }}>
                  <td style={{ padding: 12 }}>Grand Total</td>
                  <td style={{ padding: 12 }}>
                    {Number(dateWiseExpenseSummary.totalEntries || 0).toLocaleString("en-BD")}
                  </td>
                  <td style={{ padding: 12, color: "#dc2626", whiteSpace: "nowrap" }}>
                    à§³ {formatMoney(dateWiseExpenseSummary.totalAmount)}
                  </td>
                  <td style={{ padding: 12 }}></td>
                </tr>
              </tfoot>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}

const formatMoney = (amount) => {
  return `à§³ ${Number(amount || 0).toLocaleString("en-BD", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;
};




async function exportExpenseReportPDF(reportType) {
  try {
    const isDateWise = reportType === "date";

    const filters = isDateWise
      ? dateWiseExpenseFilters
      : categoryWiseExpenseFilters;

    const params = new URLSearchParams();

    Object.entries(filters).forEach(([key, value]) => {
      if (value !== "" && value !== null && value !== undefined) {
        params.append(key, value);
      }
    });

    const endpoint = isDateWise
      ? "/expenses/date-wise-report/pdf"
      : "/expenses/category-wise-report/pdf";

    const response = await fetch(
      `${API}${endpoint}?${params.toString()}`,
      {
        method: "GET",
        credentials: "include",
      }
    );

    if (!response.ok) {
      let message = "PDF à¦¤à§ˆà¦°à¦¿ à¦•à¦°à¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿";

      try {
        const errorData = await response.json();
        message = errorData.message || message;
      } catch {
        // Server returned a non-JSON error response.
      }

      throw new Error(message);
    }

    const blob = await response.blob();

    const downloadUrl = window.URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = downloadUrl;
    link.download = isDateWise
      ? "date-wise-expense-report.pdf"
      : "category-wise-expense-report.pdf";

    document.body.appendChild(link);
    link.click();
    link.remove();

    window.URL.revokeObjectURL(downloadUrl);

    toast.success("PDF à¦¸à¦«à¦²à¦­à¦¾à¦¬à§‡ à¦¤à§ˆà¦°à¦¿ à¦¹à§Ÿà§‡à¦›à§‡");
  } catch (error) {
    console.error("Expense PDF Download Error:", error);
    toast.error(error.message || "PDF Download failed");
  }
}




const labelStyle = "block text-sm font-medium text-slate-700 mb-1";



function renderCategoryWiseExpenseReport() {
  const activeAccounts = accounts.filter(
    (item) => item.isActive !== false
  );

  const reportInputStyle = {
    ...inputStyle,
    width: "100%",
    marginTop: 7,
    borderRadius: 9,
    minHeight: 43,
    boxSizing: "border-box",
  };

  const reportLabelStyle = {
    display: "block",
    fontSize: 13,
    fontWeight: 600,
    color: "#475569",
    marginTop: 10,
  };

  const sectionTitleStyle = {
    fontSize: 15,
    fontWeight: 700,
    color: "#334155",
    margin: "0 0 15px",
  };

  const cardStyle = {
    background: "#fff",
    border: "1px solid #e2e8f0",
    borderRadius: 12,
    padding: 18,
    minWidth: 0,
  };

  const primaryButtonStyle = {
    border: "none",
    background: "#0f766e",
    color: "#fff",
    padding: "11px 20px",
    borderRadius: 9,
    fontSize: 13,
    fontWeight: 600,
    cursor: categoryWiseExpenseLoading ? "not-allowed" : "pointer",
    opacity: categoryWiseExpenseLoading ? 0.6 : 1,
  };

  const secondaryButtonStyle = {
    border: "1px solid #cbd5e1",
    background: "#fff",
    color: "#475569",
    padding: "11px 20px",
    borderRadius: 9,
    fontSize: 13,
    fontWeight: 600,
    cursor: "pointer",
  };

  const tableHeaderStyle = {
    padding: "13px 14px",
    background: "#f1f5f9",
    color: "#475569",
    fontSize: 12,
    fontWeight: 700,
    textAlign: "left",
    whiteSpace: "nowrap",
    borderBottom: "1px solid #e2e8f0",
  };

  const tableCellStyle = {
    padding: "13px 14px",
    fontSize: 13,
    color: "#334155",
    borderBottom: "1px solid #f1f5f9",
  };

  const formatDate = (date) => {
    if (!date) return "-";
    return new Date(date).toLocaleDateString("en-GB");
  };

  const getCategoryExpenses = (categoryId) => {
    return categoryWiseExpenseDetails.filter(
      (expense) =>
        String(expense.categoryId || "") === String(categoryId || "")
    );
  };

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 20 }}>
      {/* HEADER */}
      <div>
        <h2
          style={{
            margin: 0,
            fontSize: 22,
            fontWeight: 700,
            color: "#1e293b",
          }}
        >
          Category-wise Expense Report
        </h2>

        <p
          style={{
            margin: "6px 0 0",
            fontSize: 13,
            color: "#64748b",
          }}
        >
          View expenses by category and check category-wise details.
        </p>
      </div>

      {/* SUMMARY CARDS */}
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(190px, 1fr))",
          gap: 14,
        }}
      >
        {/* TOTAL EXPENSE */}
        <div style={cardStyle}>
          <div style={{ fontSize: 13, color: "#64748b", fontWeight: 600 }}>
            Total Expense
          </div>

          <div
            style={{
              fontSize: 25,
              fontWeight: 800,
              color: "#dc2626",
              marginTop: 10,
            }}
          >
            {formatMoney(categoryWiseExpenseSummary.totalAmount || 0)}
          </div>

          <div style={{ fontSize: 12, color: "#94a3b8", marginTop: 5 }}>
            Total expense amount
          </div>
        </div>

        {/* TOTAL ENTRIES */}
        <div style={cardStyle}>
          <div style={{ fontSize: 13, color: "#64748b", fontWeight: 600 }}>
            Total Entries
          </div>

          <div
            style={{
              fontSize: 25,
              fontWeight: 800,
              color: "#1e293b",
              marginTop: 10,
            }}
          >
            {categoryWiseExpenseSummary.totalEntries || 0}
          </div>

          <div style={{ fontSize: 12, color: "#94a3b8", marginTop: 5 }}>
            Total expense transactions
          </div>
        </div>

        {/* TOTAL CATEGORIES */}
        <div style={cardStyle}>
          <div style={{ fontSize: 13, color: "#64748b", fontWeight: 600 }}>
            Total Categories
          </div>

          <div
            style={{
              fontSize: 25,
              fontWeight: 800,
              color: "#0f766e",
              marginTop: 10,
            }}
          >
            {categoryWiseExpenseSummary.totalCategories || 0}
          </div>

          <div style={{ fontSize: 12, color: "#94a3b8", marginTop: 5 }}>
            Categories with expenses
          </div>
        </div>
      </div>

      {/* REPORT FILTERS */}
      <div style={cardStyle}>
        <h3 style={sectionTitleStyle}>Report Filters</h3>

        <div
          style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(190px, 1fr))",
            gap: 15,
          }}
        >
          {/* FROM DATE */}
          <div>
            <label style={reportLabelStyle}>From Date</label>

            <input
              type="date"
              style={reportInputStyle}
              value={categoryWiseExpenseFilters.fromDate}
              onChange={(e) =>
                setCategoryWiseExpenseFilters((prev) => ({
                  ...prev,
                  fromDate: e.target.value,
                }))
              }
            />
          </div>

          {/* TO DATE */}
          <div>
            <label style={reportLabelStyle}>To Date</label>

            <input
              type="date"
              style={reportInputStyle}
              value={categoryWiseExpenseFilters.toDate}
              onChange={(e) =>
                setCategoryWiseExpenseFilters((prev) => ({
                  ...prev,
                  toDate: e.target.value,
                }))
              }
            />
          </div>

          {/* ACCOUNT */}
          <div>
            <label style={reportLabelStyle}>Account</label>

            <select
              style={reportInputStyle}
              value={categoryWiseExpenseFilters.accountId}
              onChange={(e) =>
                setCategoryWiseExpenseFilters((prev) => ({
                  ...prev,
                  accountId: e.target.value,
                }))
              }
            >
              <option value="">All Accounts</option>

              {activeAccounts.map((account) => (
                <option key={account._id} value={account._id}>
                  {account.accountName}
                </option>
              ))}
            </select>
          </div>
        </div>

        {/* FILTER BUTTONS */}
        <div
          style={{
            display: "flex",
            flexWrap: "wrap",
            gap: 10,
            marginTop: 20,
          }}
        >
          <button
            type="button"
            onClick={() => loadCategoryWiseExpenseReport()}
            disabled={categoryWiseExpenseLoading}
            style={primaryButtonStyle}
          >
            {categoryWiseExpenseLoading ? "Loading..." : "Generate Report"}
          </button>

          <button
            type="button"
            style={secondaryButtonStyle}
            onClick={() => {
              const resetFilters = {
                fromDate: "",
                toDate: "",
                accountId: "",
              };

              setCategoryWiseExpenseFilters(resetFilters);
              loadCategoryWiseExpenseReport(resetFilters);
            }}
          >
            Clear Filters
          </button>
        </div>
      </div>

      {/* CATEGORY REPORT TABLE */}
      <div
        style={{
          background: "#fff",
          border: "1px solid #e2e8f0",
          borderRadius: 12,
          overflow: "hidden",
        }}
      >
        <div
          style={{
            padding: "17px 18px",
            borderBottom: "1px solid #e2e8f0",
          }}
        >
          <h3 style={{ margin: 0, fontSize: 15, fontWeight: 700, color: "#334155" }}>
            Category-wise Summary
          </h3>
<button
  type="button"
  onClick={() => exportExpenseReportPDF("category")}
  disabled={
    categoryWiseExpenseLoading ||
    categoryWiseExpenseReport.length === 0
  }
  style={{
    marginTop: 12,
    padding: "9px 16px",
    background: "#dc2626",
    color: "#fff",
    border: "none",
    borderRadius: 7,
    fontSize: 12,
    fontWeight: 700,
    cursor: "pointer",
    opacity:
      categoryWiseExpenseLoading ||
      categoryWiseExpenseReport.length === 0
        ? 0.5
        : 1,
  }}
>
  <Download size={15} style={{ marginRight: 6, verticalAlign: "middle" }} />
  Export PDF
</button>
          <p style={{ margin: "5px 0 0", fontSize: 12, color: "#94a3b8" }}>
            Click View to see individual expense transactions.
          </p>
        </div>

        {categoryWiseExpenseLoading ? (
          <div style={{ padding: 35, textAlign: "center", color: "#64748b" }}>
            Loading expense report...
          </div>
        ) : categoryWiseExpenseReport.length === 0 ? (
          <div style={{ padding: 35, textAlign: "center", color: "#64748b" }}>
            No expense data found.
          </div>
        ) : (
          <div style={{ overflowX: "auto" }}>
            <table
              style={{
                width: "100%",
                minWidth: 650,
                borderCollapse: "collapse",
                fontSize: 13,
              }}
            >
              <thead>
                <tr>
                  <th style={tableHeaderStyle}>Category</th>
                  <th style={{ ...tableHeaderStyle, textAlign: "right" }}>
                    Total Entries
                  </th>
                  <th style={{ ...tableHeaderStyle, textAlign: "right" }}>
                    Total Amount
                  </th>
                  <th style={{ ...tableHeaderStyle, textAlign: "right" }}>
                    Share
                  </th>
                  <th style={{ ...tableHeaderStyle, textAlign: "center" }}>
                    Details
                  </th>
                </tr>
              </thead>

              <tbody>
                {categoryWiseExpenseReport.map((category) => {
                  const percentage =
                    categoryWiseExpenseSummary.totalAmount > 0
                      ? (category.totalAmount /
                          categoryWiseExpenseSummary.totalAmount) *
                        100
                      : 0;

                  const isExpanded =
                    expandedExpenseCategory === String(category.categoryId);

                  const details = getCategoryExpenses(category.categoryId);

                  return (
                    <React.Fragment key={category.categoryId}>
                      {/* CATEGORY ROW */}
                      <tr
                        style={{
                          background: isExpanded ? "#f8fafc" : "#fff",
                        }}
                      >
                        <td style={{ ...tableCellStyle, fontWeight: 600 }}>
                          {category.categoryName || "Uncategorized"}
                        </td>

                        <td style={{ ...tableCellStyle, textAlign: "right" }}>
                          {category.totalEntries || 0}
                        </td>

                        <td
                          style={{
                            ...tableCellStyle,
                            textAlign: "right",
                            fontWeight: 700,
                            color: "#dc2626",
                          }}
                        >
                          {formatMoney(category.totalAmount || 0)}
                        </td>

                        <td style={{ ...tableCellStyle, textAlign: "right" }}>
                          {percentage.toFixed(1)}%
                        </td>

                        <td style={{ ...tableCellStyle, textAlign: "center" }}>
                          <button
                            type="button"
                            onClick={() =>
                              setExpandedExpenseCategory(
                                isExpanded ? "" : String(category.categoryId)
                              )
                            }
                            style={{
                              border: "1px solid #cbd5e1",
                              background: isExpanded ? "#e2e8f0" : "#f8fafc",
                              color: "#334155",
                              padding: "6px 15px",
                              borderRadius: 7,
                              fontSize: 12,
                              fontWeight: 600,
                              cursor: "pointer",
                            }}
                          >
                            {isExpanded ? "Hide" : "View"}
                          </button>
                        </td>
                      </tr>

                      {/* EXPANDED DETAILS */}
                      {isExpanded && (
                        <tr>
                          <td
                            colSpan={5}
                            style={{
                              padding: 14,
                              background: "#f8fafc",
                              borderBottom: "1px solid #e2e8f0",
                            }}
                          >
                            {details.length === 0 ? (
                              <p
                                style={{
                                  textAlign: "center",
                                  color: "#64748b",
                                  padding: 20,
                                  margin: 0,
                                }}
                              >
                                No expense details found.
                              </p>
                            ) : (
                              <div
                                style={{
                                  overflowX: "auto",
                                  background: "#fff",
                                  border: "1px solid #e2e8f0",
                                  borderRadius: 9,
                                }}
                              >
                                <table
                                  style={{
                                    width: "100%",
                                    minWidth: 700,
                                    borderCollapse: "collapse",
                                    fontSize: 12,
                                  }}
                                >
                                  <thead>
                                    <tr>
                                      {[
                                        "Date",
                                        "Voucher",
                                        "Account",
                                        "Amount",
                                        "Reference",
                                        "Description",
                                      ].map((heading) => (
                                        <th
                                          key={heading}
                                          style={{
                                            ...tableHeaderStyle,
                                            padding: 11,
                                            background: "#f1f5f9",
                                          }}
                                        >
                                          {heading}
                                        </th>
                                      ))}
                                    </tr>
                                  </thead>

                                  <tbody>
                                    {details.map((expense) => (
                                      <tr key={expense._id}>
                                        <td style={tableCellStyle}>
                                          {formatDate(expense.expenseDate)}
                                        </td>

                                        <td style={tableCellStyle}>
                                          {expense.voucherNumber || "-"}
                                        </td>

                                        <td style={tableCellStyle}>
                                          {expense.accountName || "-"}
                                        </td>

                                        <td
                                          style={{
                                            ...tableCellStyle,
                                            textAlign: "right",
                                            fontWeight: 700,
                                            color: "#dc2626",
                                          }}
                                        >
                                          {formatMoney(expense.amount || 0)}
                                        </td>

                                        <td style={tableCellStyle}>
                                          {expense.reference || "-"}
                                        </td>

                                        <td style={tableCellStyle}>
                                          {expense.description || "-"}
                                        </td>
                                      </tr>
                                    ))}
                                  </tbody>
                                </table>
                              </div>
                            )}
                          </td>
                        </tr>
                      )}
                    </React.Fragment>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}




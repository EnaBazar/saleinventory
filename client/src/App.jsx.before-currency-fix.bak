            fontWeight: 800,
          }}
        >
          Report Filters
        </h3>

        <div
          style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
            gap: 14,
          }}
        >
          <div>
            <label style={labelStyle}>From Date</label>
            <input
              type="date"

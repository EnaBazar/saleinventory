  }
}
// ======================================
// SUPPLIER PAYMENT MODAL
// ======================================


function renderSupplierPaymentModal() {
  const paymentInputStyle = {
    ...inputStyle,
    width: "100%",
    marginTop: 7,
    borderRadius: 9,
    minHeight: 43,
    boxSizing: "border-box",
  };

  const sectionTitleStyle = {
    fontSize: 14,
    fontWeight: 700,
    color: "#334155",
    margin: "0 0 13px",
  };

  const labelStyle = {
    display: "block",
    fontSize: 13,
    fontWeight: 600,
    color: "#475569",
    marginTop: 14,
  };

  return (
    <div style={modalOverlayStyle}>
      <div
        style={{
          ...modalStyle,
          maxWidth: 560,
          width: "95%",
          borderRadius: 16,
          overflow: "hidden",
          padding: 0,
        }}
      >
        {/* HEADER */}
        <div
          style={{
            padding: "20px 22px",
            background: "#fff",
            borderBottom: "1px solid #e2e8f0",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
          }}
        >
          <div>
            <h2 style={{ margin: 0, fontSize: 21, color: "#1e293b" }}>
              Supplier Payment
            </h2>
            <p
              style={{
                margin: "5px 0 0",
                fontSize: 13,
                color: "#64748b",
              }}
            >
              Record supplier payment
            </p>
          </div>

          <button
            type="button"
            onClick={() => setShowPaymentForm(false)}
            style={{
              border: "none",
              background: "#f1f5f9",
              borderRadius: 9,
              width: 36,
              height: 36,
              cursor: "pointer",
              color: "#475569",
            }}
          >
            <X size={19} />
          </button>
        </div>

        <form onSubmit={submitSupplierPayment}>
          <div
            style={{
              padding: 22,
              maxHeight: "70vh",
              overflowY: "auto",
            }}
          >
            {/* SUPPLIER INFORMATION */}
            <div
              style={{
                padding: 17,
                background: "#f8fafc",
                border: "1px solid #e2e8f0",
                borderRadius: 12,
              }}
            >
              <h3 style={sectionTitleStyle}>
                Supplier Information
              </h3>

              <div style={{ marginBottom: 12 }}>
                <div style={{ fontSize: 12, color: "#64748b" }}>
                  Supplier Name
                </div>
                <strong style={{ color: "#1e293b", fontSize: 16 }}>
                  {paymentSupplier?.supplierName || "-"}
                </strong>
              </div>

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
                  gap: 12,
                }}
              >
                <div>
                  <div style={{ fontSize: 12, color: "#64748b" }}>
                    Address
                  </div>
                  <div style={{ fontSize: 14, color: "#334155" }}>
                    {paymentSupplier?.address || "-"}
                  </div>
                </div>

                <div>
                  <div style={{ fontSize: 12, color: "#64748b" }}>
                    Mobile Number
                  </div>
                  <div style={{ fontSize: 14, color: "#334155" }}>
                    {paymentSupplier?.mobile || "-"}
                  </div>
                </div>
              </div>
            </div>

            {/* PAYMENT DETAILS */}
            <div style={{ marginTop: 22 }}>
              <h3 style={sectionTitleStyle}>
                Payment Details
              </h3>

              <label style={labelStyle}>
                Payment Amount (à§³)
              </label>

              <input
                type="number"
                min="0.01"
                step="0.01"
                required
                placeholder="Enter payment amount"
                style={{
                  ...paymentInputStyle,
                  fontSize: 19,
                  fontWeight: 700,
                  color: "#15803d",
                  minHeight: 50,
                }}
                value={paymentForm.amount}
                onChange={(e) =>
                  setPaymentForm({
                    ...paymentForm,
                    amount: e.target.value,
                  })
                }
              />

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))",
                  gap: 14,
                }}
              >
                <div>
                  <label style={labelStyle}>
                    Payment Method
                  </label>

                  <select
                    style={paymentInputStyle}
                    value={paymentForm.paymentMethod}
                    onChange={(e) =>
                      setPaymentForm({
                        ...paymentForm,
                        paymentMethod: e.target.value,
                        accountId: "",
                      })
                    }
                  >
                    <option value="CASH">Cash</option>
                    <option value="BANK">Bank</option>
                    <option value="BKASH">bKash</option>
                  </select>
                </div>

                <div>
                  <label style={labelStyle}>
                    Transaction Date
                  </label>

                  <input
                    type="date"
                    required
                    style={paymentInputStyle}
                    value={paymentForm.transactionDate}
                    onChange={(e) =>
                      setPaymentForm({
                        ...paymentForm,
                        transactionDate: e.target.value,
                      })
                    }
                  />
                </div>
              </div>

              {/* PAYMENT ACCOUNT */}
              {["CASH", "BANK", "BKASH"].includes(paymentForm.paymentMethod) && (
                <div>
                  <label style={labelStyle}>
                    Payment Account
                  </label>

                  <select
                    style={paymentInputStyle}
                    value={paymentForm.accountId}
                    onChange={(e) =>
                      setPaymentForm({
                        ...paymentForm,
                        accountId: e.target.value,
                      })
                    }
                    disabled={accountLoading}
                    required
                  >
                    <option value="">
                      {accountLoading
                        ? "Loading Accounts..."
                        : "Select Account"}
                    </option>

                    {accounts
                      .filter(
                        (account) =>
                          account.isActive !== false &&
                          account.accountType === paymentForm.paymentMethod
                      )
                      .map((account) => (
                        <option key={account._id} value={account._id}>
                          {account.accountName}
                          {account.bankName ? ` - ${account.bankName}` : ""}
                          {account.accountNumber
                            ? ` (${account.accountNumber})`
                            : ""}
                        </option>
                      ))}
                  </select>
                </div>
              )}

              {/* TRANSACTION ID */}
              <label style={labelStyle}>
                Transaction ID
              </label>

              <div
                style={{
                  ...paymentInputStyle,
                  minHeight: 43,
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  padding: "0 12px",
                  background: "#f1f5f9",
                  color: "#64748b",
                  border: "1px solid #e2e8f0",
                }}
              >
                <span>Auto Generated on Save</span>
                <span style={{ fontSize: 11 }}>
                  AUTO
                </span>
              </div>

              {/* NOTES */}
              <label style={labelStyle}>
                Notes
              </label>

              <textarea
                style={{
                  ...paymentInputStyle,
                  minHeight: 85,
                  resize: "vertical",
                }}
                rows="3"
                placeholder="Write payment notes..."
                value={paymentForm.notes}
                onChange={(e) =>
                  setPaymentForm({
                    ...paymentForm,
                    notes: e.target.value,
                  })
                }
              />
            </div>
          </div>

          {/* FOOTER */}
          <div
            style={{
              padding: "16px 22px",
              borderTop: "1px solid #e2e8f0",
              display: "flex",
              justifyContent: "flex-end",
              gap: 10,
              background: "#fff",
              flexWrap: "wrap",
            }}
          >
            <button
              type="button"
              className="secondary-button"
              onClick={() => setShowPaymentForm(false)}
            >
              Cancel
            </button>

            <button
              type="submit"
              className="primary-button"
              disabled={paymentLoading || accountLoading}
            >
              {paymentLoading ? "Saving..." : "Save Payment"}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}



function renderCustomerPaymentModal() {

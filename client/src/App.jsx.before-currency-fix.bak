        {loanProviderLoading ? (
          <p style={{ color: "#7b8494" }}>
            Loading Loan Providers...
          </p>
        ) : loanProviders.length === 0 ? (
          <p style={{ color: "#7b8494", fontSize: 13 }}>
            à¦à¦–à¦¨à§‹ à¦•à§‹à¦¨à§‹ Loan Provider à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤
